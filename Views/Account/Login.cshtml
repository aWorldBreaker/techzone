@model TechZone.Controllers.LoginViewModel
@{
    ViewData["Title"] = "Đăng nhập";
    Layout = "_AuthLayout";
    var emailCoLoi = ViewData.ModelState["Email"]?.Errors.Count > 0;
    var matKhauCoLoi = ViewData.ModelState["MatKhau"]?.Errors.Count > 0;
}
<div class="auth-box">
    <h1>Đăng nhập</h1>
    <p class="auth-subtitle">Đăng nhập để mua sắm, theo dõi đơn hàng và tích điểm thành viên.</p>
    <form asp-action="Login" method="post" class="auth-form">
        <input type="hidden" asp-for="ReturnUrl" />
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="form-group">
            <label asp-for="Email">Email</label>
            <input asp-for="Email" class="form-control" type="email" aria-invalid="@(emailCoLoi ? "true" : null)" aria-describedby="@(emailCoLoi ? "Email-error" : null)" />
            <span asp-validation-for="Email" id="Email-error" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label asp-for="MatKhau">Mật khẩu</label>
            <div class="password-field">
                <input asp-for="MatKhau" class="form-control" type="password" aria-invalid="@(matKhauCoLoi ? "true" : null)" aria-describedby="@(matKhauCoLoi ? "MatKhau-error" : null)" />
                <button type="button" class="password-toggle" aria-label="Hiện mật khẩu" aria-pressed="false">Hiện</button>
            </div>
            <p class="capslock-warning" hidden>⚠ Caps Lock đang bật — mật khẩu có phân biệt chữ hoa/thường.</p>
            <span asp-validation-for="MatKhau" id="MatKhau-error" class="text-danger"></span>
        </div>
        <div class="form-group form-check">
            <input asp-for="GhiNho" />
            <label asp-for="GhiNho">Ghi nhớ đăng nhập</label>
        </div>
        <button type="submit" class="btn btn-primary btn-block auth-submit">Đăng nhập</button>
    </form>
    <p class="mt auth-switch">Chưa có tài khoản? <a asp-action="Register">Đăng ký</a></p>
    @inject Microsoft.Extensions.Configuration.IConfiguration CauHinh
    @if (CauHinh.GetValue<bool>("DemoAccounts:Enabled", false))
    {
        <p class="text-muted">Chế độ demo đang bật: tài khoản demo dùng cho môi trường demo — liên hệ quản trị viên để biết thông tin đăng nhập.</p>
    }
</div>
