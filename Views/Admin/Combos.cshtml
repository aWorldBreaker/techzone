@model List<TechZone.Models.Combo>
@{
    ViewData["Title"] = "Admin — Quản lý combo";
    var products = (List<TechZone.Models.Product>)ViewBag.Products;
}
<header class="market-heading">
    <div class="section-head">
        <h1>Quản lý combo</h1>
        <a class="btn hero-buy" href="#them-combo">Thêm combo</a>
    </div>
</header>

@if (Model.Count == 0)
{
    <p class="admin-empty">Chưa có combo nào.</p>
}
else
{
<div class="table-wrap admin-record-list"><table class="table" role="table" aria-label="Danh sách combo">
    <thead role="rowgroup"><tr role="row"><th scope="col">Tên combo</th><th scope="col">% giảm</th><th scope="col">Trạng thái</th><th scope="col">Đã bán / Giới hạn</th><th scope="col">Hiệu lực</th><th scope="col">Món trong combo</th><th scope="col">Thao tác</th></tr></thead>
    <tbody role="rowgroup">
        @foreach (var c in Model)
        {
            <tr role="row">
                <th scope="row" role="rowheader" class="admin-record-lead">
                    <a asp-action="SuaCombo" asp-route-id="@c.Id">@c.Ten</a>
                    @if (!string.IsNullOrWhiteSpace(c.MoTa))
                    {
                        <span class="admin-record-code text-muted">@c.MoTa</span>
                    }
                </th>
                <td role="cell" data-label="Mức giảm"><strong class="admin-money">@c.PhanTramGiam.ToString("0.##")%</strong></td>
                <td role="cell" data-label="Trạng thái"><partial name="_TrangThaiBadge" model="@(c.IsActive ? "Đang bật" : "Đã tắt")" /></td>
                <td role="cell" data-label="Đã bán / Giới hạn">@c.DaBan / @(c.GioiHanSL?.ToString() ?? "∞")</td>
                <td role="cell" data-label="Hiệu lực">@c.BatDau.ToString("dd/MM/yyyy") – @c.KetThuc.ToString("dd/MM/yyyy")</td>
                <td role="cell" class="admin-record-wide">
                    <details class="admin-combo-items">
                    <summary>Quản lý @c.Items.Count món</summary>
                    <ul class="admin-item-list" role="list">
                        @foreach (var item in c.Items)
                        {
                            <li class="product-thumb-cell">
                                <img class="product-thumb" src="@item.Product.AnhDaiDien" alt="" width="48" height="48" loading="lazy" />
                                <span>@item.Product.Ten × @item.SoLuong</span>
                                <form asp-action="XoaMonCombo" method="post" class="inline-form">
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <button type="submit" class="btn btn-danger btn-sm" aria-label="Xóa @item.Product.Ten khỏi combo" onclick="return confirm('Xóa món này khỏi combo?');">Xóa</button>
                                </form>
                            </li>
                        }
                    </ul>
                    <form asp-action="ThemMonCombo" method="post" class="admin-inline-fields admin-add-item">
                        <input type="hidden" name="comboId" value="@c.Id" />
                        <div class="form-group">
                        <label for="mon-@c.Id">Sản phẩm</label>
                        <select id="mon-@c.Id" name="productId" class="form-control" required>
                            <option value="">— Thêm món —</option>
                            @foreach (var p in products)
                            {
                                <option value="@p.Id">@p.Ten (@p.GiaBan.ToString("N0")đ)</option>
                            }
                        </select>
                        </div>
                        <div class="form-group">
                            <label for="soluong-@c.Id">Số lượng</label>
                            <input id="soluong-@c.Id" type="number" name="soLuong" class="form-control" min="1" value="1" />
                        </div>
                        <button type="submit" class="btn btn-primary btn-sm">Thêm món</button>
                    </form>
                    </details>
                </td>
                <td role="cell" class="admin-record-actions">
                    <div class="admin-row-actions admin-row-actions-three">
                    <a asp-action="SuaCombo" asp-route-id="@c.Id" class="btn btn-secondary btn-sm" aria-label="Sửa @c.Ten">Sửa</a>
                    <form asp-action="BatTatCombo" method="post" class="inline-form">
                        <input type="hidden" name="id" value="@c.Id" />
                        <button type="submit" class="btn btn-secondary btn-sm" aria-label="@(c.IsActive ? "Tắt" : "Bật") @c.Ten">@(c.IsActive ? "Tắt" : "Bật")</button>
                    </form>
                    <form asp-action="XoaCombo" method="post" class="inline-form">
                        <input type="hidden" name="id" value="@c.Id" />
                        <button type="submit" class="btn btn-danger btn-sm" aria-label="Xóa @c.Ten" data-confirm="Xóa combo @c.Ten? Đơn cũ vẫn giữ số tiền đã giảm." onclick="return confirm(this.dataset.confirm);">Xóa</button>
                    </form>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table></div>
}

<section class="card admin-editor mt" id="them-combo" aria-labelledby="them-combo-title" tabindex="-1">
<h2 id="them-combo-title">Thêm combo mới</h2>
<form asp-action="ThemCombo" method="post">
    <input type="hidden" name="__Invariant" value="phanTramGiam" />
    <div class="admin-form-grid">
        <fieldset class="admin-form-card">
            <legend>Thông tin</legend>
            <div class="form-group">
                <label for="Ten">Tên combo</label>
                <input id="Ten" name="ten" class="form-control" required maxlength="200" placeholder="vd: Combo Xiaomi 15 + Buds 5" />
            </div>
            <div class="form-group">
                <label for="MoTa">Mô tả</label>
                <input id="MoTa" name="moTa" class="form-control" maxlength="2000" />
            </div>
        </fieldset>
        <fieldset class="admin-form-card">
            <legend>Giảm giá &amp; thời gian</legend>
            <div class="form-group">
                <label for="PhanTramGiam">% giảm trên tổng giá cả bộ (0 &lt; % &lt; 100)</label>
                <input id="PhanTramGiam" name="phanTramGiam" class="form-control" type="number" min="0.01" max="99.99" step="0.01" value="10" required />
            </div>
            <div class="form-group">
                <label for="BatDau">Bắt đầu</label>
                <input id="BatDau" name="batDau" class="form-control" type="date" required />
            </div>
            <div class="form-group">
                <label for="KetThuc">Kết thúc</label>
                <input id="KetThuc" name="ketThuc" class="form-control" type="date" required />
            </div>
            <div class="form-group">
                <label for="GioiHanSL">Giới hạn số bộ (để trống = không giới hạn)</label>
                <input id="GioiHanSL" name="gioiHanSL" class="form-control" type="number" min="1" />
            </div>
        </fieldset>
        <fieldset class="admin-form-card">
            <legend>Món trong combo</legend>
            <div class="form-group">
                <label for="ProductId1">Món 1</label>
                <select id="ProductId1" name="productId1" class="form-control" required>
                    <option value="">— Chọn sản phẩm —</option>
                    @foreach (var p in products)
                    {
                        <option value="@p.Id">@p.Ten (@p.GiaBan.ToString("N0")đ)</option>
                    }
                </select>
                <label for="SoLuong1">Số lượng món 1 trong 1 bộ</label>
                <input id="SoLuong1" name="soLuong1" class="form-control" type="number" min="1" value="1" required />
            </div>
            <div class="form-group">
                <label for="ProductId2">Món 2 (không bắt buộc)</label>
                <select id="ProductId2" name="productId2" class="form-control">
                    <option value="">— Không có —</option>
                    @foreach (var p in products)
                    {
                        <option value="@p.Id">@p.Ten (@p.GiaBan.ToString("N0")đ)</option>
                    }
                </select>
                <label for="SoLuong2">Số lượng món 2 trong 1 bộ</label>
                <input id="SoLuong2" name="soLuong2" class="form-control" type="number" min="1" value="1" />
            </div>
        </fieldset>
    </div>
    <button type="submit" class="btn btn-primary">Thêm combo</button>
</form>
</section>
