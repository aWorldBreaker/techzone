@model TechZone.Models.DashboardViewModel
@{
    ViewData["Title"] = "Admin — Dashboard";
}
<h1>Dashboard</h1>

<div class="stat-grid">
    <div class="stat-card"><div class="value">@Model.DoanhThuThang.ToString("N0")đ</div><div class="label">Doanh thu tháng này</div></div>
    <div class="stat-card"><div class="value">@Model.DonMoi</div><div class="label">Đơn chờ xác nhận</div></div>
    <div class="stat-card"><div class="value">@Model.TongDon</div><div class="label">Tổng số đơn</div></div>
    <div class="stat-card"><div class="value">@Model.TongSanPham</div><div class="label">Sản phẩm</div></div>
    <div class="stat-card"><div class="value">@Model.DoanhThuTuan.ToString("N0")đ</div><div class="label">Doanh thu 7 ngày gần nhất</div></div>
    <div class="stat-card"><div class="value">@Model.KhachMoiThang</div><div class="label">Khách mới trong tháng</div></div>
</div>

<section>
    <h2>Doanh thu 30 ngày gần nhất</h2>
    @* M7-1: chua co don nao trong 30 ngay thi tat ca cot = 0 — JS dung ve
       (max &lt;= 0 thi return) de lai khung chart trong + 30 nhan ngay,
       trong nhu bieu do hong. Hien cau empty state thay cho khung chart. *@
    @if (!Model.DoanhThu30Ngay.Any(d => d.DoanhThu > 0))
    {
        <p class="text-muted">Chưa có doanh thu trong 30 ngày qua — biểu đồ sẽ hiện khi có đơn hàng mới.</p>
    }
    else
    {
    <div class="chart" role="img" aria-label="Biểu đồ cột doanh thu 30 ngày gần nhất">
        @foreach (var d in Model.DoanhThu30Ngay)
        {
            <div class="chart-col">
                <div class="chart-bar" data-value="@d.DoanhThu.ToString(System.Globalization.CultureInfo.InvariantCulture)" title="@d.Ngay: @d.DoanhThu.ToString("N0")đ"></div>
                <span class="chart-label">@d.Ngay</span>
            </div>
        }
    </div>
    }
</section>

<section class="mt">
    <h2>Đơn theo trạng thái</h2>
    @if (!Model.DonTheoTrangThai.Any())
    {
        <p class="text-muted">Chưa có đơn hàng nào.</p>
    }
    else
    {
        <div class="table-wrap"><table class="table">
            <thead><tr><th>Trạng thái</th><th>Số đơn</th></tr></thead>
            <tbody>
                @foreach (var kv in Model.DonTheoTrangThai.OrderByDescending(kv => kv.Value))
                {
                    <tr><td>@kv.Key</td><td>@kv.Value</td></tr>
                }
            </tbody>
        </table></div>
    }
</section>

<section>
    <h2>Doanh thu 7 ngày gần nhất</h2>
    <div class="table-wrap"><table class="table">
        <thead><tr><th>Ngày</th><th>Doanh thu</th></tr></thead>
        <tbody>
            @foreach (var d in Model.DoanhThu7Ngay)
            {
                <tr><td>@d.Ngay</td><td>@d.DoanhThu.ToString("N0")đ</td></tr>
            }
        </tbody>
    </table></div>
</section>

<section class="mt">
    <h2>Top bán chạy</h2>
    <div class="table-wrap"><table class="table">
        <thead><tr><th>Sản phẩm</th><th>Đã bán</th><th>Tồn kho</th><th>Giá bán</th></tr></thead>
        <tbody>
            @foreach (var p in Model.TopBanChay)
            {
                <tr>
                    <td><a asp-controller="Products" asp-action="Details" asp-route-id="@p.Id">@p.Ten</a></td>
                    <td>@p.LuotBan</td>
                    <td>@p.TonKho</td>
                    <td>@p.GiaBan.ToString("N0")đ</td>
                </tr>
            }
        </tbody>
    </table></div>
</section>

<section class="mt">
    <h2>Sắp hết hàng (tồn kho ≤ 10)</h2>
    @if (!Model.SapHetHang.Any())
    {
        <p class="text-muted">Không có sản phẩm nào sắp hết hàng.</p>
    }
    else
    {
        <div class="table-wrap"><table class="table">
            <thead><tr><th>Sản phẩm</th><th>Tồn kho</th></tr></thead>
            <tbody>
                @foreach (var p in Model.SapHetHang)
                {
                    <tr><td>@p.Ten</td><td><strong>@p.TonKho</strong></td></tr>
                }
            </tbody>
        </table></div>
    }
</section>

<section class="mt">
    <div class="section-head">
        <h2>Đơn gần đây</h2>
        <a asp-action="Orders">Xem tất cả đơn →</a>
    </div>
    <div class="table-wrap"><table class="table">
        <thead><tr><th>Mã đơn</th><th>Ngày đặt</th><th>Tổng tiền</th><th>Trạng thái</th></tr></thead>
        <tbody>
            @foreach (var o in Model.DonGanDay)
            {
                <tr>
                    <td><a asp-action="OrderDetails" asp-route-id="@o.Id">#@o.Id</a></td>
                    <td>@o.NgayDat.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>@o.ThanhToan.ToString("N0")đ</td>
                    <td>@o.TrangThai</td>
                </tr>
            }
        </tbody>
    </table></div>
    <p class="mt">
        <a class="btn btn-secondary" asp-action="Products">Quản lý sản phẩm</a>
        <a class="btn btn-secondary" asp-action="Vouchers">Quản lý voucher</a>
        <a class="btn btn-secondary" asp-action="Combos">Quản lý combo</a>
    </p>
    <p class="mt admin-links">
        <a asp-action="Kho">Quản lý kho</a>
        <a asp-action="KhachHang">Khách hàng</a>
        <a asp-action="Reviews">Duyệt đánh giá &amp; hỏi đáp</a>
        <a asp-action="Banners">Quản lý banner</a>
        <a asp-action="FlashSaleSlots">Khung Flash Sale</a>
        <a asp-action="ThongBao">Gửi thông báo</a>
    </p>
</section>

@section Scripts {
    <script src="~/js/dashboard-chart.js"></script>
}
