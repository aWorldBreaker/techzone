@model List<TechZone.Models.FlashSaleSlot>
@{
    ViewData["Title"] = "Admin — Khung Flash Sale";
    var products = ViewBag.Products as List<TechZone.Models.Product> ?? new List<TechZone.Models.Product>();
}
<h1>Khung Flash Sale</h1>

@if (!Model.Any())
{
    <p class="text-muted">Chưa có khung Flash Sale nào.</p>
}
else
{
    @foreach (var s in Model)
    {
        <section class="mt">
            <div class="section-head">
                <h2>Khung @s.Ten @(s.IsActive ? "" : "(đang tắt)")</h2>
                @* Dot 2 (B6): bat/tat slot — POST BatTatSlot moi, chi doi co
                   IsActive (gia sale van do PriceCalculationService tinh). *@
                <form asp-action="BatTatSlot" method="post" class="inline-form">
                    <input type="hidden" name="id" value="@s.Id" />
                    <button type="submit" class="btn btn-secondary btn-sm">@(s.IsActive ? "Tắt khung" : "Bật khung")</button>
                </form>
            </div>
            @if (!s.Items.Any())
            {
                <p class="text-muted">Chưa có sản phẩm nào trong khung này.</p>
            }
            else
            {
                <div class="table-wrap"><table class="table">
                    <thead><tr><th scope="col">Sản phẩm</th><th scope="col">Giá sale</th><th scope="col"><span class="visually-hidden">Thao tác</span></th></tr></thead>
                    <tbody>
                        @foreach (var item in s.Items)
                        {
                            <tr>
                                <td><span class="product-thumb-cell"><img class="product-thumb" src="@item.Product.AnhDaiDien" alt="" loading="lazy" />@item.Product.Ten</span></td>
                                <td>@item.GiaSale.ToString("N0")đ</td>
                                <td>
                                    <form asp-action="XoaSlotItem" method="post" class="inline-form">
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('Xóa @item.Product.Ten khỏi khung @s.Ten?');">Xóa</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table></div>
            }
            <form asp-action="ThemSlotItem" method="post" class="filter-bar">
                <input type="hidden" name="slotId" value="@s.Id" />
                <div class="form-group">
                    <label for="productId-@s.Id">Sản phẩm</label>
                    <select id="productId-@s.Id" name="productId" class="form-control" required>
                        @foreach (var p in products)
                        {
                            <option value="@p.Id">@p.Ten — @p.GiaBan.ToString("N0")đ</option>
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label for="giaSale-@s.Id">Giá sale (đ)</label>
                    <input id="giaSale-@s.Id" name="giaSale" class="form-control input-narrow" type="number" min="1" step="1000" required />
                </div>
                <button type="submit" class="btn btn-primary btn-sm">Thêm vào khung</button>
            </form>
        </section>
    }
}

<h2 class="mt">Thêm khung giờ mới</h2>
<form asp-action="ThemSlot" method="post">
    <div class="form-group">
        <label for="GioBatDau">Giờ bắt đầu (0–23)</label>
        <input id="GioBatDau" name="gioBatDau" class="form-control input-narrow" type="number" min="0" max="23" required />
    </div>
    <div class="form-group">
        <label for="GioKetThuc">Giờ kết thúc (1–24)</label>
        <input id="GioKetThuc" name="gioKetThuc" class="form-control input-narrow" type="number" min="1" max="24" required />
    </div>
    <button type="submit" class="btn btn-primary">Thêm khung giờ</button>
</form>

<p class="mt"><a asp-action="Dashboard">← Về Dashboard</a></p>
