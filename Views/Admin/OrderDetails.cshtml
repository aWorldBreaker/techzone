@model TechZone.Models.Order
@{
    ViewData["Title"] = $"Admin — Đơn #{Model.Id}";
    // Dropdown chi hien trang thai hien tai + cac dich hop le (Sprint 1):
    // server van ep buoc lai bang chuyen hop le trong OrderService.
    string[] cacTrangThai = new[] { Model.TrangThai }
        .Concat(TechZone.Models.OrderStatus.ChuyenTrangThaiHopLe[Model.TrangThai])
        .Distinct().ToArray();
}
<h1>Đơn hàng #@Model.Id</h1>
<p>Ngày đặt: @Model.NgayDat.ToString("dd/MM/yyyy HH:mm") • Trạng thái: <strong>@Model.TrangThai</strong></p>
<p>Khách: @Model.User?.HoTen (@Model.User?.Email)</p>
<p>Giao đến: @Model.DiaChiGiao</p>
<p>Phương thức: @Model.PhuongThucTT</p>

<table class="table">
    <thead><tr><th>Sản phẩm</th><th>Phiên bản</th><th>Đơn giá</th><th>Số lượng</th><th>Thành tiền</th></tr></thead>
    <tbody>
        @foreach (var d in Model.ChiTiet)
        {
            <tr>
                <td><a asp-controller="Products" asp-action="Details" asp-route-id="@d.ProductId">@d.Product.Ten</a></td>
                <td>@d.Variant?.TenBienThe</td>
                <td>@d.DonGia.ToString("N0")đ</td>
                <td>@d.SoLuong</td>
                <td>@d.ThanhTien.ToString("N0")đ</td>
            </tr>
        }
    </tbody>
</table>

<partial name="_BangTienDon" model="Model" />

<form asp-action="DoiTrangThai" method="post" class="mt">
    <input type="hidden" name="id" value="@Model.Id" />
    <div class="form-group">
        <label for="trangThaiMoi">Đổi trạng thái</label>
        <select id="trangThaiMoi" name="trangThaiMoi" class="form-control" asp-items="@(new SelectList(cacTrangThai, Model.TrangThai))"></select>
    </div>
    <button type="submit" class="btn btn-primary">Cập nhật trạng thái</button>
    <a asp-action="Orders" class="btn btn-secondary">Về danh sách đơn</a>
</form>
<p class="text-muted mt">Hủy đơn sẽ hoàn lại tồn kho cho các sản phẩm trong đơn.</p>

@* SEC-02 + SEC-04 — Mã tra cứu đơn khách vãng lai: chỉ hiện cho đơn vãng lai.
   DB chi luu SHA-256 hash nen KHONG hien duoc ma goc; chi hien trang thai
   (co ma / han dung / khoa). Cap lai PHAI nhap ten + SDT khach cung cap de
   doi chieu voi don (AdminController.CapLaiMaTraCuu); ma cu het hieu luc
   ngay khi cap ma moi. Gui ma moi cho khach qua kenh da xac minh — khong
   gui tu dong. *@
@if (Model.UserId is null)
{
    <hr />
    <h2>Mã tra cứu (khách vãng lai)</h2>
    <p>
        Mã tra cứu: <strong>@(string.IsNullOrEmpty(Model.GuestToken) ? "chưa có (đơn cũ — chỉ cấp khi khách yêu cầu)" : "đã đặt (lưu dạng hash SHA-256, không hiển thị được mã gốc)")</strong>
        @if (Model.GuestTokenHetHan.HasValue)
        {
            <span>• Hạn dùng: @Model.GuestTokenHetHan.Value.ToString("dd/MM/yyyy HH:mm")</span>
        }
        @if (Model.GuestTokenKhoaDen.HasValue && Model.GuestTokenKhoaDen.Value > DateTime.Now)
        {
            <span>• Đang khóa tra cứu đến @Model.GuestTokenKhoaDen.Value.ToString("dd/MM/yyyy HH:mm") (nhập sai 5 lần)</span>
        }
    </p>
    <form asp-action="CapLaiMaTraCuu" method="post" class="mt">
        <input type="hidden" name="id" value="@Model.Id" />
        <div class="form-group">
            <label for="hoTenDoiChieu">Họ tên người nhận (khách cung cấp — phải khớp đơn)</label>
            <input type="text" name="hoTenDoiChieu" id="hoTenDoiChieu" class="form-control" required />
        </div>
        <div class="form-group">
            <label for="soDienThoaiDoiChieu">Số điện thoại đặt hàng (khách cung cấp — phải khớp đơn)</label>
            <input type="text" name="soDienThoaiDoiChieu" id="soDienThoaiDoiChieu" class="form-control" required />
        </div>
        <button type="submit" class="btn btn-warning" onclick="return confirm('Cấp mã mới sẽ vô hiệu mã cũ ngay lập tức. Đã đối chiếu họ tên + SĐT với đơn chưa?');">Cấp lại mã tra cứu</button>
    </form>
    <p class="text-muted mt">Chỉ cấp lại khi khách mất mã và đã xác minh đúng người đặt (họ tên + SĐT trên đơn). Mã mới hiện 1 lần trong thông báo sau khi cấp — gửi cho khách qua kênh đã xác minh.</p>
}
