@model List<TechZone.Models.Order>
@{
    ViewData["Title"] = "Admin — Quản lý đơn hàng";
    var trangThai = (string?)ViewBag.TrangThai;
    string[] cacTrangThai = { TechZone.Models.OrderStatus.ChoXacNhan, TechZone.Models.OrderStatus.DangGiao, TechZone.Models.OrderStatus.DaGiao, TechZone.Models.OrderStatus.DaHuy };
}
<h1>Quản lý đơn hàng</h1>

<div class="chip-row">
    <a class="chip" asp-action="Orders">Tất cả</a>
    @foreach (var t in cacTrangThai)
    {
        <a class="chip" asp-action="Orders" asp-route-trangThai="@t">@t</a>
    }
</div>

@if (!Model.Any())
{
    <p>Không có đơn nào @(trangThai is not null ? $"ở trạng thái “{trangThai}”" : "") .</p>
}
else
{
    <table class="table">
        <thead>
            <tr><th>Mã đơn</th><th>Ngày đặt</th><th>Giao đến</th><th>Tổng tiền</th><th>Trạng thái</th><th></th></tr>
        </thead>
        <tbody>
            @foreach (var o in Model)
            {
                <tr>
                    <td>#@o.Id</td>
                    <td>@o.NgayDat.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>@o.DiaChiGiao</td>
                    <td>@o.ThanhToan.ToString("N0")đ</td>
                    <td>@o.TrangThai</td>
                    <td><a asp-action="OrderDetails" asp-route-id="@o.Id">Xem / đổi trạng thái</a></td>
                </tr>
            }
        </tbody>
    </table>
    @if ((int)ViewBag.TongTrang > 1)
    {
        <nav class="pagination" aria-label="Phân trang">
            @if ((int)ViewBag.TrangHienTai > 1)
            {
                <a asp-action="Orders" asp-route-trangThai="@trangThai" asp-route-page="@((int)ViewBag.TrangHienTai - 1)">← Trang trước</a>
            }
            <span class="page-current">Trang @ViewBag.TrangHienTai / @ViewBag.TongTrang</span>
            @if ((int)ViewBag.TrangHienTai < (int)ViewBag.TongTrang)
            {
                <a asp-action="Orders" asp-route-trangThai="@trangThai" asp-route-page="@((int)ViewBag.TrangHienTai + 1)">Trang sau →</a>
            }
        </nav>
    }
}
<p class="mt"><a asp-action="Dashboard">← Về Dashboard</a></p>
