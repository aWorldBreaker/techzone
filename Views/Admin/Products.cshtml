@model List<TechZone.Models.Product>
@{
    ViewData["Title"] = "Admin — Quản lý sản phẩm";
    var tuKhoa = (string?)ViewBag.TuKhoa;
    var sort = (string?)ViewBag.Sort;
}
<header class="market-heading">
    <div class="section-head">
        <h1>Quản lý sản phẩm</h1>
        <a class="btn hero-buy" asp-action="ProductForm">Thêm sản phẩm</a>
    </div>
</header>

@* Dot 2 (B1): tim kiem + sap xep server (GET, giu param qua phan trang). *@
<form method="get" asp-action="Products" class="admin-search" role="search">
    <input type="search" name="tuKhoa" class="form-control" placeholder="Tìm theo tên hoặc mã sản phẩm…" value="@tuKhoa" aria-label="Tìm sản phẩm theo tên hoặc mã" />
    <select name="sort" class="form-control" aria-label="Sắp xếp sản phẩm">
        <option value="">Sắp xếp: mới nhất</option>
        <option value="ten-asc" selected="@(sort == "ten-asc")">Tên A → Z</option>
        <option value="ten-desc" selected="@(sort == "ten-desc")">Tên Z → A</option>
        <option value="gia-asc" selected="@(sort == "gia-asc")">Giá tăng dần</option>
        <option value="gia-desc" selected="@(sort == "gia-desc")">Giá giảm dần</option>
        <option value="ton-asc" selected="@(sort == "ton-asc")">Tồn kho tăng dần</option>
        <option value="ton-desc" selected="@(sort == "ton-desc")">Tồn kho giảm dần</option>
        <option value="ban-chay" selected="@(sort == "ban-chay")">Bán chạy nhất</option>
    </select>
    <button type="submit" class="btn btn-primary">Tìm</button>
    @if (tuKhoa is not null || !string.IsNullOrEmpty(sort))
    {
        <a class="btn btn-secondary" asp-action="Products">Xóa lọc</a>
    }
</form>
<p class="admin-result-count text-muted" aria-live="polite">@ViewBag.TongMuc kết quả@(tuKhoa is not null ? $" cho “{tuKhoa}”" : "")</p>

@if (!Model.Any())
{
    <p class="admin-empty" role="status">Không tìm thấy sản phẩm nào@(tuKhoa is not null ? $" phù hợp với “{tuKhoa}”" : ""). <a asp-action="Products">Xem danh sách đầy đủ</a>.</p>
}
else
{
<div class="table-wrap admin-record-list" tabindex="0" role="region" aria-label="Danh sách sản phẩm">
<table class="table table--card-mobile" role="table" aria-label="Sản phẩm">
    <thead role="rowgroup">
        <tr role="row"><th scope="col" role="columnheader">Sản phẩm</th><th scope="col" role="columnheader">Danh mục</th><th scope="col" role="columnheader">Hãng</th><th scope="col" role="columnheader">Giá bán</th><th scope="col" role="columnheader">Tồn kho</th><th scope="col" role="columnheader">Đã bán</th><th scope="col" role="columnheader">Thao tác</th></tr>
    </thead>
    <tbody role="rowgroup">
        @foreach (var p in Model)
        {
            <tr role="row">
                <th scope="row" role="rowheader" class="admin-record-lead" data-label="Sản phẩm">
                    <span class="product-thumb-cell">
                        <img class="product-thumb" src="@p.AnhDaiDien" alt="" width="48" height="48" loading="lazy" />
                        <span><a asp-controller="Products" asp-action="Details" asp-route-id="@p.Id">@p.Ten</a><small class="admin-record-code text-muted">Mã #@p.Id</small></span>
                    </span>
                </th>
                <td role="cell" data-label="Danh mục">@p.Category.Ten</td>
                <td role="cell" data-label="Hãng">@p.Brand.Ten</td>
                <td role="cell" class="admin-record-wide" data-label="Giá bán">
                    <strong class="admin-money">@p.GiaBan.ToString("N0")đ</strong>
                    @if (p.GiaKhuyenMai.HasValue) { <s class="text-muted">@p.Gia.ToString("N0")đ</s> }
                </td>
                <td role="cell" data-label="Tồn kho"><span class="badge @(p.TonKho == 0 ? "badge-huy" : p.TonKho <= 10 ? "badge-cho" : "badge-xong")">@(p.TonKho == 0 ? "Hết hàng · 0" : $"Còn {p.TonKho}")</span></td>
                <td role="cell" data-label="Đã bán">@p.LuotBan</td>
                <td role="cell" class="admin-record-actions" data-label="Thao tác">
                    <div class="admin-row-actions">
                        <a asp-action="ProductForm" asp-route-id="@p.Id" class="btn btn-secondary btn-sm" aria-label="Sửa @p.Ten">Sửa</a>
                        <form asp-action="XoaSanPham" method="post">
                            <input type="hidden" name="id" value="@p.Id" />
                            <button type="submit" class="btn btn-danger btn-sm" aria-label="Xóa @p.Ten" data-confirm="Xóa @p.Ten?" onclick="return confirm(this.dataset.confirm);">Xóa</button>
                        </form>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table></div>
}

@if ((int)ViewBag.TongTrang > 1)
{
    <nav class="pagination" aria-label="Phân trang">
        @if ((int)ViewBag.TrangHienTai > 1)
        {
            <a asp-action="Products" asp-route-tuKhoa="@tuKhoa" asp-route-sort="@sort" asp-route-page="@((int)ViewBag.TrangHienTai - 1)">← Trang trước</a>
        }
        <span class="page-current">Trang @ViewBag.TrangHienTai / @ViewBag.TongTrang</span>
        @if ((int)ViewBag.TrangHienTai < (int)ViewBag.TongTrang)
        {
            <a asp-action="Products" asp-route-tuKhoa="@tuKhoa" asp-route-sort="@sort" asp-route-page="@((int)ViewBag.TrangHienTai + 1)">Trang sau →</a>
        }
    </nav>
}
<p class="mt"><a asp-action="Dashboard">← Về Dashboard</a></p>
