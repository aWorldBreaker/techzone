@model List<TechZone.Models.Product>
@{
    ViewData["Title"] = "Admin — Quản lý sản phẩm";
}
<div class="section-head">
    <h1>Quản lý sản phẩm (@ViewBag.TongMuc)</h1>
    <a class="btn btn-primary" asp-action="ProductForm">+ Thêm sản phẩm</a>
</div>

<div class="table-wrap"><table class="table">
    <thead>
        <tr><th>Sản phẩm</th><th>Danh mục</th><th>Hãng</th><th>Giá bán</th><th>Tồn kho</th><th>Đã bán</th><th><span class="visually-hidden">Thao tác</span></th></tr>
    </thead>
    <tbody>
        @foreach (var p in Model)
        {
            <tr>
                <td><a asp-controller="Products" asp-action="Details" asp-route-id="@p.Id">@p.Ten</a></td>
                <td>@p.Category.Ten</td>
                <td>@p.Brand.Ten</td>
                <td>
                    @p.GiaBan.ToString("N0")đ
                    @if (p.GiaKhuyenMai.HasValue) { <s class="text-muted">@p.Gia.ToString("N0")đ</s> }
                </td>
                <td>@p.TonKho</td>
                <td>@p.LuotBan</td>
                <td>
                    <a asp-action="ProductForm" asp-route-id="@p.Id">Sửa</a>
                    <form asp-action="XoaSanPham" method="post" class="inline-form">
                        <input type="hidden" name="id" value="@p.Id" />
                        <button type="submit" class="link-button" onclick="return confirm('Xóa @p.Ten?');">Xóa</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table></div>

@if ((int)ViewBag.TongTrang > 1)
{
    <nav class="pagination" aria-label="Phân trang">
        @if ((int)ViewBag.TrangHienTai > 1)
        {
            <a asp-action="Products" asp-route-page="@((int)ViewBag.TrangHienTai - 1)">← Trang trước</a>
        }
        <span class="page-current">Trang @ViewBag.TrangHienTai / @ViewBag.TongTrang</span>
        @if ((int)ViewBag.TrangHienTai < (int)ViewBag.TongTrang)
        {
            <a asp-action="Products" asp-route-page="@((int)ViewBag.TrangHienTai + 1)">Trang sau →</a>
        }
    </nav>
}
<p class="mt"><a asp-action="Dashboard">← Về Dashboard</a></p>
