@model List<Review>
@{
    ViewData["Title"] = "Admin — Duyệt đánh giá & hỏi đáp";
    var daDuyet = ViewBag.DaDuyetGanDay as IEnumerable<Review> ?? Enumerable.Empty<Review>();
    var cauHoi = ViewBag.CauHoiChuaTraLoi as IEnumerable<ProductQuestion> ?? Enumerable.Empty<ProductQuestion>();
    var moderation = ((IEnumerable<Review>)Model, daDuyet, cauHoi, false);
}

<header class="market-heading order-heading">
    <h1>Duyệt đánh giá &amp; hỏi đáp</h1>
    <p>@Model.Count đánh giá chờ duyệt · @cauHoi.Count() câu hỏi chưa trả lời</p>
</header>

<nav class="admin-row-actions" aria-label="Mục cần xử lý">
    <a href="#cho-duyet" class="btn btn-secondary btn-sm">Đánh giá chờ duyệt</a>
    <a href="#cau-hoi" class="btn btn-secondary btn-sm">Câu hỏi chưa trả lời</a>
    <a href="#da-duyet" class="btn btn-secondary btn-sm">Đã duyệt gần nhất</a>
</nav>

<partial name="_AdminModeration" model="moderation" />
