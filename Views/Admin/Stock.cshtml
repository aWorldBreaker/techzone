@model List<TechZone.Models.Product>
@{
    ViewData["Title"] = "Admin — Quản lý kho";
    var nhapGanDay = ViewBag.NhapGanDay as List<TechZone.Models.StockIn> ?? new List<TechZone.Models.StockIn>();
}
<h1>Quản lý kho</h1>

@* Dot 3 (B3): xuat CSV kho (ten / ton / da ban / gia ban). *@
<p><a class="btn btn-secondary" asp-action="XuatCsvKho">⬇ Xuất CSV kho (@Model.Count sản phẩm)</a></p>

<div class="table-wrap"><table class="table">
    <thead><tr><th scope="col">Sản phẩm</th><th scope="col">Tồn kho</th><th scope="col">Đã bán</th><th scope="col">Nhập thêm</th></tr></thead>
    <tbody>
        @foreach (var p in Model)
        {
            <tr>
                <td><span class="product-thumb-cell"><img class="product-thumb" src="@p.AnhDaiDien" alt="" loading="lazy" /><a asp-controller="Products" asp-action="Details" asp-route-id="@p.Id">@p.Ten</a></span></td>
                <td class="@(p.TonKho == 0 ? "low-stock" : p.TonKho <= 10 ? "low-stock-soft" : "")">@p.TonKho@if (p.TonKho == 0) { <span class="badge badge-huy">Hết hàng</span> }</td>
                <td>@p.LuotBan</td>
                <td>
                    <form asp-action="NhapKho" method="post" class="stock-form">
                        <input type="hidden" name="productId" value="@p.Id" />
                        <input type="number" name="soLuong" class="form-control input-narrow" min="1" value="10" required aria-label="Số lượng nhập cho @p.Ten" />
                        <input type="text" name="ghiChu" class="form-control" placeholder="Ghi chú (không bắt buộc)" maxlength="200" />
                        <button type="submit" class="btn btn-primary btn-sm">Nhập kho</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table></div>

<section class="mt">
    <h2>10 lần nhập kho gần nhất</h2>
    @if (!nhapGanDay.Any())
    {
        <p class="text-muted">Chưa có lần nhập kho nào.</p>
    }
    else
    {
        <div class="table-wrap"><table class="table">
            <thead><tr><th scope="col">Ngày nhập</th><th scope="col">Sản phẩm</th><th scope="col">Số lượng</th><th scope="col">Ghi chú</th></tr></thead>
            <tbody>
                @foreach (var s in nhapGanDay)
                {
                    <tr>
                        <td>@s.NgayNhap.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@s.Product.Ten</td>
                        <td>+@s.SoLuong</td>
                        <td>@s.GhiChu</td>
                    </tr>
                }
            </tbody>
        </table></div>
    }
</section>

<p class="mt"><a asp-action="Dashboard">← Về Dashboard</a></p>
