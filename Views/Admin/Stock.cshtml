@model List<TechZone.Models.Product>
@{
    ViewData["Title"] = "Admin — Quản lý kho";
    var nhapGanDay = ViewBag.NhapGanDay as List<TechZone.Models.StockIn> ?? new List<TechZone.Models.StockIn>();
}
<h1>Quản lý kho</h1>

<table class="table">
    <thead><tr><th>Sản phẩm</th><th>Tồn kho</th><th>Đã bán</th><th>Nhập thêm</th></tr></thead>
    <tbody>
        @foreach (var p in Model)
        {
            <tr>
                <td><a asp-controller="Products" asp-action="Details" asp-route-id="@p.Id">@p.Ten</a></td>
                <td class="@(p.TonKho < 5 ? "low-stock" : "")">@p.TonKho</td>
                <td>@p.LuotBan</td>
                <td>
                    <form asp-action="NhapKho" method="post" class="stock-form">
                        <input type="hidden" name="productId" value="@p.Id" />
                        <input type="number" name="soLuong" class="form-control input-narrow" min="1" value="10" required aria-label="Số lượng nhập cho @p.Ten" />
                        <input type="text" name="ghiChu" class="form-control" placeholder="Ghi chú (không bắt buộc)" maxlength="200" />
                        <button type="submit" class="btn btn-primary btn-sm">Nhập kho</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

<section class="mt">
    <h2>10 lần nhập kho gần nhất</h2>
    @if (!nhapGanDay.Any())
    {
        <p class="text-muted">Chưa có lần nhập kho nào.</p>
    }
    else
    {
        <table class="table">
            <thead><tr><th>Ngày nhập</th><th>Sản phẩm</th><th>Số lượng</th><th>Ghi chú</th></tr></thead>
            <tbody>
                @foreach (var s in nhapGanDay)
                {
                    <tr>
                        <td>@s.NgayNhap.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@s.Product.Ten</td>
                        <td>+@s.SoLuong</td>
                        <td>@s.GhiChu</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</section>

<p class="mt"><a asp-action="Dashboard">← Về Dashboard</a></p>
