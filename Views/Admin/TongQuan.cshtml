@model TechZone.Models.TongQuanViewModel
@{
    ViewData["Title"] = "Trang tổng hợp";
    var dash = Model.Dashboard;
    string[] cacTrangThai = { TechZone.Models.OrderStatus.ChoXacNhan, TechZone.Models.OrderStatus.DaXacNhan, TechZone.Models.OrderStatus.DangDongGoi, TechZone.Models.OrderStatus.DangGiao, TechZone.Models.OrderStatus.DaGiao, TechZone.Models.OrderStatus.DaHuy };
}
<h1>Trang tổng hợp</h1>
<p class="text-muted">Toàn bộ quản trị trong một trang — chọn tab để chuyển mục, không cần load trang mới. Mọi thao tác nhanh đều quay lại trang này.</p>

<nav class="tongquan-tabs" role="tablist" aria-label="Các mục quản trị">
    <button type="button" class="tongquan-tab is-active" role="tab" aria-selected="true" data-tongquan-tab="dashboard">📊 Dashboard</button>
    <button type="button" class="tongquan-tab" role="tab" aria-selected="false" data-tongquan-tab="products">📦 Sản phẩm (@Model.Products.Count)</button>
    <button type="button" class="tongquan-tab" role="tab" aria-selected="false" data-tongquan-tab="orders">🧾 Đơn hàng (@dash.TongDon)</button>
    <button type="button" class="tongquan-tab" role="tab" aria-selected="false" data-tongquan-tab="customers">👥 Khách hàng (@Model.KhachHang.Count)</button>
    <button type="button" class="tongquan-tab" role="tab" aria-selected="false" data-tongquan-tab="vouchers">🎟️ Voucher (@Model.Vouchers.Count)</button>
    <button type="button" class="tongquan-tab" role="tab" aria-selected="false" data-tongquan-tab="combos">🎁 Combo (@Model.Combos.Count)</button>
    <button type="button" class="tongquan-tab" role="tab" aria-selected="false" data-tongquan-tab="flashsale">⚡ Flash Sale (@Model.FlashSaleSlots.Count)</button>
    <button type="button" class="tongquan-tab" role="tab" aria-selected="false" data-tongquan-tab="banners">🖼️ Banner (@Model.Banners.Count)</button>
    <button type="button" class="tongquan-tab" role="tab" aria-selected="false" data-tongquan-tab="reviews">⭐ Đánh giá &amp; hỏi đáp (@Model.ReviewsChoDuyet.Count chờ duyệt)</button>
    <button type="button" class="tongquan-tab" role="tab" aria-selected="false" data-tongquan-tab="stock">🏬 Kho</button>
    <button type="button" class="tongquan-tab" role="tab" aria-selected="false" data-tongquan-tab="notifications">🔔 Thông báo</button>
    <button type="button" class="tongquan-tab" role="tab" aria-selected="false" data-tongquan-tab="returns">↩️ Đổi trả / Bảo hành (@(Model.DoiTraChoDuyet.Count + Model.BaoHanhChoDuyet.Count) chờ duyệt)</button>
</nav>

@* ---------- 1. Dashboard ---------- *@
<section class="tongquan-panel is-active" id="tq-dashboard" data-tongquan-panel="dashboard" role="tabpanel" aria-label="Dashboard">
    <div class="section-head">
        <h2>Dashboard</h2>
        <a asp-action="Dashboard">Xem đầy đủ →</a>
    </div>
    <div class="stat-grid">
        <div class="stat-card"><div class="value">@dash.DoanhThuThang.ToString("N0")đ</div><div class="label">Doanh thu tháng này</div></div>
        <div class="stat-card"><div class="value">@dash.DonMoi</div><div class="label">Đơn chờ xác nhận</div></div>
        <div class="stat-card"><div class="value">@dash.TongDon</div><div class="label">Tổng số đơn</div></div>
        <div class="stat-card"><div class="value">@dash.TongSanPham</div><div class="label">Sản phẩm</div></div>
        <div class="stat-card"><div class="value">@dash.DoanhThuTuan.ToString("N0")đ</div><div class="label">Doanh thu 7 ngày gần nhất</div></div>
        <div class="stat-card"><div class="value">@dash.KhachMoiThang</div><div class="label">Khách mới trong tháng</div></div>
    </div>

    <h3>Doanh thu 30 ngày gần nhất</h3>
    @if (!dash.DoanhThu30Ngay.Any(d => d.DoanhThu > 0))
    {
        <p class="text-muted">Chưa có doanh thu trong 30 ngày qua — biểu đồ sẽ hiện khi có đơn hàng mới.</p>
    }
    else
    {
        <div class="chart" role="img" tabindex="0" aria-label="Biểu đồ cột doanh thu 30 ngày gần nhất">
            @foreach (var d in dash.DoanhThu30Ngay)
            {
                <div class="chart-col">
                    <div class="chart-bar" data-value="@d.DoanhThu.ToString(System.Globalization.CultureInfo.InvariantCulture)" title="@d.Ngay: @d.DoanhThu.ToString("N0")đ"></div>
                    <span class="chart-label">@d.Ngay</span>
                </div>
            }
        </div>
    }

    <h3 class="mt">Đơn theo trạng thái</h3>
    @if (!Model.DonTheoTrangThai.Any())
    {
        <p class="text-muted">Chưa có đơn hàng nào.</p>
    }
    else
    {
        <div class="table-wrap"><table class="table">
            <thead><tr><th>Trạng thái</th><th>Số đơn</th></tr></thead>
            <tbody>
                @foreach (var kv in Model.DonTheoTrangThai.OrderByDescending(kv => kv.Value))
                {
                    <tr><td>@kv.Key</td><td>@kv.Value</td></tr>
                }
            </tbody>
        </table></div>
    }

    <h3 class="mt">Top bán chạy</h3>
    @if (!dash.TopBanChay.Any())
    {
        <p class="text-muted">Chưa có sản phẩm nào được bán.</p>
    }
    else
    {
        <div class="table-wrap"><table class="table">
            <thead><tr><th>Sản phẩm</th><th>Đã bán</th><th>Tồn kho</th><th>Giá bán</th></tr></thead>
            <tbody>
                @foreach (var p in dash.TopBanChay)
                {
                    <tr>
                        <td><a asp-controller="Products" asp-action="Details" asp-route-id="@p.Id">@p.Ten</a></td>
                        <td>@p.LuotBan</td>
                        <td>@p.TonKho</td>
                        <td>@p.GiaBan.ToString("N0")đ</td>
                    </tr>
                }
            </tbody>
        </table></div>
    }

    <h3 class="mt">Sắp hết hàng (tồn kho ≤ 10)</h3>
    @if (!dash.SapHetHang.Any())
    {
        <p class="text-muted">Không có sản phẩm nào sắp hết hàng.</p>
    }
    else
    {
        <div class="table-wrap"><table class="table">
            <thead><tr><th>Sản phẩm</th><th>Tồn kho</th></tr></thead>
            <tbody>
                @foreach (var p in dash.SapHetHang)
                {
                    <tr><td>@p.Ten</td><td><strong>@p.TonKho</strong></td></tr>
                }
            </tbody>
        </table></div>
    }

    <h3 class="mt">Đơn gần đây</h3>
    @if (!Model.DonGanDay.Any())
    {
        <p class="text-muted">Chưa có đơn hàng nào.</p>
    }
    else
    {
        <div class="table-wrap"><table class="table">
            <thead><tr><th>Mã đơn</th><th>Ngày đặt</th><th>Tổng tiền</th><th>Trạng thái</th></tr></thead>
            <tbody>
                @foreach (var o in Model.DonGanDay)
                {
                    <tr>
                        <td><a asp-action="OrderDetails" asp-route-id="@o.Id">#@o.Id</a></td>
                        <td>@o.NgayDat.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@o.ThanhToan.ToString("N0")đ</td>
                        <td>@o.TrangThai</td>
                    </tr>
                }
            </tbody>
        </table></div>
    }
</section>

@* ---------- 2. Sản phẩm ---------- *@
<section class="tongquan-panel" id="tq-products" data-tongquan-panel="products" role="tabpanel" aria-label="Sản phẩm" hidden>
    <div class="section-head">
        <h2>Sản phẩm (@Model.Products.Count)</h2>
        <a asp-action="Products">Xem đầy đủ →</a>
    </div>
    <div class="tongquan-filter-row">
        <input type="search" class="form-control tongquan-filter" data-tongquan-filter="tq-products" placeholder="Lọc theo tên sản phẩm…" aria-label="Lọc sản phẩm theo tên" />
        <select class="form-control tongquan-sort" data-tongquan-sort="tq-products" aria-label="Sắp xếp sản phẩm">
            <option value="">Sắp xếp: mặc định</option>
            <option value="ten-asc">Tên A → Z</option>
            <option value="ten-desc">Tên Z → A</option>
            <option value="gia-asc">Giá tăng dần</option>
            <option value="gia-desc">Giá giảm dần</option>
            <option value="ton-asc">Tồn kho tăng dần</option>
            <option value="ton-desc">Tồn kho giảm dần</option>
        </select>
    </div>
    @if (!Model.Products.Any())
    {
        <p class="text-muted">Chưa có sản phẩm nào.</p>
    }
    else
    {
        <div class="table-wrap"><table class="table">
            <thead><tr><th>Sản phẩm</th><th>Danh mục</th><th>Hãng</th><th>Giá bán</th><th>Tồn kho</th><th>Đã bán</th></tr></thead>
            <tbody>
                @foreach (var p in Model.Products)
                {
                    <tr data-sort-ten="@p.Ten" data-sort-gia="@p.GiaBan.ToString(System.Globalization.CultureInfo.InvariantCulture)" data-sort-ton="@p.TonKho">
                        <td><a asp-controller="Products" asp-action="Details" asp-route-id="@p.Id">@p.Ten</a></td>
                        <td>@p.Category.Ten</td>
                        <td>@p.Brand.Ten</td>
                        <td>
                            @p.GiaBan.ToString("N0")đ
                            @if (p.GiaKhuyenMai.HasValue) { <s class="text-muted">@p.Gia.ToString("N0")đ</s> }
                        </td>
                        <td>@p.TonKho</td>
                        <td>@p.LuotBan</td>
                    </tr>
                }
            </tbody>
        </table></div>
    }
    <p class="mt"><a class="btn btn-primary" asp-action="ProductForm">+ Thêm sản phẩm</a></p>
</section>

@* ---------- 3. Đơn hàng ---------- *@
<section class="tongquan-panel" id="tq-orders" data-tongquan-panel="orders" role="tabpanel" aria-label="Đơn hàng" hidden>
    <div class="section-head">
        <h2>Đơn hàng — 10 đơn gần nhất</h2>
        <a asp-action="Orders">Xem đầy đủ →</a>
    </div>
    <div class="tongquan-filter-row">
        <input type="search" class="form-control tongquan-filter" data-tongquan-filter="tq-orders" placeholder="Lọc theo mã đơn / trạng thái / địa chỉ…" aria-label="Lọc đơn hàng" />
        <select class="form-control tongquan-sort" data-tongquan-sort="tq-orders" aria-label="Sắp xếp đơn hàng">
            <option value="">Sắp xếp: mới nhất</option>
            <option value="ngay-desc">Ngày đặt mới nhất</option>
            <option value="ngay-asc">Ngày đặt cũ nhất</option>
            <option value="tong-desc">Tổng tiền giảm dần</option>
            <option value="tong-asc">Tổng tiền tăng dần</option>
        </select>
    </div>
    @if (!Model.DonGanDay.Any())
    {
        <p class="text-muted">Chưa có đơn hàng nào.</p>
    }
    else
    {
        <div class="table-wrap"><table class="table">
            <thead><tr><th>Mã đơn</th><th>Ngày đặt</th><th>Giao đến</th><th>Tổng tiền</th><th>Trạng thái</th><th>Đổi trạng thái</th></tr></thead>
            <tbody>
                @foreach (var o in Model.DonGanDay)
                {
                    <tr data-sort-ngay="@o.NgayDat.Ticks" data-sort-tong="@o.ThanhToan.ToString(System.Globalization.CultureInfo.InvariantCulture)">
                        <td><a asp-action="OrderDetails" asp-route-id="@o.Id">#@o.Id</a></td>
                        <td>@o.NgayDat.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@o.DiaChiGiao</td>
                        <td>@o.ThanhToan.ToString("N0")đ</td>
                        <td>@o.TrangThai</td>
                        <td>
                            <form asp-action="DoiTrangThai" method="post" class="admin-duyet">
                                <input type="hidden" name="id" value="@o.Id" />
                                <input type="hidden" name="tuTrang" value="TongQuan" />
                                <select name="trangThaiMoi" class="form-control" aria-label="Trạng thái mới cho đơn #@o.Id">
                                    @foreach (var t in cacTrangThai)
                                    {
                                        <option value="@t" selected="@(t == o.TrangThai)">@t</option>
                                    }
                                </select>
                                <button type="submit" class="btn btn-primary btn-sm">Đổi</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table></div>
    }
</section>

@* ---------- 4. Khách hàng ---------- *@
<section class="tongquan-panel" id="tq-customers" data-tongquan-panel="customers" role="tabpanel" aria-label="Khách hàng" hidden>
    <div class="section-head">
        <h2>Khách hàng (@Model.KhachHang.Count)</h2>
        <a asp-action="KhachHang">Xem đầy đủ →</a>
    </div>
    <input type="search" class="form-control tongquan-filter" data-tongquan-filter="tq-customers" placeholder="Lọc theo tên / email…" aria-label="Lọc khách hàng" />
    @if (!Model.KhachHang.Any())
    {
        <p class="text-muted">Chưa có khách hàng nào.</p>
    }
    else
    {
        <div class="table-wrap"><table class="table">
            <thead><tr><th>Họ tên</th><th>Email</th><th>Số điện thoại</th><th>Tổng chi tiêu</th><th>Hạng</th><th>Điểm</th></tr></thead>
            <tbody>
                @foreach (var k in Model.KhachHang)
                {
                    <tr>
                        <td>@k.User.HoTen</td>
                        <td>@k.User.Email</td>
                        <td>@k.User.SoDienThoai</td>
                        <td>@k.TongChiTieu.ToString("N0")đ</td>
                        <td><span class="badge">@k.Hang</span></td>
                        <td>@k.Diem điểm</td>
                    </tr>
                }
            </tbody>
        </table></div>
    }
</section>

@* ---------- 5. Voucher ---------- *@
<section class="tongquan-panel" id="tq-vouchers" data-tongquan-panel="vouchers" role="tabpanel" aria-label="Voucher" hidden>
    <div class="section-head">
        <h2>Voucher (@Model.Vouchers.Count)</h2>
        <a asp-action="Vouchers">Xem đầy đủ →</a>
    </div>
    <input type="search" class="form-control tongquan-filter" data-tongquan-filter="tq-vouchers" placeholder="Lọc theo mã voucher…" aria-label="Lọc voucher theo mã" />
    @if (!Model.Vouchers.Any())
    {
        <p class="text-muted">Chưa có voucher nào.</p>
    }
    else
    {
        <div class="table-wrap"><table class="table">
            <thead><tr><th>Mã</th><th>Loại</th><th>Giá trị</th><th>Đơn tối thiểu</th><th>Hết hạn</th><th>Đã dùng / Số lượng</th></tr></thead>
            <tbody>
                @foreach (var v in Model.Vouchers)
                {
                    <tr>
                        <td><strong>@v.Ma</strong></td>
                        <td>@v.LoaiGiam</td>
                        <td>@(v.LoaiGiam == "PhanTram" ? v.GiaTri.ToString("N0") + "%" : v.GiaTri.ToString("N0") + "đ")</td>
                        <td>@v.DieuKien.ToString("N0")đ</td>
                        <td>@v.NgayHetHan.ToString("dd/MM/yyyy")</td>
                        <td>@v.DaDung / @v.SoLuong</td>
                    </tr>
                }
            </tbody>
        </table></div>
    }
    <h3 class="mt">Thêm voucher mới</h3>
    <form asp-action="ThemVoucher" method="post">
        <input type="hidden" name="tuTrang" value="TongQuan" />
        <div class="form-group">
            <label for="tq-Ma">Mã (vd: TECHZONE500)</label>
            <input id="tq-Ma" name="Ma" class="form-control" required maxlength="50" />
        </div>
        <div class="form-group">
            <label for="tq-LoaiGiam">Loại giảm</label>
            <select id="tq-LoaiGiam" name="LoaiGiam" class="form-control">
                <option value="Tien">Giảm số tiền cố định</option>
                <option value="PhanTram">Giảm theo %</option>
            </select>
        </div>
        <div class="form-group">
            <label for="tq-GiaTri">Giá trị (đ hoặc %)</label>
            <input id="tq-GiaTri" name="GiaTri" class="form-control" type="number" min="0" step="1000" required />
        </div>
        <div class="form-group">
            <label for="tq-DieuKien">Đơn tối thiểu (đ)</label>
            <input id="tq-DieuKien" name="DieuKien" class="form-control" type="number" min="0" step="1000" value="0" />
        </div>
        <div class="form-group">
            <label for="tq-NgayHetHan">Ngày hết hạn</label>
            <input id="tq-NgayHetHan" name="NgayHetHan" class="form-control" type="date" required />
        </div>
        <div class="form-group">
            <label for="tq-SoLuong">Số lượng mã</label>
            <input id="tq-SoLuong" name="SoLuong" class="form-control" type="number" min="1" value="100" required />
        </div>
        <button type="submit" class="btn btn-primary">Thêm voucher</button>
    </form>
</section>

@* ---------- 6. Combo ---------- *@
<section class="tongquan-panel" id="tq-combos" data-tongquan-panel="combos" role="tabpanel" aria-label="Combo" hidden>
    <div class="section-head">
        <h2>Combo (@Model.Combos.Count)</h2>
        <a asp-action="Combos">Xem đầy đủ →</a>
    </div>
    <input type="search" class="form-control tongquan-filter" data-tongquan-filter="tq-combos" placeholder="Lọc theo tên combo…" aria-label="Lọc combo theo tên" />
    @if (!Model.Combos.Any())
    {
        <p class="text-muted">Chưa có combo nào.</p>
    }
    else
    {
        <div class="table-wrap"><table class="table">
            <thead><tr><th>Tên combo</th><th>% giảm</th><th>Hiệu lực</th><th>Đã bán / Giới hạn</th><th>Trạng thái</th><th>Món trong combo</th><th></th></tr></thead>
            <tbody>
                @foreach (var c in Model.Combos)
                {
                    <tr>
                        <td><strong>@c.Ten</strong>@if (!string.IsNullOrEmpty(c.MoTa)) { <br /><span class="text-muted">@c.MoTa</span> }</td>
                        <td>@c.PhanTramGiam.ToString("0.##")%</td>
                        <td>@c.BatDau.ToString("dd/MM/yyyy") – @c.KetThuc.ToString("dd/MM/yyyy")</td>
                        <td>@c.DaBan / @(c.GioiHanSL?.ToString() ?? "∞")</td>
                        <td>@(c.IsActive ? "Đang bật" : "Đã tắt")</td>
                        <td>
                            <ul>
                                @foreach (var item in c.Items)
                                {
                                    <li>@item.Product.Ten × @item.SoLuong</li>
                                }
                            </ul>
                        </td>
                        <td>
                            <a asp-action="SuaCombo" asp-route-id="@c.Id" class="btn btn-secondary">Sửa</a>
                            <form asp-action="BatTatCombo" method="post" class="inline-form">
                                <input type="hidden" name="id" value="@c.Id" />
                                <input type="hidden" name="tuTrang" value="TongQuan" />
                                <button type="submit" class="btn btn-secondary">@(c.IsActive ? "Tắt" : "Bật")</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table></div>
    }
</section>

@* ---------- 7. Flash Sale ---------- *@
<section class="tongquan-panel" id="tq-flashsale" data-tongquan-panel="flashsale" role="tabpanel" aria-label="Flash Sale" hidden>
    <div class="section-head">
        <h2>Flash Sale (@Model.FlashSaleSlots.Count khung)</h2>
        <a asp-action="FlashSaleSlots">Xem đầy đủ →</a>
    </div>
    @if (!Model.FlashSaleSlots.Any())
    {
        <p class="text-muted">Chưa có khung Flash Sale nào.</p>
    }
    else
    {
        @foreach (var s in Model.FlashSaleSlots)
        {
            <h3 class="mt">Khung @s.Ten @(s.IsActive ? "" : "(đang tắt)")</h3>
            @if (!s.Items.Any())
            {
                <p class="text-muted">Chưa có sản phẩm nào trong khung này.</p>
            }
            else
            {
                <div class="table-wrap"><table class="table">
                    <thead><tr><th>Sản phẩm</th><th>Giá sale</th></tr></thead>
                    <tbody>
                        @foreach (var item in s.Items)
                        {
                            <tr>
                                <td>@item.Product.Ten</td>
                                <td>@item.GiaSale.ToString("N0")đ</td>
                            </tr>
                        }
                    </tbody>
                </table></div>
            }
        }
    }
    <h3 class="mt">Thêm khung giờ mới</h3>
    <form asp-action="ThemSlot" method="post">
        <input type="hidden" name="tuTrang" value="TongQuan" />
        <div class="form-group">
            <label for="tq-GioBatDau">Giờ bắt đầu (0–23)</label>
            <input id="tq-GioBatDau" name="gioBatDau" class="form-control input-narrow" type="number" min="0" max="23" required />
        </div>
        <div class="form-group">
            <label for="tq-GioKetThuc">Giờ kết thúc (1–24)</label>
            <input id="tq-GioKetThuc" name="gioKetThuc" class="form-control input-narrow" type="number" min="1" max="24" required />
        </div>
        <button type="submit" class="btn btn-primary">Thêm khung giờ</button>
    </form>
</section>

@* ---------- 8. Banner ---------- *@
<section class="tongquan-panel" id="tq-banners" data-tongquan-panel="banners" role="tabpanel" aria-label="Banner" hidden>
    <div class="section-head">
        <h2>Banner (@Model.Banners.Count)</h2>
        <a asp-action="Banners">Xem đầy đủ →</a>
    </div>
    <input type="search" class="form-control tongquan-filter" data-tongquan-filter="tq-banners" placeholder="Lọc theo tiêu đề banner…" aria-label="Lọc banner theo tiêu đề" />
    @if (!Model.Banners.Any())
    {
        <p class="text-muted">Chưa có banner nào.</p>
    }
    else
    {
        <div class="table-wrap"><table class="table">
            <thead><tr><th>Ảnh</th><th>Tiêu đề</th><th>Link</th><th>Thứ tự</th><th>Trạng thái</th><th></th></tr></thead>
            <tbody>
                @foreach (var b in Model.Banners)
                {
                    <tr>
                        <td><img class="banner-thumb" src="@b.AnhUrl" alt="@b.TieuDe" /></td>
                        <td><strong>@b.TieuDe</strong></td>
                        <td>@(string.IsNullOrEmpty(b.LinkUrl) ? "—" : b.LinkUrl)</td>
                        <td>@b.ThuTu</td>
                        <td>@(b.IsActive ? "Đang bật" : "Đang tắt")</td>
                        <td>
                            <form asp-action="DoiTrangThaiBanner" method="post" class="inline-form">
                                <input type="hidden" name="id" value="@b.Id" />
                                <input type="hidden" name="tuTrang" value="TongQuan" />
                                <button type="submit" class="btn btn-secondary btn-sm">@(b.IsActive ? "Tắt" : "Bật")</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table></div>
    }
</section>

@* ---------- 9. Đánh giá & hỏi đáp ---------- *@
<section class="tongquan-panel" id="tq-reviews" data-tongquan-panel="reviews" role="tabpanel" aria-label="Đánh giá và hỏi đáp" hidden>
    <div class="section-head">
        <h2>Đánh giá &amp; hỏi đáp</h2>
        <a asp-action="Reviews">Xem đầy đủ →</a>
    </div>
    <h3>Đánh giá chờ duyệt (@Model.ReviewsChoDuyet.Count)</h3>
    @if (!Model.ReviewsChoDuyet.Any())
    {
        <p class="text-muted">Không có đánh giá nào chờ duyệt.</p>
    }
    else
    {
        @foreach (var r in Model.ReviewsChoDuyet)
        {
            <div class="review-item">
                <p><strong>@r.Sao ★</strong> — @r.Product.Ten</p>
                <p>@r.NoiDung</p>
                <p class="text-muted">@(r.User?.HoTen ?? r.User?.Email ?? "Khách") — @r.NgayDanhGia.ToString("dd/MM/yyyy HH:mm")</p>
                <form asp-action="DuyetDanhGia" method="post" class="inline-form">
                    <input type="hidden" name="id" value="@r.Id" />
                    <input type="hidden" name="tuTrang" value="TongQuan" />
                    <button type="submit" class="btn btn-primary btn-sm">Duyệt</button>
                </form>
                <form asp-action="AnDanhGia" method="post" class="inline-form">
                    <input type="hidden" name="id" value="@r.Id" />
                    <input type="hidden" name="tuTrang" value="TongQuan" />
                    <button type="submit" class="btn btn-secondary btn-sm">Ẩn</button>
                </form>
            </div>
        }
    }
    <h3 class="mt">Đánh giá đã duyệt gần nhất</h3>
    @if (!Model.ReviewsDaDuyetGanDay.Any())
    {
        <p class="text-muted">Chưa có đánh giá nào được duyệt.</p>
    }
    else
    {
        @foreach (var r in Model.ReviewsDaDuyetGanDay)
        {
            <div class="review-item">
                <p><strong>@r.Sao ★</strong> — @r.Product.Ten</p>
                <p>@r.NoiDung</p>
                <p class="text-muted">@(r.User?.HoTen ?? r.User?.Email ?? "Khách") — @r.NgayDanhGia.ToString("dd/MM/yyyy HH:mm")</p>
                <form asp-action="AnDanhGia" method="post" class="inline-form">
                    <input type="hidden" name="id" value="@r.Id" />
                    <input type="hidden" name="tuTrang" value="TongQuan" />
                    <button type="submit" class="btn btn-secondary btn-sm">Ẩn</button>
                </form>
            </div>
        }
    }
    <h3 class="mt">Câu hỏi chưa trả lời (@Model.CauHoiChuaTraLoi.Count)</h3>
    @if (!Model.CauHoiChuaTraLoi.Any())
    {
        <p class="text-muted">Không có câu hỏi nào chưa trả lời.</p>
    }
    else
    {
        @foreach (var q in Model.CauHoiChuaTraLoi)
        {
            <div class="review-item">
                <p><strong>@q.Product.Ten</strong> — @(q.User?.HoTen ?? q.User?.Email ?? "Khách") hỏi lúc @q.NgayHoi.ToString("dd/MM/yyyy HH:mm")</p>
                <p>@q.CauHoi</p>
                <form asp-action="TraLoiCauHoi" method="post">
                    <input type="hidden" name="questionId" value="@q.Id" />
                    <input type="hidden" name="tuTrang" value="TongQuan" />
                    <div class="form-group">
                        <label for="tq-traLoi-@q.Id">Trả lời</label>
                        <textarea id="tq-traLoi-@q.Id" name="traLoi" class="form-control" rows="3" maxlength="2000" required></textarea>
                    </div>
                    <button type="submit" class="btn btn-primary btn-sm">Trả lời</button>
                </form>
            </div>
        }
    }
</section>

@* ---------- 10. Kho ---------- *@
<section class="tongquan-panel" id="tq-stock" data-tongquan-panel="stock" role="tabpanel" aria-label="Kho" hidden>
    <div class="section-head">
        <h2>Kho (@Model.SanPhamKho.Count sản phẩm)</h2>
        <a asp-action="Kho">Xem đầy đủ →</a>
    </div>
    <input type="search" class="form-control tongquan-filter" data-tongquan-filter="tq-stock" placeholder="Lọc theo tên sản phẩm…" aria-label="Lọc kho theo tên sản phẩm" />
    @if (!Model.SanPhamKho.Any())
    {
        <p class="text-muted">Chưa có sản phẩm nào trong kho.</p>
    }
    else
    {
        <div class="table-wrap"><table class="table">
            <thead><tr><th>Sản phẩm</th><th>Tồn kho</th><th>Đã bán</th><th>Nhập thêm</th></tr></thead>
            <tbody>
                @foreach (var p in Model.SanPhamKho)
                {
                    <tr>
                        <td><a asp-controller="Products" asp-action="Details" asp-route-id="@p.Id">@p.Ten</a></td>
                        <td class="@(p.TonKho < 5 ? "low-stock" : "")">@p.TonKho</td>
                        <td>@p.LuotBan</td>
                        <td>
                            <form asp-action="NhapKho" method="post" class="stock-form">
                                <input type="hidden" name="productId" value="@p.Id" />
                                <input type="hidden" name="tuTrang" value="TongQuan" />
                                <input type="number" name="soLuong" class="form-control input-narrow" min="1" value="10" required aria-label="Số lượng nhập cho @p.Ten" />
                                <input type="text" name="ghiChu" class="form-control" placeholder="Ghi chú (không bắt buộc)" maxlength="200" />
                                <button type="submit" class="btn btn-primary btn-sm">Nhập kho</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table></div>
    }
    <h3 class="mt">10 lần nhập kho gần nhất</h3>
    @if (!Model.NhapKhoGanDay.Any())
    {
        <p class="text-muted">Chưa có lần nhập kho nào.</p>
    }
    else
    {
        <div class="table-wrap"><table class="table">
            <thead><tr><th>Ngày nhập</th><th>Sản phẩm</th><th>Số lượng</th><th>Ghi chú</th></tr></thead>
            <tbody>
                @foreach (var s in Model.NhapKhoGanDay)
                {
                    <tr>
                        <td>@s.NgayNhap.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@s.Product.Ten</td>
                        <td>+@s.SoLuong</td>
                        <td>@s.GhiChu</td>
                    </tr>
                }
            </tbody>
        </table></div>
    }
</section>

@* ---------- 11. Thông báo ---------- *@
<section class="tongquan-panel" id="tq-notifications" data-tongquan-panel="notifications" role="tabpanel" aria-label="Thông báo" hidden>
    <div class="section-head">
        <h2>Thông báo</h2>
        <a asp-action="ThongBao">Xem đầy đủ →</a>
    </div>
    <form asp-action="GuiThongBao" method="post">
        <input type="hidden" name="tuTrang" value="TongQuan" />
        <div class="form-group">
            <label for="tq-UserId">Gửi tới</label>
            <select id="tq-UserId" name="userId" class="form-control" required>
                <option value="all">Tất cả khách hàng</option>
                @foreach (var u in Model.NguoiNhanThongBao)
                {
                    <option value="@u.Id">@u.HoTen (@u.Email)</option>
                }
            </select>
        </div>
        <div class="form-group">
            <label for="tq-TieuDe">Tiêu đề</label>
            <input id="tq-TieuDe" name="tieuDe" class="form-control" required maxlength="200" />
        </div>
        <div class="form-group">
            <label for="tq-NoiDung">Nội dung</label>
            <textarea id="tq-NoiDung" name="noiDung" class="form-control" rows="4" maxlength="1000"></textarea>
        </div>
        <button type="submit" class="btn btn-primary">Gửi thông báo</button>
    </form>
    <h3 class="mt">20 thông báo gần nhất</h3>
    @if (!Model.ThongBaoGanDay.Any())
    {
        <p class="text-muted">Chưa có thông báo nào.</p>
    }
    else
    {
        <div class="table-wrap"><table class="table">
            <thead><tr><th>Ngày gửi</th><th>Người nhận</th><th>Tiêu đề</th><th>Nội dung</th><th>Đã đọc</th></tr></thead>
            <tbody>
                @foreach (var n in Model.ThongBaoGanDay)
                {
                    <tr>
                        <td>@n.NgayTao.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@(n.User?.HoTen ?? n.User?.Email ?? n.UserId)</td>
                        <td><strong>@n.TieuDe</strong></td>
                        <td>@n.NoiDung</td>
                        <td>@(n.DaDoc ? "Rồi" : "Chưa")</td>
                    </tr>
                }
            </tbody>
        </table></div>
    }
</section>

@* ---------- 12. Đổi trả / Bảo hành ---------- *@
<section class="tongquan-panel" id="tq-returns" data-tongquan-panel="returns" role="tabpanel" aria-label="Đổi trả và bảo hành" hidden>
    <div class="section-head">
        <h2>Đổi trả / Bảo hành</h2>
        <a asp-controller="Returns" asp-action="AdminIndex">Xem đầy đủ →</a>
    </div>
    <h3>Đổi trả chờ duyệt (@Model.DoiTraChoDuyet.Count)</h3>
    @if (!Model.DoiTraChoDuyet.Any())
    {
        <p class="text-muted">Không có yêu cầu đổi trả nào chờ duyệt.</p>
    }
    else
    {
        <div class="table-wrap"><table class="table">
            <thead><tr><th>Mã</th><th>Khách</th><th>Đơn</th><th>Sản phẩm</th><th>Lý do</th><th>Ngày tạo</th><th>Duyệt</th></tr></thead>
            <tbody>
                @foreach (var r in Model.DoiTraChoDuyet)
                {
                    <tr>
                        <td>#@r.Id</td>
                        <td>@r.User?.HoTen (@r.User?.UserName)</td>
                        <td><a asp-action="OrderDetails" asp-route-id="@r.OrderId">#@r.OrderId</a></td>
                        <td>@r.Product.Ten</td>
                        <td>@r.LyDo</td>
                        <td>@r.NgayTao.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>
                            <form asp-controller="Returns" asp-action="Duyet" method="post" class="admin-duyet">
                                <input type="hidden" name="id" value="@r.Id" />
                                <input type="hidden" name="loai" value="doitra" />
                                <input type="hidden" name="tuTrang" value="TongQuan" />
                                <select name="trangThaiMoi" class="form-control" aria-label="Trạng thái mới">
                                    <option>Đã duyệt</option>
                                    <option>Từ chối</option>
                                    <option>Hoàn thành</option>
                                </select>
                                <button type="submit" class="btn btn-primary btn-sm">Cập nhật</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table></div>
    }
    <h3 class="mt">Bảo hành chờ duyệt (@Model.BaoHanhChoDuyet.Count)</h3>
    @if (!Model.BaoHanhChoDuyet.Any())
    {
        <p class="text-muted">Không có yêu cầu bảo hành nào chờ duyệt.</p>
    }
    else
    {
        <div class="table-wrap"><table class="table">
            <thead><tr><th>Mã</th><th>Khách</th><th>Đơn</th><th>Sản phẩm</th><th>Mô tả lỗi</th><th>Ngày tạo</th><th>Duyệt</th></tr></thead>
            <tbody>
                @foreach (var w in Model.BaoHanhChoDuyet)
                {
                    <tr>
                        <td>#@w.Id</td>
                        <td>@w.User?.HoTen (@w.User?.UserName)</td>
                        <td><a asp-action="OrderDetails" asp-route-id="@w.OrderId">#@w.OrderId</a></td>
                        <td>@w.Product.Ten</td>
                        <td>@w.MoTaLoi</td>
                        <td>@w.NgayTao.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>
                            <form asp-controller="Returns" asp-action="Duyet" method="post" class="admin-duyet">
                                <input type="hidden" name="id" value="@w.Id" />
                                <input type="hidden" name="loai" value="baohanh" />
                                <input type="hidden" name="tuTrang" value="TongQuan" />
                                <select name="trangThaiMoi" class="form-control" aria-label="Trạng thái mới">
                                    <option>Đã duyệt</option>
                                    <option>Từ chối</option>
                                    <option>Hoàn thành</option>
                                </select>
                                <button type="submit" class="btn btn-primary btn-sm">Cập nhật</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table></div>
    }
</section>

@section Scripts {
    <script src="~/js/dashboard-chart.js"></script>
}
