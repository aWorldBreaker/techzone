@model TechZone.Models.TongQuanViewModel
@{
    ViewData["Title"] = "Trang tổng hợp";
    var mucQuanTri = new (string Key, string Label)[]
    {
        ("products", "Sản phẩm"),
        ("orders", "Đơn hàng"),
        ("customers", "Khách hàng"),
        ("vouchers", "Voucher"),
        ("combos", "Combo"),
        ("flashsale", "Flash Sale"),
        ("banners", "Banner"),
        ("reviews", "Đánh giá & hỏi đáp"),
        ("stock", "Kho"),
        ("notifications", "Thông báo"),
        ("returns", "Đổi trả / Bảo hành"),
    };
}
<header class="market-heading">
    <div class="section-head">
        <h1>Trang tổng hợp</h1>
        <a class="btn hero-buy" asp-action="Dashboard">Xem báo cáo Dashboard</a>
    </div>
</header>
<nav class="tongquan-tabs" aria-label="Các mục quản trị">
    @foreach (var muc in mucQuanTri)
    {
        var active = Model.Muc == muc.Key;
        <a asp-action="TongQuan" asp-route-muc="@muc.Key"
           class="tongquan-tab @(active ? "is-active" : null)" aria-current="@(active ? "page" : null)">@muc.Label</a>
    }
</nav>
<p class="text-muted">Xem nhanh tối đa 25 bản ghi mỗi danh sách. Mở trang quản lý để xem đầy đủ.</p>

@if (Model.Muc == "products")
{
    <section class="tongquan-panel" id="tq-products" aria-label="Sản phẩm">
        <div class="section-head">
            <h2>Sản phẩm (@Model.Products.Count)</h2>
            <a asp-action="Products">Xem đầy đủ →</a>
        </div>
        <div class="tongquan-filter-row">
            <input type="search" class="form-control tongquan-filter" data-tongquan-filter="tq-products" placeholder="Lọc theo tên sản phẩm…" aria-label="Lọc sản phẩm theo tên" />
            <select class="form-control tongquan-sort" data-tongquan-sort="tq-products" aria-label="Sắp xếp sản phẩm">
                <option value="">Sắp xếp: mặc định</option>
                <option value="ten-asc">Tên A → Z</option>
                <option value="ten-desc">Tên Z → A</option>
                <option value="gia-asc">Giá tăng dần</option>
                <option value="gia-desc">Giá giảm dần</option>
                <option value="ton-asc">Tồn kho tăng dần</option>
                <option value="ton-desc">Tồn kho giảm dần</option>
            </select>
        </div>
        @if (!Model.Products.Any())
        {
            <p class="text-muted">Chưa có sản phẩm nào.</p>
        }
        else
        {
            @* Dot 3 (C5): bang chuyen dang card o <=480px — giong Products.cshtml. *@
            <div class="table-wrap"><table class="table table--card-mobile">
                <thead><tr><th scope="col">Sản phẩm</th><th scope="col">Danh mục</th><th scope="col">Hãng</th><th scope="col">Giá bán</th><th scope="col">Tồn kho</th><th scope="col">Đã bán</th></tr></thead>
                <tbody>
                    @foreach (var p in Model.Products)
                    {
                        <tr data-sort-ten="@p.Ten" data-sort-gia="@p.GiaBan.ToString(System.Globalization.CultureInfo.InvariantCulture)" data-sort-ton="@p.TonKho">
                            <td data-label="Sản phẩm"><span class="product-thumb-cell"><img class="product-thumb" src="@p.AnhDaiDien" alt="" loading="lazy" /><a asp-controller="Products" asp-action="Details" asp-route-id="@p.Id">@p.Ten</a></span></td>
                            <td data-label="Danh mục">@p.Category.Ten</td>
                            <td data-label="Hãng">@p.Brand.Ten</td>
                            <td data-label="Giá bán">
                                @p.GiaBan.ToString("N0")đ
                                @if (p.GiaKhuyenMai.HasValue) { <s class="text-muted">@p.Gia.ToString("N0")đ</s> }
                            </td>
                            <td data-label="Tồn kho">@p.TonKho</td>
                            <td data-label="Đã bán">@p.LuotBan</td>
                        </tr>
                    }
                </tbody>
            </table></div>
        }
        <p class="mt"><a class="btn btn-primary" asp-action="ProductForm">+ Thêm sản phẩm</a></p>
    </section>
}


@if (Model.Muc == "orders")
{
    <section class="tongquan-panel" id="tq-orders" aria-label="Đơn hàng">
        <div class="section-head">
            <h2>Đơn hàng — 10 đơn gần nhất</h2>
            <a asp-action="Orders">Xem đầy đủ →</a>
        </div>
        <div class="tongquan-filter-row">
            <input type="search" class="form-control tongquan-filter" data-tongquan-filter="tq-orders" placeholder="Lọc theo mã đơn / trạng thái / địa chỉ…" aria-label="Lọc đơn hàng" />
            <select class="form-control tongquan-sort" data-tongquan-sort="tq-orders" aria-label="Sắp xếp đơn hàng">
                <option value="">Sắp xếp: mới nhất</option>
                <option value="ngay-desc">Ngày đặt mới nhất</option>
                <option value="ngay-asc">Ngày đặt cũ nhất</option>
                <option value="tong-desc">Tổng tiền giảm dần</option>
                <option value="tong-asc">Tổng tiền tăng dần</option>
            </select>
        </div>
        @* Dot 3 (B3): xuat CSV don — giong trang Orders cu. *@
        <p><a class="btn btn-secondary btn-sm" asp-action="XuatCsvDonHang">⬇ Xuất CSV đơn</a></p>
        @if (!Model.DonGanDay.Any())
        {
            <p class="text-muted">Chưa có đơn hàng nào.</p>
        }
        else
        {
            @* Dot 3 (C5): bang chuyen dang card o <=480px — giong Orders.cshtml. *@
            <div class="table-wrap"><table class="table table--card-mobile">
                <thead><tr><th scope="col">Mã đơn</th><th scope="col">Ngày đặt</th><th scope="col">Giao đến</th><th scope="col">Tổng tiền</th><th scope="col">Trạng thái</th><th scope="col">Đổi trạng thái</th></tr></thead>
                <tbody>
                    @foreach (var o in Model.DonGanDay)
                    {
                        <tr data-sort-ngay="@o.NgayDat.Ticks" data-sort-tong="@o.ThanhToan.ToString(System.Globalization.CultureInfo.InvariantCulture)">
                            <td data-label="Mã đơn"><a asp-action="OrderDetails" asp-route-id="@o.Id">#@o.Id</a>
                                @* Dot 3 (B4): xem nhanh mo drawer (read-only). *@
                                <button type="button" class="btn btn-secondary btn-sm" data-order-drawer="@o.Id" data-order-url="@Url.Action("OrderDetails", new { id = o.Id })">Xem nhanh</button></td>
                            <td data-label="Ngày đặt">@o.NgayDat.ToString("dd/MM/yyyy HH:mm")</td>
                            <td data-label="Giao đến">@o.DiaChiGiao</td>
                            <td data-label="Tổng tiền">@o.ThanhToan.ToString("N0")đ</td>
                            <td data-label="Trạng thái"><partial name="_TrangThaiBadge" model="o.TrangThai" /></td>
                            <td data-label="Đổi trạng thái">
                                @if (TechZone.Models.OrderStatus.ChuyenTrangThaiHopLe.TryGetValue(o.TrangThai, out var dichHopLe) && dichHopLe.Length > 0)
                                {
                                    <form asp-action="DoiTrangThai" method="post" class="admin-duyet">
                                        <input type="hidden" name="id" value="@o.Id" />
                                        <input type="hidden" name="tuTrang" value="TongQuan" />
                                        <input type="hidden" name="muc" value="@Model.Muc" />
                                        <select name="trangThaiMoi" class="form-control" aria-label="Trạng thái mới cho đơn #@o.Id">
                                            @foreach (var t in new[] { o.TrangThai }.Concat(dichHopLe))
                                            {
                                                <option value="@t" selected="@(t == o.TrangThai)">@t</option>
                                            }
                                        </select>
                                        <button type="submit" class="btn btn-primary btn-sm">Đổi</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table></div>
        }
    </section>
}


@if (Model.Muc == "customers")
{
    <section class="tongquan-panel" id="tq-customers" aria-label="Khách hàng">
        <div class="section-head">
            <h2>Khách hàng (@Model.KhachHang.Count)</h2>
            <a asp-action="KhachHang">Xem đầy đủ →</a>
        </div>
        <input type="search" class="form-control tongquan-filter" data-tongquan-filter="tq-customers" placeholder="Lọc theo tên / email…" aria-label="Lọc khách hàng" />
        @if (!Model.KhachHang.Any())
        {
            <p class="text-muted">Chưa có khách hàng nào.</p>
        }
        else
        {
            <div class="table-wrap admin-record-list"><table class="table" role="table" aria-label="Danh sách khách hàng">
                <thead role="rowgroup"><tr role="row"><th scope="col">Họ tên</th><th scope="col">Email</th><th scope="col">Số điện thoại</th><th scope="col">Hạng</th><th scope="col">Tổng chi tiêu</th><th scope="col">Điểm</th></tr></thead>
                <tbody role="rowgroup">
                    @foreach (var k in Model.KhachHang)
                    {
                        <tr role="row">
                            <th scope="row" role="rowheader" class="admin-record-lead">@k.User.HoTen</th>
                            <td role="cell" class="admin-record-wide" data-label="Email">@k.User.Email</td>
                            <td role="cell" data-label="Số điện thoại">@(k.User.SoDienThoai ?? "—")</td>
                            <td role="cell" data-label="Hạng"><partial name="_TrangThaiBadge" model="k.Hang" /></td>
                            <td role="cell" data-label="Tổng chi tiêu"><strong class="admin-money">@k.TongChiTieu.ToString("N0")đ</strong></td>
                            <td role="cell" data-label="Điểm">@k.Diem điểm</td>
                        </tr>
                    }
                </tbody>
            </table></div>
        }
    </section>
}


@if (Model.Muc == "vouchers")
{
    <section class="tongquan-panel" id="tq-vouchers" aria-label="Voucher">
        <div class="section-head">
            <h2>Voucher (@Model.Vouchers.Count)</h2>
            <a asp-action="Vouchers">Xem đầy đủ →</a>
        </div>
        <input type="search" class="form-control tongquan-filter" data-tongquan-filter="tq-vouchers" placeholder="Lọc theo mã voucher…" aria-label="Lọc voucher theo mã" />
        @if (!Model.Vouchers.Any())
        {
            <p class="text-muted">Chưa có voucher nào.</p>
        }
        else
        {
            <div class="table-wrap admin-record-list"><table class="table" role="table" aria-label="Voucher">
                <thead role="rowgroup"><tr role="row"><th scope="col">Mã</th><th scope="col">Giá trị</th><th scope="col">Đơn tối thiểu</th><th scope="col">Hết hạn</th><th scope="col">Đã dùng / Số lượng</th></tr></thead>
                <tbody role="rowgroup">
                    @foreach (var v in Model.Vouchers)
                    {
                        <tr role="row">
                            <th scope="row" role="rowheader" class="admin-record-lead">@v.Ma</th>
                            <td role="cell" data-label="Giá trị"><strong class="admin-money">@(v.FreeShip ? "Miễn phí vận chuyển" : v.LoaiGiam == "PhanTram" ? v.GiaTri.ToString("0.##") + "%" : v.GiaTri.ToString("N0") + "đ")</strong></td>
                            <td role="cell" data-label="Đơn tối thiểu">@v.DieuKien.ToString("N0")đ</td>
                            <td role="cell" data-label="Hết hạn">@v.NgayHetHan.ToString("dd/MM/yyyy")</td>
                            <td role="cell" data-label="Đã dùng / Số lượng">@v.DaDung / @v.SoLuong</td>
                        </tr>
                    }
                </tbody>
            </table></div>
        }
        <section class="card admin-editor mt">
        <h3>Thêm voucher mới</h3>
        <form asp-action="ThemVoucher" method="post">
            <input type="hidden" name="__Invariant" value="GiaTri" />
            <input type="hidden" name="tuTrang" value="TongQuan" />
            <input type="hidden" name="muc" value="@Model.Muc" />
            <div class="admin-form-grid">
                <fieldset class="admin-form-card">
                    <legend>Mã và mức giảm</legend>
                    <div class="form-group">
                        <label for="tq-Ma">Mã (vd: TECHZONE500)</label>
                        <input id="tq-Ma" name="Ma" class="form-control" required maxlength="50" />
                    </div>
                    <div class="form-group">
                        <label for="tq-LoaiGiam">Loại giảm</label>
                        <select id="tq-LoaiGiam" name="LoaiGiam" class="form-control">
                            <option value="Tien">Giảm số tiền cố định</option>
                            <option value="PhanTram">Giảm theo %</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="tq-GiaTri">Giá trị (đ hoặc %)</label>
                        <input id="tq-GiaTri" name="GiaTri" class="form-control" type="number" inputmode="decimal" min="0" step="any" required />
                    </div>
                </fieldset>
                <fieldset class="admin-form-card">
                    <legend>Điều kiện và thời gian</legend>
                    <div class="form-group">
                        <label for="tq-DieuKien">Đơn tối thiểu (đ)</label>
                        <input id="tq-DieuKien" name="DieuKien" class="form-control" type="number" min="0" step="1" value="0" />
                    </div>
                    <div class="form-group">
                        <label for="tq-SoLuong">Số lượng mã</label>
                        <input id="tq-SoLuong" name="SoLuong" class="form-control" type="number" min="1" value="100" required />
                    </div>
                    <div class="form-group">
                        <label for="tq-NgayHetHan">Ngày hết hạn</label>
                        <input id="tq-NgayHetHan" name="NgayHetHan" class="form-control" type="date" required />
                    </div>
                </fieldset>
            </div>
            <button type="submit" class="btn btn-primary">Thêm voucher</button>
        </form>
        </section>
    </section>
}


@if (Model.Muc == "combos")
{
    <section class="tongquan-panel" id="tq-combos" aria-label="Combo">
        <div class="section-head">
            <h2>Combo (@Model.Combos.Count)</h2>
            <a asp-action="Combos">Xem đầy đủ →</a>
        </div>
        <input type="search" class="form-control tongquan-filter" data-tongquan-filter="tq-combos" placeholder="Lọc theo tên combo…" aria-label="Lọc combo theo tên" />
        @if (!Model.Combos.Any())
        {
            <p class="text-muted">Chưa có combo nào.</p>
        }
        else
        {
            <div class="table-wrap admin-record-list"><table class="table" role="table" aria-label="Combo">
                <thead role="rowgroup"><tr role="row"><th scope="col">Tên combo</th><th scope="col">% giảm</th><th scope="col">Trạng thái</th><th scope="col">Hiệu lực</th><th scope="col">Đã bán / Giới hạn</th><th scope="col">Món trong combo</th><th scope="col">Thao tác</th></tr></thead>
                <tbody role="rowgroup">
                    @foreach (var c in Model.Combos)
                    {
                        <tr role="row">
                            <th scope="row" role="rowheader" class="admin-record-lead"><strong>@c.Ten</strong>@if (!string.IsNullOrEmpty(c.MoTa)) { <span class="admin-record-code text-muted">@c.MoTa</span> }</th>
                            <td role="cell" data-label="Mức giảm"><strong class="admin-money">@c.PhanTramGiam.ToString("0.##")%</strong></td>
                            <td role="cell" data-label="Trạng thái"><partial name="_TrangThaiBadge" model="@(c.IsActive ? "Đang bật" : "Đã tắt")" /></td>
                            <td role="cell" data-label="Hiệu lực">@c.BatDau.ToString("dd/MM/yyyy") – @c.KetThuc.ToString("dd/MM/yyyy")</td>
                            <td role="cell" data-label="Đã bán / Giới hạn">@c.DaBan / @(c.GioiHanSL?.ToString() ?? "∞")</td>
                            <td role="cell" class="admin-record-wide">
                                <details class="admin-combo-items">
                                <summary>Xem @c.Items.Count món</summary>
                                <ul class="admin-item-list" role="list">
                                    @foreach (var item in c.Items)
                                    {
                                        <li><span class="product-thumb-cell"><img class="product-thumb" src="@item.Product.AnhDaiDien" alt="" loading="lazy" />@item.Product.Ten × @item.SoLuong</span></li>
                                    }
                                </ul>
                                </details>
                            </td>
                            <td role="cell" class="admin-record-actions">
                                <div class="admin-row-actions">
                                <a asp-action="SuaCombo" asp-route-id="@c.Id" class="btn btn-secondary btn-sm" aria-label="Sửa @c.Ten">Sửa</a>
                                <form asp-action="BatTatCombo" method="post" class="inline-form">
                                    <input type="hidden" name="id" value="@c.Id" />
                                    <input type="hidden" name="tuTrang" value="TongQuan" />
                                    <input type="hidden" name="muc" value="@Model.Muc" />
                                    <button type="submit" class="btn btn-secondary btn-sm" aria-label="@(c.IsActive ? "Tắt" : "Bật") @c.Ten">@(c.IsActive ? "Tắt" : "Bật")</button>
                                </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table></div>
        }
    </section>
}


@if (Model.Muc == "flashsale")
{
    <section class="tongquan-panel" id="tq-flashsale" aria-label="Flash Sale">
        <div class="section-head">
            <h2>Flash Sale (@Model.FlashSaleSlots.Count khung)</h2>
            <a asp-action="FlashSaleSlots">Xem đầy đủ →</a>
        </div>
        @* Dot 2 (B7): o loc cho tab Flash Sale (truoc day chua co) — dung san
           admin.js filter (loc theo ten SP / gia sale trong cac bang khung). *@
        <input type="search" class="form-control tongquan-filter" data-tongquan-filter="tq-flashsale" placeholder="Lọc theo tên sản phẩm trong khung…" aria-label="Lọc Flash Sale theo tên sản phẩm" />
        @if (!Model.FlashSaleSlots.Any())
        {
            <p class="text-muted">Chưa có khung Flash Sale nào.</p>
        }
        else
        {
            @foreach (var s in Model.FlashSaleSlots)
            {
                <section class="card admin-editor mt">
                <div class="section-head">
                    <div class="admin-slot-title">
                        <h3>Khung @s.Ten</h3>
                        <partial name="_TrangThaiBadge" model="@(s.IsActive ? "Đang bật" : "Đã tắt")" />
                    </div>
                    @* Dot 2 (B6): bat/tat slot — POST BatTatSlot moi, chi doi co
                       IsActive (gia sale van do PriceCalculationService tinh). *@
                    <form asp-action="BatTatSlot" method="post" class="inline-form">
                        <input type="hidden" name="id" value="@s.Id" />
                        <input type="hidden" name="tuTrang" value="TongQuan" />
                        <input type="hidden" name="muc" value="@Model.Muc" />
                        <button type="submit" class="btn btn-secondary btn-sm">@(s.IsActive ? "Tắt khung" : "Bật khung")</button>
                    </form>
                </div>
                @if (!s.Items.Any())
                {
                    <p class="text-muted">Chưa có sản phẩm nào trong khung này.</p>
                }
                else
                {
                    <div class="table-wrap admin-record-list"><table class="table" role="table" aria-label="Sản phẩm trong khung @s.Ten">
                        <thead role="rowgroup"><tr role="row"><th scope="col">Sản phẩm</th><th scope="col">Giá sale</th></tr></thead>
                        <tbody role="rowgroup">
                            @foreach (var item in s.Items)
                            {
                                <tr role="row">
                                    <th scope="row" role="rowheader" class="admin-record-lead"><span class="product-thumb-cell"><img class="product-thumb" src="@item.Product.AnhDaiDien" alt="" width="48" height="48" loading="lazy" />@item.Product.Ten</span></th>
                                    <td role="cell" class="admin-record-wide" data-label="Giá sale"><strong class="admin-money">@item.GiaSale.ToString("N0")đ</strong></td>
                                </tr>
                            }
                        </tbody>
                    </table></div>
                }
                </section>
            }
        }
        <section class="card admin-editor mt">
        <h3>Thêm khung giờ mới</h3>
        <form asp-action="ThemSlot" method="post" class="admin-inline-fields admin-slot-hours">
            <input type="hidden" name="tuTrang" value="TongQuan" />
            <input type="hidden" name="muc" value="@Model.Muc" />
            <div class="form-group">
                <label for="tq-GioBatDau">Giờ bắt đầu (0–23)</label>
                <input id="tq-GioBatDau" name="gioBatDau" class="form-control" type="number" min="0" max="23" required />
            </div>
            <div class="form-group">
                <label for="tq-GioKetThuc">Giờ kết thúc (1–24)</label>
                <input id="tq-GioKetThuc" name="gioKetThuc" class="form-control" type="number" min="1" max="24" required />
            </div>
            <button type="submit" class="btn btn-primary">Thêm khung giờ</button>
        </form>
        </section>
    </section>
}


@if (Model.Muc == "banners")
{
    <section class="tongquan-panel" id="tq-banners" aria-label="Banner">
        <div class="section-head">
            <h2>Banner (@Model.Banners.Count)</h2>
            <a asp-action="Banners">Xem đầy đủ →</a>
        </div>
        <input type="search" class="form-control tongquan-filter" data-tongquan-filter="tq-banners" placeholder="Lọc theo tiêu đề banner…" aria-label="Lọc banner theo tiêu đề" />
        <partial name="_BannerRecords" model="((IEnumerable<Banner>)Model.Banners, true)" />
    </section>
}


@if (Model.Muc == "reviews")
{
    <section class="tongquan-panel" id="tq-reviews" aria-label="Đánh giá và hỏi đáp">
        <div class="section-head">
            <h2>Đánh giá &amp; hỏi đáp</h2>
            <a asp-action="Reviews">Xem đầy đủ →</a>
        </div>
        <partial name="_AdminModeration" model="((IEnumerable<Review>)Model.ReviewsChoDuyet, (IEnumerable<Review>)Model.ReviewsDaDuyetGanDay, (IEnumerable<ProductQuestion>)Model.CauHoiChuaTraLoi, true)" />
    </section>
}


@if (Model.Muc == "stock")
{
    <section class="tongquan-panel" id="tq-stock" aria-label="Kho">
        <div class="section-head">
            <h2>Kho (@Model.SanPhamKho.Count sản phẩm)</h2>
            <a asp-action="Kho">Xem đầy đủ →</a>
        </div>
        <input type="search" class="form-control tongquan-filter" data-tongquan-filter="tq-stock" placeholder="Lọc theo tên sản phẩm…" aria-label="Lọc kho theo tên sản phẩm" />
        @* Dot 3 (B3): xuat CSV kho — giong trang Kho cu. *@
        <p><a class="btn btn-secondary btn-sm" asp-action="XuatCsvKho">⬇ Xuất CSV kho</a></p>
        @if (!Model.SanPhamKho.Any())
        {
            <p class="text-muted">Chưa có sản phẩm nào trong kho.</p>
        }
        else
        {
            <div class="table-wrap admin-record-list"><table data-tongquan-records class="table" role="table" aria-label="Tồn kho sản phẩm">
                <thead role="rowgroup"><tr role="row"><th scope="col">Sản phẩm</th><th scope="col">Tồn kho</th><th scope="col">Đã bán</th><th scope="col">Nhập thêm</th></tr></thead>
                <tbody role="rowgroup">
                    @foreach (var p in Model.SanPhamKho)
                    {
                        <tr role="row">
                            <th scope="row" role="rowheader" class="admin-record-lead">
                                <span class="product-thumb-cell">
                                    <img class="product-thumb" src="@p.AnhDaiDien" alt="" width="48" height="48" loading="lazy" />
                                    <span><a asp-controller="Products" asp-action="Details" asp-route-id="@p.Id">@p.Ten</a><small class="admin-record-code text-muted">Mã #@p.Id</small></span>
                                </span>
                            </th>
                            <td role="cell" data-label="Tồn kho"><span class="badge @(p.TonKho == 0 ? "low-stock" : p.TonKho <= 10 ? "low-stock-soft" : "badge-xong")">@(p.TonKho == 0 ? "Hết hàng · 0" : $"Còn {p.TonKho}")</span></td>
                            <td role="cell" data-label="Đã bán">@p.LuotBan</td>
                            <td role="cell" class="admin-record-actions">
                                <form asp-action="NhapKho" method="post" class="admin-inline-fields admin-stock-entry">
                                    <input type="hidden" name="productId" value="@p.Id" />
                                    <input type="hidden" name="tuTrang" value="TongQuan" />
                                    <input type="hidden" name="muc" value="@Model.Muc" />
                                    <div class="form-group">
                                        <label for="nhap-@p.Id">Số lượng nhập</label>
                                        <input id="nhap-@p.Id" type="number" name="soLuong" class="form-control" min="1" value="10" required />
                                    </div>
                                    <div class="form-group">
                                        <label for="ghichu-@p.Id">Ghi chú <small>(tùy chọn)</small></label>
                                        <input id="ghichu-@p.Id" type="text" name="ghiChu" class="form-control" maxlength="200" />
                                    </div>
                                    <button type="submit" class="btn btn-primary btn-sm" aria-label="Nhập kho @p.Ten">Nhập kho</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table></div>
        }
        <h3 class="mt">10 lần nhập kho gần nhất</h3>
        @if (!Model.NhapKhoGanDay.Any())
        {
            <p class="text-muted">Chưa có lần nhập kho nào.</p>
        }
        else
        {
            <div class="table-wrap admin-record-list"><table class="table" role="table" aria-label="Lịch sử nhập kho">
                <thead role="rowgroup"><tr role="row"><th scope="col">Sản phẩm</th><th scope="col">Ngày nhập</th><th scope="col">Số lượng</th><th scope="col">Ghi chú</th></tr></thead>
                <tbody role="rowgroup">
                    @foreach (var s in Model.NhapKhoGanDay)
                    {
                        <tr role="row">
                            <th scope="row" role="rowheader" class="admin-record-lead">@s.Product.Ten</th>
                            <td role="cell" data-label="Ngày nhập">@s.NgayNhap.ToString("dd/MM/yyyy HH:mm")</td>
                            <td role="cell" data-label="Số lượng"><strong class="admin-money">+@s.SoLuong</strong></td>
                            <td role="cell" class="admin-record-wide" data-label="Ghi chú">@(string.IsNullOrWhiteSpace(s.GhiChu) ? "—" : s.GhiChu)</td>
                        </tr>
                    }
                </tbody>
            </table></div>
        }
    </section>
}


@if (Model.Muc == "notifications")
{
    <section class="tongquan-panel" id="tq-notifications" aria-label="Thông báo">
        <div class="section-head">
            <h2>Thông báo</h2>
            <a asp-action="ThongBao">Xem đầy đủ →</a>
        </div>
        @* Dot 2 (B7): o loc cho tab Thong bao (truoc day chua co). *@
        <input type="search" class="form-control tongquan-filter" data-tongquan-filter="tq-notifications" placeholder="Lọc theo tiêu đề / người nhận…" aria-label="Lọc thông báo theo tiêu đề hoặc người nhận" />
        <div class="card admin-editor">
            <h3>Soạn thông báo</h3>
        <form asp-action="GuiThongBao" method="post">
            <input type="hidden" name="tuTrang" value="TongQuan" />
            <input type="hidden" name="muc" value="@Model.Muc" />
            <div class="admin-form-grid">
                <fieldset class="admin-form-card">
                    <legend>Người nhận</legend>
                    <div class="form-group">
                        <label for="tq-UserId">Gửi tới</label>
                        <select id="tq-UserId" name="userId" class="form-control" required>
                            <option value="">Chọn người nhận</option>
                            <option value="all">Tất cả khách hàng</option>
                            @foreach (var u in Model.NguoiNhanThongBao)
                            {
                                <option value="@u.Id">@u.HoTen (@u.Email)</option>
                            }
                        </select>
                    </div>
                </fieldset>
                <fieldset class="admin-form-card">
                    <legend>Nội dung</legend>
                    <div class="form-group">
                        <label for="tq-TieuDe">Tiêu đề</label>
                        <input id="tq-TieuDe" name="tieuDe" class="form-control" required maxlength="200" />
                    </div>
                    <div class="form-group">
                        <label for="tq-NoiDung">Nội dung</label>
                        <textarea id="tq-NoiDung" name="noiDung" class="form-control" rows="4" maxlength="1000"></textarea>
                    </div>
                </fieldset>
            </div>
            <button type="submit" class="btn btn-primary">Gửi thông báo</button>
        </form>
        </div>
        <h3 class="mt">20 thông báo gần nhất</h3>
        <partial name="_AdminNotificationRecords" model="Model.ThongBaoGanDay" />
    </section>
}


@if (Model.Muc == "returns")
{
    <section class="tongquan-panel" id="tq-returns" aria-label="Đổi trả và bảo hành">
        <div class="section-head">
            <h2>Đổi trả / Bảo hành</h2>
            <a asp-controller="Returns" asp-action="AdminIndex">Xem đầy đủ →</a>
        </div>
        @* Dot 2 (B7): o loc cho tab Doi tra (truoc day chua co) — loc ca 2 bang
           doi tra + bao hanh trong panel (admin.js loc moi tbody tr). *@
        <input type="search" class="form-control tongquan-filter" data-tongquan-filter="tq-returns" placeholder="Lọc theo khách / sản phẩm / lý do…" aria-label="Lọc đổi trả và bảo hành" />
        <partial name="_AdminRequestRecords" model="((IEnumerable<ReturnRequest>)Model.DoiTraChoDuyet, (IEnumerable<WarrantyClaim>)Model.BaoHanhChoDuyet, true)" />
    </section>
}
