@model List<TechZone.Models.Voucher>
@{
    ViewData["Title"] = "Admin — Quản lý voucher";
    var tuKhoa = (string?)ViewBag.TuKhoa;
    var hienTai = DateTime.Now;
}
<header class="market-heading">
    <div class="section-head">
        <h1>Quản lý voucher</h1>
        <a class="btn hero-buy" href="#them-voucher">Thêm voucher</a>
    </div>
</header>

@* Dot 2 (B1): tim kiem theo ma voucher + phan trang server 10/trang. *@
<form method="get" asp-action="Vouchers" class="admin-search admin-search-compact" role="search">
    <input type="search" name="tuKhoa" class="form-control" placeholder="Tìm theo mã voucher…" value="@tuKhoa" aria-label="Tìm voucher theo mã" />
    <button type="submit" class="btn btn-primary">Tìm</button>
    @if (tuKhoa is not null)
    {
        <a class="btn btn-secondary" asp-action="Vouchers">Xóa lọc</a>
    }
</form>
<p class="admin-result-count text-muted" aria-live="polite">@ViewBag.TongMuc kết quả@(tuKhoa is not null ? $" cho “{tuKhoa}”" : "")</p>

@if (!Model.Any())
{
    <p class="admin-empty" role="status">Không tìm thấy voucher nào@(tuKhoa is not null ? $" phù hợp với “{tuKhoa}”" : ""). <a asp-action="Vouchers">Xem danh sách đầy đủ</a>.</p>
}
else
{
<div class="table-wrap admin-record-list"><table class="table" role="table" aria-label="Danh sách voucher">
    <thead role="rowgroup"><tr role="row"><th scope="col">Mã voucher</th><th scope="col">Giá trị</th><th scope="col">Đơn tối thiểu</th><th scope="col">Hết hạn</th><th scope="col">Đã dùng / Số lượng</th><th scope="col">Thao tác</th></tr></thead>
    <tbody role="rowgroup">
        @foreach (var v in Model)
        {
            var conHieuLuc = v.ConHieuLuc(hienTai);
            <tr role="row">
                <th scope="row" role="rowheader" class="admin-record-lead">
                    <span class="admin-record-title">
                        <strong>@v.Ma</strong>
                        <span class="badge @(conHieuLuc ? "badge-xong" : "badge-tat")">@(conHieuLuc ? "Còn hiệu lực" : hienTai > v.NgayHetHan ? "Hết hạn" : "Hết lượt")</span>
                    </span>
                </th>
                <td role="cell" data-label="Giá trị"><strong class="admin-money">@(v.FreeShip ? "Miễn phí vận chuyển" : v.LoaiGiam == "PhanTram" ? v.GiaTri.ToString("0.##") + "%" : v.GiaTri.ToString("N0") + "đ")</strong></td>
                <td role="cell" data-label="Đơn tối thiểu">@v.DieuKien.ToString("N0")đ</td>
                <td role="cell" data-label="Hết hạn">@v.NgayHetHan.ToString("dd/MM/yyyy")</td>
                <td role="cell" data-label="Đã dùng / Số lượng">@v.DaDung / @v.SoLuong</td>
                <td role="cell" class="admin-record-actions">
                    <form asp-action="XoaVoucher" method="post" class="inline-form">
                        <input type="hidden" name="id" value="@v.Id" />
                        <button type="submit" class="btn btn-danger btn-sm" aria-label="Xóa voucher @v.Ma" data-confirm="Xóa voucher @v.Ma?" onclick="return confirm(this.dataset.confirm);">Xóa</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table></div>
}

@if ((int)ViewBag.TongTrang > 1)
{
    <nav class="pagination" aria-label="Phân trang">
        @if ((int)ViewBag.TrangHienTai > 1)
        {
            <a asp-action="Vouchers" asp-route-tuKhoa="@tuKhoa" asp-route-page="@((int)ViewBag.TrangHienTai - 1)">← Trang trước</a>
        }
        <span class="page-current">Trang @ViewBag.TrangHienTai / @ViewBag.TongTrang</span>
        @if ((int)ViewBag.TrangHienTai < (int)ViewBag.TongTrang)
        {
            <a asp-action="Vouchers" asp-route-tuKhoa="@tuKhoa" asp-route-page="@((int)ViewBag.TrangHienTai + 1)">Trang sau →</a>
        }
    </nav>
}

<section class="card admin-editor mt" id="them-voucher" aria-labelledby="them-voucher-title" tabindex="-1">
<h2 id="them-voucher-title">Thêm voucher mới</h2>
<form asp-action="ThemVoucher" method="post">
    <input type="hidden" name="__Invariant" value="GiaTri" />
    <div class="admin-form-grid">
        <fieldset class="admin-form-card">
            <legend>Mã và mức giảm</legend>
            <div class="form-group">
                <label for="Ma">Mã (vd: TECHZONE500)</label>
                <input id="Ma" name="Ma" class="form-control" required maxlength="50" autocapitalize="characters" spellcheck="false" />
            </div>
            <div class="form-group">
                <label for="LoaiGiam">Loại giảm</label>
                <select id="LoaiGiam" name="LoaiGiam" class="form-control">
                    <option value="Tien">Giảm số tiền cố định</option>
                    <option value="PhanTram">Giảm theo %</option>
                </select>
            </div>
            <div class="form-group">
                <label for="GiaTri">Giá trị (đ hoặc %)</label>
                <input id="GiaTri" name="GiaTri" class="form-control" type="number" inputmode="decimal" min="0" step="any" required />
            </div>
        </fieldset>
        <fieldset class="admin-form-card">
            <legend>Điều kiện và thời gian</legend>
            <div class="form-group">
                <label for="DieuKien">Đơn tối thiểu (đ)</label>
                <input id="DieuKien" name="DieuKien" class="form-control" type="number" min="0" step="1" value="0" />
            </div>
            <div class="form-group">
                <label for="SoLuong">Số lượng mã</label>
                <input id="SoLuong" name="SoLuong" class="form-control" type="number" min="1" value="100" required />
            </div>
            <div class="form-group">
                <label for="NgayHetHan">Thời gian hết hạn</label>
                <input id="NgayHetHan" name="NgayHetHan" class="form-control" type="date" required />
            </div>
        </fieldset>
    </div>
    <button type="submit" class="btn btn-primary">Thêm voucher</button>
</form>
</section>
<p class="mt"><a asp-action="Dashboard">← Về Dashboard</a></p>
