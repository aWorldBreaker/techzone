@model TechZone.Models.CartViewModel
@{
    ViewData["Title"] = "Giỏ hàng";
}

<h1>Giỏ hàng (@Model.Lines.Sum(l => l.SoLuong) sản phẩm)</h1>

@if (!Model.Lines.Any())
{
    <p>Giỏ hàng đang trống.</p>
    <a class="btn btn-primary" asp-controller="Products" asp-action="Index">Tiếp tục mua sắm</a>
}
else
{
    <div class="cart-layout">
        <div>
            @foreach (var line in Model.Lines)
            {
                <div class="cart-item">
                    <img src="@line.Product.AnhDaiDien" alt="@line.Product.Ten" />
                    <div>
                        <h3 class="cart-item-title"><a asp-controller="Products" asp-action="Details" asp-route-id="@line.Product.Id">@line.Product.Ten</a></h3>
                        @if (line.Variant is not null)
                        {
                            <p class="text-muted cart-line-meta">@line.Variant.TenBienThe</p>
                        }
                        <p class="cart-line-price"><strong>@line.DonGia.ToString("N0")đ</strong>
                        @if (line.LaGiaSale)
                        {
                            <s class="text-muted">@line.GiaGoc.ToString("N0")đ</s>
                            <span>@line.TenKhuyenMai</span>
                        }
                        </p>
                        <form asp-action="Update" method="post" class="qty">
                            <input type="hidden" name="productId" value="@line.Product.Id" />
                            <input type="hidden" name="variantId" value="@line.Variant?.Id" />
                            @* Sprint 6 Module 4 — nut - / + (xem cart-qty.js):
                               - o 1 ve 0 = xoa dong; + kep ve TonKho. *@
                            <button type="button" class="qty-btn" data-delta="-1" aria-label="Giảm số lượng">−</button>
                            <input type="number" name="soLuong" min="0" max="@line.Product.TonKho" value="@line.SoLuong" aria-label="Số lượng" />
                            <button type="button" class="qty-btn" data-delta="1" aria-label="Tăng số lượng">+</button>
                            <button type="submit">Cập nhật</button>
                        </form>
                    </div>
                    <div class="text-right">
                        <p><strong>@line.ThanhTien.ToString("N0")đ</strong></p>
                        <form asp-action="Remove" method="post">
                            <input type="hidden" name="productId" value="@line.Product.Id" />
                            <input type="hidden" name="variantId" value="@line.Variant?.Id" />
                            <button type="submit" class="link-button">Xóa</button>
                        </form>
                    </div>
                </div>
            }
            <a asp-controller="Products" asp-action="Index">← Tiếp tục mua sắm</a>
        </div>

        <aside class="summary" aria-label="Tóm tắt đơn hàng">
            <h2>Tóm tắt đơn hàng</h2>
            <div class="summary-row"><span>Tạm tính</span><span>@Model.TamTinh.ToString("N0")đ</span></div>
            @if (Model.GiamGia > 0)
            {
                <div class="summary-row"><span>Giảm voucher (@Model.MaVoucher)</span><span>- @Model.GiamGia.ToString("N0")đ</span></div>
            }
            @if (Model.GiamGiaCombo > 0)
            {
                <div class="summary-row"><span>Giảm combo</span><span>- @Model.GiamGiaCombo.ToString("N0")đ</span></div>
            }
            @if (Model.GiamGiaHang > 0)
            {
                <div class="summary-row"><span>Giảm hạng @ViewBag.Hang (2%)</span><span>- @Model.GiamGiaHang.ToString("N0")đ</span></div>
            }
            @if (Model.GiamGia > 0 || Model.GiamGiaCombo > 0 || Model.GiamGiaHang > 0)
            {
                <div class="summary-row"><span>Tạm tính sau giảm</span><span>@Model.SauGiam.ToString("N0")đ</span></div>
            }
            @if (Model.GiamGiaHang > 0)
            {
                <p class="text-muted">Đã áp dụng ưu đãi hạng @ViewBag.Hang: giảm 2% tạm tính @Model.TamTinh.ToString("N0")đ, còn @Model.SauGiam.ToString("N0")đ trước phí ship — giống hệt tổng ở trang đặt hàng.</p>
            }
            <div class="summary-row"><span>Phí ship</span><span>@(Model.PhiShip == 0 ? "Miễn phí" : Model.PhiShip.ToString("N0") + "đ")</span></div>
            <div class="summary-row total"><span>Tổng cộng</span><span>@Model.TongCong.ToString("N0")đ</span></div>
            <partial name="_InstallmentBadge" model="Model.TongCong" />

            @* Sprint 6 Module 4 — diem tich luy (CHI HIEN THI): diem se
               tich = 1% tong don, cung cong thuc LoyaltyService
               (TongTien / 100.000, lam tron xuong) — tong o day la
               TongCong (sau giam + ship) giong TongTien don that.
               Chi hien so du + nhac dung o checkout; checkout KHONG co
               session luu diem (DiemDung la field POST cua form Checkout)
               nen gio khong co o dung diem, khong phat minh co che moi. *@
            @if (ViewBag.DiemSeTich is int diemSeTich)
            {
                <div class="summary-row"><span>Điểm sẽ tích</span><span>@diemSeTich điểm (≈ @((diemSeTich * 1000).ToString("N0"))đ)</span></div>
            }
            @if (User.Identity?.IsAuthenticated == true)
            {
                @if (ViewBag.DiemHienTai is int diemHienTai)
                {
                    <div class="summary-row"><span>Điểm hiện có</span><span>@diemHienTai điểm</span></div>
                }
                <p class="text-muted">Bạn có thể dùng điểm ở bước đặt hàng (1 điểm = 1.000đ).</p>
            }
            else
            {
                @* QA Phase 4 (fix): guest KHONG tich diem that —
                   LoyaltyService.GhiDiemMuaHangAsync return som khi
                   Order.UserId is null (runner test Guest_KhongTichDiem).
                   Dong cu "Đăng nhập để dùng điểm tích lũy" + dong "Điểm
                   sẽ tích: N điểm" o tren de doc thanh guest se duoc N
                   diem. Doi thanh cau co dieu kien dang nhap, chi doi
                   text, khong doi logic tinh diem. *@
                @if (ViewBag.DiemSeTich is int diemGuest && diemGuest > 0)
                {
                    <p class="text-muted">Đăng nhập để tích @diemGuest điểm cho đơn này (≈ @((diemGuest * 1000).ToString("N0"))đ).</p>
                }
                else
                {
                    <p class="text-muted">Đăng nhập để dùng điểm tích lũy (1 điểm = 1.000đ).</p>
                }
            }

            <form asp-action="ApDungVoucher" method="post" class="mt">
                <div class="form-group">
                    <label for="ma">Mã giảm giá</label>
                    <input id="ma" name="ma" class="form-control" placeholder="Nhập mã voucher, vd: TECHZONE500" value="@Model.MaVoucher" />
                </div>
                <button type="submit" class="btn btn-secondary btn-block">Áp dụng</button>
            </form>

            <a asp-controller="Orders" asp-action="Checkout" class="btn btn-primary btn-block mt">Đặt hàng</a>
            <p class="text-muted">Thanh toán khi nhận hàng (COD) hoặc chuyển khoản — đều là giả lập, không thu tiền thật.</p>
        </aside>
    </div>
}

@section Scripts {
    <script src="~/js/cart-qty.js"></script>
}
