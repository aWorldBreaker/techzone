@model TechZone.Models.CartViewModel
@{
    ViewData["Title"] = "Giỏ hàng";
}

<header class="purchase-heading">
    <partial name="_MarketPurchasePath" model="false" />
    <div class="section-head">
        <h1>Giỏ hàng</h1>
        @if (Model.Lines.Any())
        {
            <a asp-controller="Products" asp-action="Index">Tiếp tục mua sắm</a>
        }
    </div>
</header>

@if (!Model.Lines.Any())
{
    <div class="empty-state cart-empty">
        <p>Giỏ hàng đang trống.</p>
        <a asp-controller="Products" asp-action="Index" class="btn btn-primary">Tiếp tục mua sắm</a>
    </div>
}
else
{
    <div class="cart-layout cart-page">
        <div class="basket-column">
            <section class="cart-basket" aria-labelledby="basket-title">
                <div class="section-head basket-head"><h2 id="basket-title">Sản phẩm đã chọn</h2><span>@Model.Lines.Sum(l => l.SoLuong) sản phẩm</span></div>
                @foreach (var line in Model.Lines)
                {
                    var stock = line.Product.TonKho;
                    var stockMessageId = $"cart-stock-{line.Product.Id}-{line.Variant?.Id ?? 0}";
                    <div class="cart-item">
                        <img src="@line.Product.AnhDaiDien" alt="@line.Product.Ten" width="80" height="80" loading="lazy" />
                        <div>
                            <h3 class="cart-item-title"><a asp-controller="Products" asp-action="Details" asp-route-id="@line.Product.Id">@line.Product.Ten</a></h3>
                            @if (line.Variant is not null)
                            {
                                <p class="text-muted cart-line-meta">@line.Variant.TenBienThe</p>
                            }
                            <p class="cart-line-price"><strong>@line.DonGia.ToString("N0")đ</strong>
                            @if (line.LaGiaSale)
                            {
                                <s class="text-muted">@line.GiaGoc.ToString("N0")đ</s>
                                <span class="badge">@line.TenKhuyenMai</span>
                            }
                            </p>
                            <form asp-action="Update" method="post" class="qty">
                                <input type="hidden" name="productId" value="@line.Product.Id" />
                                <input type="hidden" name="variantId" value="@line.Variant?.Id" />
                                <button type="button" class="qty-btn" data-delta="-1" aria-label="Giảm số lượng @line.Product.Ten" hidden>−</button>
                                <input type="number" name="soLuong" min="1" max="@stock" value="@line.SoLuong" aria-label="Số lượng @line.Product.Ten" aria-describedby="@stockMessageId" disabled="@(stock <= 0)" />
                                <button type="button" class="qty-btn" data-delta="1" aria-label="Tăng số lượng @line.Product.Ten" hidden>+</button>
                                <button type="submit" class="link-button" disabled="@(stock <= 0)">Cập nhật</button>
                            </form>
                            <p class="cart-stock-hint" id="@stockMessageId" role="status" hidden="@(line.SoLuong < stock)">
                                @(stock > 0 ? $"Chỉ còn {stock} sản phẩm trong kho." : "Sản phẩm đã hết hàng. Hãy xóa khỏi giỏ để tiếp tục.")
                                @if (stock > 0 && line.SoLuong > stock) { <span>Giảm số lượng của @line.Product.Ten rồi bấm Cập nhật.</span> }
                            </p>
                        </div>
                        <div class="cart-line-total">
                            <p><strong>@line.ThanhTien.ToString("N0")đ</strong></p>
                            <form asp-action="Remove" method="post">
                                <input type="hidden" name="productId" value="@line.Product.Id" />
                                <input type="hidden" name="variantId" value="@line.Variant?.Id" />
                                <button type="submit" class="link-button" aria-label="Xóa @line.Product.Ten khỏi giỏ hàng">Xóa</button>
                            </form>
                        </div>
                    </div>
                }
            </section>
            <section class="cart-voucher card" aria-labelledby="cart-voucher-title">
                <h2 id="cart-voucher-title">Phiếu ưu đãi</h2>
                <form asp-action="ApDungVoucher" method="post">
                    <label for="ma">Mã giảm giá</label>
                    <div class="voucher-entry">
                        <input id="ma" name="ma" class="form-control" placeholder="Nhập mã voucher" value="@Model.MaVoucher" />
                        <button type="submit" class="btn btn-secondary">Áp dụng</button>
                    </div>
                </form>
            </section>
        </div>

        <aside class="summary market-receipt" aria-label="Tóm tắt đơn hàng">
            <h2>Tóm tắt đơn hàng</h2>
            <div class="summary-row"><span>Tạm tính (@Model.Lines.Sum(l => l.SoLuong) sản phẩm)</span><span>@Model.TamTinh.ToString("N0")đ</span></div>
            @if (Model.GiamGia > 0)
            {
                <div class="summary-row"><span>Giảm voucher (@Model.MaVoucher)</span><span>- @Model.GiamGia.ToString("N0")đ</span></div>
            }
            @if (Model.GiamGiaCombo > 0)
            {
                <div class="summary-row"><span>Giảm combo</span><span>- @Model.GiamGiaCombo.ToString("N0")đ</span></div>
            }
            @if (Model.GiamGiaHang > 0)
            {
                <div class="summary-row"><span>Giảm hạng @ViewBag.Hang (2%)</span><span>- @Model.GiamGiaHang.ToString("N0")đ</span></div>
            }
            @if (Model.GiamGia > 0 || Model.GiamGiaCombo > 0 || Model.GiamGiaHang > 0)
            {
                <div class="summary-row"><span>Tạm tính sau giảm</span><span>@Model.SauGiam.ToString("N0")đ</span></div>
            }
            <div class="summary-row"><span>Phí vận chuyển</span><span>@(Model.PhiShip == 0 ? "Miễn phí" : Model.PhiShip.ToString("N0") + "đ")</span></div>
            @if (Model.PhiShip > 0 && Model.SauGiam < 2_000_000m)
            {
                <p class="text-muted">Mua thêm @((2_000_000m - Model.SauGiam).ToString("N0"))đ để được miễn phí vận chuyển.</p>
            }
            <div class="cart-payment">
                <div class="summary-row total"><span>Tổng cộng</span><span class="price-tag"><strong class="price-amount">@Model.TongCong.ToString("N0")đ</strong></span></div>
                <a asp-controller="Orders" asp-action="Checkout" class="btn btn-primary">Tiến hành thanh toán</a>
            </div>
            <partial name="_InstallmentBadge" model="Model.TongCong" />

            @* Sprint 6 Module 4 — diem tich luy (CHI HIEN THI): diem se
               tich = 1% tong don, cung cong thuc LoyaltyService
               (TongTien / 100.000, lam tron xuong) — tong o day la
               TongCong (sau giam + ship) giong TongTien don that.
               Chi hien so du + nhac dung o checkout; checkout KHONG co
               session luu diem (DiemDung la field POST cua form Checkout)
               nen gio khong co o dung diem, khong phat minh co che moi. *@
            @if (ViewBag.DiemSeTich is int diemSeTich)
            {
                <div class="summary-row"><span>Điểm sẽ tích</span><span>@diemSeTich điểm (≈ @((diemSeTich * 1000).ToString("N0"))đ)</span></div>
            }
            @if (User.Identity?.IsAuthenticated == true)
            {
                @if (ViewBag.DiemHienTai is int diemHienTai)
                {
                    <div class="summary-row"><span>Điểm hiện có</span><span>@diemHienTai điểm</span></div>
                }
                <p class="text-muted">Bạn có thể dùng điểm ở bước đặt hàng (1 điểm = 1.000đ).</p>
            }
            else
            {
                @* QA Phase 4 (fix): guest KHONG tich diem that —
                   LoyaltyService.GhiDiemMuaHangAsync return som khi
                   Order.UserId is null (runner test Guest_KhongTichDiem).
                   Dong cu "Đăng nhập để dùng điểm tích lũy" + dong "Điểm
                   sẽ tích: N điểm" o tren de doc thanh guest se duoc N
                   diem. Doi thanh cau co dieu kien dang nhap, chi doi
                   text, khong doi logic tinh diem. *@
                @if (ViewBag.DiemSeTich is int diemGuest && diemGuest > 0)
                {
                    <p class="text-muted">Đăng nhập để tích @diemGuest điểm cho đơn này (≈ @((diemGuest * 1000).ToString("N0"))đ).</p>
                }
                else
                {
                    <p class="text-muted">Đăng nhập để dùng điểm tích lũy (1 điểm = 1.000đ).</p>
                }
            }

        </aside>
    </div>
}

@section Scripts {
    <script src="~/js/cart-qty.js" asp-append-version="true"></script>
}

@section Styles {
    <link rel="stylesheet" href="~/css/purchase.css" asp-append-version="true" />
}
