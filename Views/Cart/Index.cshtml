@model TechZone.Models.CartViewModel
@{
    ViewData["Title"] = "Giỏ hàng";
}

<h1>Giỏ hàng (@Model.Lines.Sum(l => l.SoLuong) sản phẩm)</h1>

@if (!Model.Lines.Any())
{
    <p>Giỏ hàng đang trống.</p>
    <a class="btn btn-primary" asp-controller="Products" asp-action="Index">Tiếp tục mua sắm</a>
}
else
{
    <div class="cart-layout">
        <div>
            @foreach (var line in Model.Lines)
            {
                <div class="cart-item">
                    <img src="@line.Product.AnhDaiDien" alt="@line.Product.Ten" />
                    <div>
                        <h3 class="cart-item-title"><a asp-controller="Products" asp-action="Details" asp-route-id="@line.Product.Id">@line.Product.Ten</a></h3>
                        @if (line.Variant is not null)
                        {
                            <p class="text-muted cart-line-meta">@line.Variant.TenBienThe</p>
                        }
                        <p class="cart-line-price"><strong>@line.DonGia.ToString("N0")đ</strong>
                        @if (line.LaGiaSale)
                        {
                            <s class="text-muted">@line.GiaGoc.ToString("N0")đ</s>
                            <span>@line.TenKhuyenMai</span>
                        }
                        </p>
                        <form asp-action="Update" method="post" class="qty">
                            <input type="hidden" name="productId" value="@line.Product.Id" />
                            <input type="hidden" name="variantId" value="@line.Variant?.Id" />
                            <input type="number" name="soLuong" min="0" max="@line.Product.TonKho" value="@line.SoLuong" aria-label="Số lượng" />
                            <button type="submit">Cập nhật</button>
                        </form>
                    </div>
                    <div class="text-right">
                        <p><strong>@line.ThanhTien.ToString("N0")đ</strong></p>
                        <form asp-action="Remove" method="post">
                            <input type="hidden" name="productId" value="@line.Product.Id" />
                            <input type="hidden" name="variantId" value="@line.Variant?.Id" />
                            <button type="submit" class="link-button">Xóa</button>
                        </form>
                    </div>
                </div>
            }
            <a asp-controller="Products" asp-action="Index">← Tiếp tục mua sắm</a>
        </div>

        <aside class="summary" aria-label="Tóm tắt đơn hàng">
            <h2>Tóm tắt đơn hàng</h2>
            <div class="summary-row"><span>Tạm tính</span><span>@Model.TamTinh.ToString("N0")đ</span></div>
            @if (Model.GiamGia > 0)
            {
                <div class="summary-row"><span>Giảm voucher (@Model.MaVoucher)</span><span>- @Model.GiamGia.ToString("N0")đ</span></div>
            }
            <div class="summary-row"><span>Phí ship</span><span>@(Model.PhiShip == 0 ? "Miễn phí" : Model.PhiShip.ToString("N0") + "đ")</span></div>
            <div class="summary-row total"><span>Tổng cộng</span><span>@Model.TongCong.ToString("N0")đ</span></div>
            <partial name="_InstallmentBadge" model="Model.TongCong" />

            <form asp-action="ApDungVoucher" method="post" class="mt">
                <div class="form-group">
                    <label for="ma">Mã giảm giá</label>
                    <input id="ma" name="ma" class="form-control" placeholder="Nhập mã voucher, vd: TECHZONE500" value="@Model.MaVoucher" />
                </div>
                <button type="submit" class="btn btn-secondary btn-block">Áp dụng</button>
            </form>

            <a asp-controller="Orders" asp-action="Checkout" class="btn btn-primary btn-block mt">Đặt hàng</a>
            <p class="text-muted">Thanh toán khi nhận hàng (COD) hoặc chuyển khoản — đều là giả lập, không thu tiền thật.</p>
        </aside>
    </div>
}
