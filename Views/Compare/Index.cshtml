@model List<TechZone.Models.Product>
@functions {
    private static string Hien(string? s) => string.IsNullOrWhiteSpace(s) ? "—" : s!;
}
@{
    ViewData["Title"] = "So sánh sản phẩm";
    var thongSo = new (string Ten, Func<Product, string?> Doc)[]
    {
        ("Chip", p => p.Specs?.Chip),
        ("RAM", p => p.Specs?.Ram),
        ("Bộ nhớ", p => p.Specs?.Rom),
        ("Pin", p => p.Specs?.Pin),
        ("Màn hình", p => p.Specs?.ManHinh),
        ("Camera", p => p.Specs?.Camera),
        ("Card đồ họa", p => p.Specs?.CardDoHoa)
    };
    var soCot = Model.Count + 1;
    var day = Model.Count == 3;
    var giaHieuDung = ViewBag.GiaHieuDung as Dictionary<int, decimal> ?? new();
}

<header class="market-heading order-heading">
    <nav class="market-path" aria-label="Đường dẫn">
        <a asp-controller="Products" asp-action="Index">Ngành hàng</a>
        <span aria-hidden="true">/</span><span aria-current="page">So sánh</span>
    </nav>
    <div class="section-head">
        <h1>So sánh sản phẩm</h1>
        <a class="btn hero-buy" asp-controller="Products" asp-action="Index">@(day ? "Xem ngành hàng" : "Thêm sản phẩm")</a>
    </div>
    @if (Model.Count > 0)
    {
        <p>Đang so sánh @Model.Count / 3 sản phẩm</p>
    }
</header>

@if (Model.Count == 0)
{
    <p class="empty-state">Chưa có sản phẩm nào. Bấm nút “So sánh” trên sản phẩm để thêm vào bảng, tối đa 3 sản phẩm.</p>
}
else
{
    <section class="compare-board @(day ? "compare-board-full" : "")" aria-labelledby="compare-title">
        <div class="section-head compare-toolbar">
            <h2 id="compare-title">Bảng đối chiếu</h2>
            <form asp-action="XoaHet" method="post">
                <button type="submit" class="btn btn-secondary">Xóa hết so sánh</button>
            </form>
        </div>
        @if (day)
        {
            <p class="compare-scroll-hint" id="compare-scroll-hint">Vuốt ngang để xem đủ sản phẩm. Cột tên thông số luôn hiển thị.</p>
        }
        <div class="compare-wrap" tabindex="0" role="region" aria-label="Bảng so sánh sản phẩm"
             aria-describedby="@(day ? "compare-scroll-hint" : null)">
            <table class="table compare-table" aria-labelledby="compare-title">
                <thead>
                    <tr>
                        <th scope="col">Sản phẩm</th>
                        @foreach (var p in Model)
                        {
                            <th scope="col">
                                <a asp-controller="Products" asp-action="Details" asp-route-id="@p.Id" class="compare-product">
                                    <img src="@p.AnhDaiDien" alt="" class="compare-thumb" width="96" height="96" />
                                    @p.Ten
                                </a>
                            </th>
                        }
                    </tr>
                </thead>
                <tbody>
                    <tr class="compare-group"><th scope="rowgroup" colspan="@soCot"><span>Giá và tình trạng</span></th></tr>
                    <tr class="compare-price"><th scope="row">Giá bán</th>@foreach (var p in Model) { <td><strong class="price-amount">@giaHieuDung.GetValueOrDefault(p.Id, p.GiaBan).ToString("N0")đ</strong></td> }</tr>
                    <tr><th scope="row">Giá gốc</th>@foreach (var p in Model) { <td class="compare-money">@p.Gia.ToString("N0")đ</td> }</tr>
                    <tr><th scope="row">Tồn kho</th>@foreach (var p in Model) { <td><partial name="_StockStatus" model="p.TonKho" /></td> }</tr>
                    <tr>
                        <th scope="row">Thao tác</th>
                        @foreach (var p in Model)
                        {
                            <td>
                                <div class="compare-actions">
                                    <form asp-controller="Cart" asp-action="Add" method="post">
                                        <input type="hidden" name="productId" value="@p.Id" />
                                        <input type="hidden" name="soLuong" value="1" />
                                        <button type="submit" class="btn btn-primary btn-block" disabled="@(p.TonKho <= 0)"
                                                aria-label="@(p.TonKho <= 0 ? null : $"Thêm vào giỏ: {p.Ten}")">@(p.TonKho <= 0 ? "Hết hàng" : "Thêm vào giỏ")</button>
                                    </form>
                                    <form asp-action="Remove" method="post">
                                        <input type="hidden" name="productId" value="@p.Id" />
                                        <button type="submit" class="btn btn-secondary btn-block" aria-label="Bỏ so sánh: @p.Ten">Bỏ so sánh</button>
                                    </form>
                                </div>
                            </td>
                        }
                    </tr>
                </tbody>
                <tbody>
                    <tr class="compare-group"><th scope="rowgroup" colspan="@soCot"><span>Cấu hình</span></th></tr>
                    @foreach (var muc in thongSo)
                    {
                        <tr>
                            <th scope="row">@muc.Ten</th>
                            @foreach (var p in Model)
                            {
                                <td>@Hien(muc.Doc(p))</td>
                            }
                        </tr>
                    }
                </tbody>
                <tbody>
                    <tr class="compare-group"><th scope="rowgroup" colspan="@soCot"><span>Đánh giá và bảo hành</span></th></tr>
                    <tr>
                        <th scope="row">Đánh giá</th>
                        @foreach (var p in Model)
                        {
                            var soDG = p.Reviews.Count;
                            var tb = soDG > 0 ? Math.Round(p.Reviews.Average(r => r.Sao), 1) : 0;
                            <td>@(soDG > 0 ? $"{tb:0.0} sao ({soDG} đánh giá)" : "Chưa có đánh giá")</td>
                        }
                    </tr>
                    <tr><th scope="row">Đã bán</th>@foreach (var p in Model) { <td>@p.LuotBan</td> }</tr>
                    <tr><th scope="row">Bảo hành</th>@foreach (var p in Model) { <td>24 tháng</td> }</tr>
                </tbody>
            </table>
        </div>
    </section>
}

@section Styles {
    <link rel="stylesheet" href="~/css/compare.css" asp-append-version="true" />
}
