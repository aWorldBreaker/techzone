@using TechZone.Models
@{
    ViewData["Title"] = "Trang chủ";
    var flashSale = (List<FlashSale>)ViewBag.FlashSale;
    var noiBat = (List<Product>)ViewBag.NoiBat;
    var banChay = (List<Product>)ViewBag.BanChay;
    var danhMuc = (List<Category>)ViewBag.DanhMuc;
    var ketThuc = (DateTime?)ViewBag.FlashSaleKetThuc;
    // Follow-up M4-3 (hero dong): cau danh gia chi xuat hien khi Xiaomi 15
    // co review da duyet; 0 review -> bo luon, khong hien so ghi tay.
    var heroSoDG = (int?)ViewBag.HeroSoDanhGia ?? 0;
    var heroTB = (double?)ViewBag.HeroDiemTB ?? 0;
    var heroDanhGia = heroSoDG > 0
        ? $" Đánh giá {heroTB.ToString("0.0", System.Globalization.CultureInfo.GetCultureInfo("vi-VN"))}/5 sao ({heroSoDG} đánh giá)."
        : "";
    // Phase 5 — Landing: hero dong tu DB (HomeController: ViewBag.Hero =
    // SP Id 1 kem Specs/Images). Ten/gia/gia gach/anh/link deu lay tu DB.
    var hero = ViewBag.Hero as Product;
    var heroSpecs = hero?.Specs is null ? Array.Empty<string>() : new[]
        { hero.Specs.Chip, hero.Specs.Camera, hero.Specs.ManHinh, hero.Specs.Pin }
        .Where(s => !string.IsNullOrWhiteSpace(s)).Select(s => s!).ToArray();
    var heroLead = heroSpecs.Length > 0
        ? string.Join(" • ", heroSpecs)
        : (hero?.MoTa ?? "");
}

@* Hero: một sản phẩm thật, giá thật, thông số thật — không slogan chung chung.
   Phase 5: ten/gia/anh/link doc tu DB (ViewBag.Hero); Id 1 khong co trong DB
   thi hien hero chung khong kem gia, khong ghi tay gia SP khac. *@
@if (hero is not null)
{
    <section class="hero">
        <div>
            <p class="hero-eyebrow">Sản phẩm nổi bật</p>
            <h1>@hero.Ten</h1>
            <p class="hero-price">
                <strong>@hero.GiaBan.ToString("N0")đ</strong>
                @if (hero.GiaKhuyenMai.HasValue && hero.Gia > hero.GiaBan)
                {
                    <s>@hero.Gia.ToString("N0")đ</s>
                    <span class="hero-save">Giảm @((hero.Gia - hero.GiaBan).ToString("N0"))đ</span>
                }
            </p>
            <p class="lead">@heroLead.@heroDanhGia</p>
            <div class="hero-actions">
                <a class="btn btn-primary" asp-controller="Products" asp-action="Details" asp-route-id="@hero.Id">Mua ngay — @hero.GiaBan.ToString("N0")đ</a>
                <a class="btn btn-secondary" asp-controller="Products" asp-action="Index">Xem tất cả sản phẩm</a>
            </div>
            @* Phase 5 — go cam ket chua xac minh: "Giao nhanh 2h noi thanh"
               khong co can cu nao trong code (PhiShip chi theo don >= 2tr /
               voucher / hang — PriceCalculationService:112), thay bang muc
               mien phi ship that co trong code; "Tra gop 0%" ghi ro gia lap
               theo mau Checkout. "Bao hanh 24 thang" GIU — chinh sach that:
               TraCuuBaoHanh/Warranty tinh han = NgayDat.AddMonths(24). *@
            <p class="hero-facts">Bảo hành 24 tháng <span aria-hidden="true">•</span> Miễn phí ship đơn từ 2.000.000đ <span aria-hidden="true">•</span> Trả góp 0% (giả lập)</p>
        </div>
        <div class="hero-image">
            <img src="@hero.AnhDaiDien" alt="@hero.Ten" fetchpriority="high" />
        </div>
    </section>
}
else
{
    <section class="hero">
        <div>
            <p class="hero-eyebrow">TechZone</p>
            <h1>Công nghệ chính hãng, giá thật mỗi ngày</h1>
            <p class="lead">Sản phẩm nổi bật hiện chưa có trong cửa hàng — xem toàn bộ danh mục bên dưới.</p>
            <div class="hero-actions">
                <a class="btn btn-secondary" asp-controller="Products" asp-action="Index">Xem tất cả sản phẩm</a>
            </div>
        </div>
    </section>
}

@* Banner khuyen mai do Admin quan ly (nhom D) — partial tu an khi khong co. *@
@if (ViewBag.Banners is List<Banner> banners && banners.Any())
{
    <partial name="_Banners" model="banners" />
}

@* Dải số liệu thật — đếm từ DB ở controller, không bịa con số xã hội chứng minh. *@
<section class="proof-strip reveal" aria-label="Số liệu cửa hàng">
    <div class="proof-item"><b data-count="@ViewBag.TongSanPham">@ViewBag.TongSanPham</b><span>sản phẩm chính hãng</span></div>
    <div class="proof-item"><b data-count="@ViewBag.TongHang">@ViewBag.TongHang</b><span>hãng công nghệ</span></div>
    <div class="proof-item"><b data-count="@ViewBag.TongDanhMuc">@ViewBag.TongDanhMuc</b><span>danh mục</span></div>
    <div class="proof-item"><b data-count="24" data-suffix=" tháng">24 tháng</b><span>bảo hành mọi sản phẩm</span></div>
</section>

@if (flashSale.Any() && ketThuc.HasValue)
{
    <section class="section flash-sale reveal" aria-label="Flash Sale">
        <div class="section-head">
            <h2>Flash Sale</h2>
            <span class="text-muted">Kết thúc lúc @ketThuc.Value.ToString("HH:mm") hôm nay</span>
        </div>
        <div class="flash-countdown" id="flash-countdown" data-ket-thuc="@ketThuc.Value.ToString("o")">
            <span><b id="cd-gio">--</b><small>giờ</small></span>
            <span><b id="cd-phut">--</b><small>phút</small></span>
            <span><b id="cd-giay">--</b><small>giây</small></span>
        </div>
        <div class="product-grid flash-grid">
            @foreach (var f in flashSale)
            {
                <article class="product-card">
                    <a asp-controller="Products" asp-action="Details" asp-route-id="@f.ProductId" class="product-image">
                        <img src="@f.Product.AnhDaiDien" alt="@f.Product.Ten" loading="lazy" />
                        <span class="badge-giam">Flash Sale</span>
                    </a>
                    <div class="product-info">
                        <h3><a asp-controller="Products" asp-action="Details" asp-route-id="@f.ProductId">@f.Product.Ten</a></h3>
                        @if (f.Product.SpecsNgan.Length > 0)
                        {
                            <p class="product-specs">@string.Join(" • ", f.Product.SpecsNgan)</p>
                        }
                        @* M4-3: nhu _ProductCard — TB tu review da duyet
                           (f.Product.Reviews da loc IsApproved o controller),
                           0 review -> "Chua co danh gia". *@
                        @{
                            var soDGFlash = f.Product.Reviews.Count;
                            var tbFlash = soDGFlash > 0 ? Math.Round(f.Product.Reviews.Average(r => r.Sao), 1) : 0;
                        }
                        <p class="product-meta">@(soDGFlash > 0 ? $"★ {tbFlash:0.0} ({soDGFlash} đánh giá)" : "Chưa có đánh giá") · Đã bán @f.Product.LuotBan</p>
                        <p class="product-price">
                            <strong>@f.GiaSale.ToString("N0")đ</strong>
                            <s>@f.Product.Gia.ToString("N0")đ</s>
                        </p>
                        <p class="product-meta">Đã bán @f.DaBan / @f.GioiHanSL • <span class="stock-left">Còn @(f.GioiHanSL - f.DaBan)</span></p>
                        <form asp-controller="Cart" asp-action="Add" method="post">
                            <input type="hidden" name="productId" value="@f.ProductId" />
                            <input type="hidden" name="soLuong" value="1" />
                            <button type="submit" class="btn btn-primary btn-block">Thêm vào giỏ</button>
                        </form>
                    </div>
                </article>
            }
        </div>
    </section>
}
else
{
    @* Phase 5 — empty state: hien thong bao thay vi an han muc (khach
       quen cho co Flash Sale se biet quay lai sau, khong tuong trang loi). *@
    <section class="section flash-sale reveal" aria-label="Flash Sale">
        <div class="section-head">
            <h2>Flash Sale</h2>
        </div>
        <p class="empty-state">Hiện chưa có Flash Sale đang chạy — quay lại sau để săn giá tốt nhé.</p>
    </section>
}

@* Flash Sale theo khung gio (nhom B) — partial tu doc ViewBag.Slots. *@
<partial name="_FlashSaleSlots" />

<section class="section reveal">
    <div class="section-head">
        <h2>Danh mục</h2>
    </div>
    @if (danhMuc.Any())
    {
        <div class="chip-row">
            @foreach (var c in danhMuc)
            {
                @* Phase 5 — chip co chu cai dau lam "icon" (Category khong
                   co truong icon/anh trong DB, khong bia anh). *@
                <a class="chip" asp-controller="Products" asp-action="Index" asp-route-CategoryId="@c.Id"><span class="chip-icon" aria-hidden="true">@c.Ten[0]</span>@c.Ten <span class="chip-count">@c.Products.Count sản phẩm</span></a>
            }
        </div>
    }
    else
    {
        <p class="empty-state">Chưa có danh mục nào — sản phẩm sẽ hiện ở đây khi cửa hàng thêm danh mục mới.</p>
    }
</section>

<section class="section reveal">
    <div class="section-head">
        <h2>Sản phẩm nổi bật</h2>
        <a asp-controller="Products" asp-action="Index">Xem tất cả sản phẩm</a>
    </div>
    @if (noiBat.Any())
    {
        <div class="product-grid">
            @foreach (var p in noiBat)
            {
                <partial name="_ProductCard" model="p" />
            }
        </div>
    }
    else
    {
        <p class="empty-state">Chưa có sản phẩm nổi bật — xem <a asp-controller="Products" asp-action="Index">tất cả sản phẩm</a>.</p>
    }
</section>

@* Bán chạy: danh sách xếp hạng thay vì lưới thẻ thứ hai giống hệt lưới trên. *@
<section class="section reveal">
    <div class="section-head">
        <h2>Bán chạy nhất</h2>
        <a asp-controller="Products" asp-action="Index" asp-route-SapXep="ban-chay">Xem theo lượt bán</a>
    </div>
    @if (banChay.Any())
    {
        <ol class="rank-list">
            @foreach (var p in banChay.Take(5).Select((sp, i) => new { sp, hang = i + 1 }))
            {
            <li class="rank-row">
                <span class="rank-num" aria-label="Hạng @p.hang">@p.hang</span>
                <a asp-controller="Products" asp-action="Details" asp-route-id="@p.sp.Id" class="rank-thumb">
                    <img src="@p.sp.AnhDaiDien" alt="@p.sp.Ten" loading="lazy" />
                </a>
                <div class="rank-info">
                    <h3><a asp-controller="Products" asp-action="Details" asp-route-id="@p.sp.Id">@p.sp.Ten</a></h3>
                    @if (p.sp.SpecsNgan.Length > 0)
                    {
                        <p class="product-specs">@string.Join(" • ", p.sp.SpecsNgan)</p>
                    }
                    @* M4-3: nhu _ProductCard — TB tu review da duyet
                       (p.sp.Reviews da loc IsApproved o controller),
                       0 review -> "Chua co danh gia". *@
                    @{
                        var soDGRank = p.sp.Reviews.Count;
                        var tbRank = soDGRank > 0 ? Math.Round(p.sp.Reviews.Average(r => r.Sao), 1) : 0;
                    }
                    <p class="product-meta">@(soDGRank > 0 ? $"{tbRank:0.0} sao ({soDGRank} đánh giá)" : "Chưa có đánh giá") • Đã bán @p.sp.LuotBan</p>
                </div>
                <p class="rank-price"><strong>@p.sp.GiaBan.ToString("N0")đ</strong></p>
            </li>
            }
        </ol>
    }
    else
    {
        <p class="empty-state">Chưa có dữ liệu bán chạy — bảng xếp hạng sẽ hiện khi cửa hàng có đơn hàng.</p>
    }
</section>

@* Đã xem gần đây (nhóm A) — partial tự ẩn khi không có gì. *@
@if (ViewBag.RecentlyViewed is List<Product> daXem && daXem.Any())
{
    <partial name="_RecentlyViewed" model="daXem" />
}

@* Voucher that tu DB — Phase 5: doc tu bang Vouchers (HomeController:
   ViewBag.VoucherNoiBat); khong con voucher hieu luc thi an han band
   (khong hien ma het han/het luot de khach ap dung that bai). *@
@if (ViewBag.VoucherNoiBat is Voucher voucherNoiBat)
{
    var moTaVoucher = voucherNoiBat.FreeShip
        ? $"Miễn phí vận chuyển cho đơn từ {voucherNoiBat.DieuKien:N0}đ."
        : voucherNoiBat.LoaiGiam == "PhanTram"
            ? $"Giảm {voucherNoiBat.GiaTri:N0}%{(voucherNoiBat.DieuKien > 0 ? $" cho đơn từ {voucherNoiBat.DieuKien:N0}đ" : "")}."
            : $"Giảm {voucherNoiBat.GiaTri:N0}đ{(voucherNoiBat.DieuKien > 0 ? $" cho đơn từ {voucherNoiBat.DieuKien:N0}đ" : "")}.";
    <section class="voucher-band reveal">
        <div>
            <h2>Mã @voucherNoiBat.Ma</h2>
            <p>@moTaVoucher Hết hạn @voucherNoiBat.NgayHetHan.ToString("dd/MM/yyyy"). Còn @(voucherNoiBat.SoLuong - voucherNoiBat.DaDung) lượt.</p>
        </div>
        <a class="btn btn-light" asp-controller="Products" asp-action="Index">Mua sắm ngay</a>
    </section>
}

@section Scripts {
    <script>
        // Dem nguoc Flash Sale (chi chay tren trinh duyet, khong anh huong gia tren server).
        (function () {
            var el = document.getElementById('flash-countdown');
            if (!el) return;
            var ketThuc = new Date(el.dataset.ketThuc);
            function tick() {
                var ms = ketThuc - new Date();
                if (ms <= 0) { el.textContent = 'Đã kết thúc'; return; }
                var s = Math.floor(ms / 1000);
                var cdGio = document.getElementById('cd-gio'), cdPhut = document.getElementById('cd-phut'), cdGiay = document.getElementById('cd-giay');
                if (!cdGio || !cdPhut || !cdGiay) return;
                cdGio.textContent = String(Math.floor(s / 3600)).padStart(2, '0');
                cdPhut.textContent = String(Math.floor(s % 3600 / 60)).padStart(2, '0');
                cdGiay.textContent = String(s % 60).padStart(2, '0');
            }
            tick(); setInterval(tick, 1000);
        })();

        // Hieu ung hien khi cuon toi + dem so tang dan (bo qua neu giam chuyen dong).
        (function () {
            try {
            var giamChuyenDong = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
            var khoi = document.querySelectorAll('.reveal');
            if (!('IntersectionObserver' in window) || giamChuyenDong) {
                khoi.forEach(function (el) { el.classList.add('is-visible'); });
            } else {
                var quanSat = new IntersectionObserver(function (entries) {
                    entries.forEach(function (entry) {
                        if (entry.isIntersecting) {
                            entry.target.classList.add('is-visible');
                            quanSat.unobserve(entry.target);
                        }
                    });
                }, { threshold: 0.12 });
                khoi.forEach(function (el) { quanSat.observe(el); });
            }

            // Dem so: chay 1 lan khi dai so lieu hien ra.
            var soLieu = document.querySelectorAll('.proof-item b[data-count]');
            function demSo(el) {
                var dich = parseInt(el.dataset.count, 10);
                if (isNaN(dich)) return;
                var hauTo = el.dataset.suffix || '';
                if (giamChuyenDong) { el.textContent = dich + hauTo; return; }
                var batDau = performance.now(), thoiGian = 900;
                function buoc(now) {
                    var tienDo = Math.min((now - batDau) / thoiGian, 1);
                    var giaTri = Math.round(dich * (1 - Math.pow(1 - tienDo, 3)));
                    el.textContent = giaTri + hauTo;
                    if (tienDo < 1) requestAnimationFrame(buoc);
                }
                requestAnimationFrame(buoc);
            }
            if (!('IntersectionObserver' in window) || giamChuyenDong) {
                soLieu.forEach(demSo);
            } else {
                var quanSatSo = new IntersectionObserver(function (entries) {
                    entries.forEach(function (entry) {
                        if (entry.isIntersecting) {
                            demSo(entry.target);
                            quanSatSo.unobserve(entry.target);
                        }
                    });
                }, { threshold: 0.4 });
                soLieu.forEach(function (el) { quanSatSo.observe(el); });
            }
            } catch (e) {
                document.querySelectorAll('.reveal').forEach(function (el) { el.classList.add('is-visible'); });
            }
        })();
    </script>
}
