@using TechZone.Models
@using Microsoft.AspNetCore.Mvc.ViewFeatures
@using System.Globalization
@{
    ViewData["Title"] = "Trang chủ";
    var flashSale = (List<FlashSale>)ViewBag.FlashSale;
    var noiBat = (List<Product>)ViewBag.NoiBat;
    var banChay = (List<Product>)ViewBag.BanChay;
    var danhMuc = (List<Category>)ViewBag.DanhMuc;
    var ketThuc = (DateTime?)ViewBag.FlashSaleKetThuc;
    var hero = ViewBag.Hero as Product;
    var heroSoDG = (int?)ViewBag.HeroSoDanhGia ?? 0;
    var heroTB = (double?)ViewBag.HeroDiemTB ?? 0;
    var giaHieuDung = (Dictionary<int, decimal>)ViewBag.GiaHieuDung;
    ViewData["ProductCardPrices"] = giaHieuDung;
    var candidates = noiBat.Concat(banChay).Concat(flashSale.Select(f => f.Product))
        .Where(p => p.TonKho > 0).DistinctBy(p => p.Id).OrderByDescending(p => p.LuotBan).ThenBy(p => p.Id).ToList();
    var drawings = hero is null ? candidates : candidates.Prepend(hero).DistinctBy(p => p.Id).ToList();
}
<section class="blueprint home-blueprint" aria-labelledby="need-title">
    <h1 id="need-title">Xem rõ thông số trước khi chọn</h1>
    <form id="need-finder" class="need-finder" asp-controller="Products" asp-action="Index" method="get" asp-antiforgery="false">
        <fieldset>
            <legend>Nhu cầu</legend>
            <div class="choice-row">
                @foreach (var need in ProductNeed.All)
                {
                    <label class="chip choice-chip">
                        <input type="radio" name="NhuCau" value="@need.Key" required />
                        <span>@need.Title.Split(" & ", 2)[0]</span>
                    </label>
                }
            </div>
        </fieldset>
        <fieldset>
            <legend>Ngân sách tối đa</legend>
            <div class="choice-row">
                @foreach (var budget in new[] { ("", "Không giới hạn"), ("2000000", "2 triệu"), ("15000000", "15 triệu"), ("25000000", "25 triệu") })
                {
                    <label class="chip choice-chip">
                        <input type="radio" name="GiaDen" value="@budget.Item1" checked="@(budget.Item1 == "")" />
                        <span>@budget.Item2</span>
                    </label>
                }
            </div>
        </fieldset>
        <button type="submit" class="btn btn-primary">Xem sản phẩm phù hợp</button>
    </form>
    <div class="home-suggestions" data-suggestions aria-live="polite"></div>
    @foreach (var p in candidates)
    {
        var slug = danhMuc.FirstOrDefault(c => c.Id == p.CategoryId)?.Slug;
        var keys = ProductNeed.All.Where(n => slug is not null && n.CategorySlugs.Contains(slug)).Select(n => n.Key);
        var price = giaHieuDung.GetValueOrDefault(p.Id, p.GiaBan);
        <template data-suggestion="@p.Id" data-needs="@string.Join(" ", keys)" data-price="@price.ToString(CultureInfo.InvariantCulture)">
            <a asp-controller="Products" asp-action="Details" asp-route-id="@p.Id" class="suggestion-product">
                <img src="@p.AnhDaiDien" alt="" width="42" height="42" loading="lazy" />
                <span>@p.Ten</span>
                <span class="price-tag"><strong class="price-amount">@price.ToString("N0")đ</strong></span>
            </a>
        </template>
    }
    <div data-home-drawings>
        @foreach (var p in drawings)
        {
            var slug = danhMuc.FirstOrDefault(c => c.Id == p.CategoryId)?.Slug;
            var spec = p.Specs;
            (string Label, string? Value, int X, int Y)[] fields = slug switch
            {
                "laptop" => [("Màn hình", spec?.ManHinh, 300, 92), ("Chip", spec?.Chip, 433, 177),
                    ("RAM", spec?.Ram, 282, 181), ("Pin", spec?.Pin, 390, 189)],
                "tablet" => [("Màn hình", spec?.ManHinh, 295, 90), ("Chip", spec?.Chip, 423, 103),
                    ("RAM", spec?.Ram, 293, 150), ("Pin", spec?.Pin, 424, 151)],
                "tai-nghe" => [("Pin", spec?.Pin, 279, 166),
                    ("Tính năng", spec?.ThongSoKhac?.Split(", ", StringSplitOptions.RemoveEmptyEntries).FirstOrDefault(), 446, 153)],
                "dien-thoai" => [("Camera", spec?.Camera, 360, 31), ("Màn hình", spec?.ManHinh, 389, 80),
                    ("Chip", spec?.Chip, 330, 141), ("Pin", spec?.Pin, 385, 177)],
                _ => []
            };
            var notes = fields.Select((field, index) => (field.Label, field.Value, field.X, field.Y, Position: index))
                .Where(field => !string.IsNullOrWhiteSpace(field.Value)).ToList();
            var shapes = slug switch
            {
                "laptop" => new[] { "M248 35H472Q484 35 484 47V167H236V47Q236 35 248 35Z", "M248 48H472V154H248Z", "M236 167H484L522 197Q522 205 512 205H208Q198 205 198 197Z", "M329 185H391L401 194H319Z" },
                "tai-nghe" => new[] { "M267 135V111a93 93 0 0 1 186 0v24h-13v-24a80 80 0 0 0-160 0v24Z", "M269 125h23q12 0 12 15v34q0 15-12 15h-23q-13 0-13-15v-34q0-15 13-15Z", "M428 125h23q13 0 13 15v34q0 15-13 15h-23q-12 0-12-15v-34q0-15 12-15Z" },
                "tablet" => new[] { "M249 38H471Q483 38 483 50V183Q483 195 471 195H249Q237 195 237 183V50Q237 38 249 38Z", "M250 52H470V181H250Z" },
                "dien-thoai" => new[] { "M322 12H398Q414 12 414 28V202Q414 218 398 218H322Q306 218 306 202V28Q306 12 322 12Z", "M323 20H397Q406 20 406 30V200Q406 210 397 210H323Q314 210 314 200V30Q314 20 323 20Z", "M350 27h20a4 4 0 0 1 0 8h-20a4 4 0 0 1 0-8Z" },
                _ => Array.Empty<string>()
            };
            var price = giaHieuDung.GetValueOrDefault(p.Id, p.GiaBan);
            <article class="hero-product" data-drawing="@p.Id" data-initial="@(p.Id == (hero?.Id ?? drawings[0].Id) ? "true" : null)" hidden="@(p.Id != (hero?.Id ?? drawings[0].Id))">
                <figure class="hero-figure">
                    @if (shapes.Length > 0)
                    {
                        <svg class="hero-drawing" viewBox="0 0 720 230" role="img" aria-label="Bản vẽ minh họa @p.Ten. @string.Join(". ", notes.Select(n => $"{n.Label}: {n.Value}"))">
                            @for (var i = 0; i < shapes.Length; i++)
                            {
                                <path d="@shapes[i]" class="drawing-fill" />
                                <path d="@shapes[i]" class="drawing-stroke" pathLength="1" style="--i:@i" />
                            }
                            @for (var i = 0; i < notes.Count; i++)
                            {
                                var note = notes[i];
                                var left = note.Position % 2 == 0;
                                var endX = left ? 0 : 720;
                                var bendX = left ? 170 : 550;
                                var endY = note.Position < 2 ? 58 : 172;
                                <g class="drawing-annotation" style="--i:@i">
                                    <path class="drawing-leader" d="@($"M{note.X} {note.Y} H{bendX} L{bendX + (left ? -24 : 24)} {endY} H{endX}")" pathLength="1" />
                                    <circle class="drawing-zone" cx="@note.X" cy="@note.Y" r="14" pathLength="1" />
                                    <circle class="drawing-zone drawing-center" cx="@note.X" cy="@note.Y" r="2.5" pathLength="1" />
                                </g>
                            }
                        </svg>
                        <figcaption>Bản vẽ minh họa</figcaption>
                    }
                    else
                    {
                        <img src="@p.AnhDaiDien" alt="@p.Ten" width="480" height="230" loading="@(p.Id == hero?.Id ? "eager" : "lazy")" />
                    }
                    @if (notes.Count > 0)
                    {
                        <dl class="hero-annotations">
                            @for (var i = 0; i < notes.Count; i++)
                            {
                                var note = notes[i];
                                <div class="drawing-note @(note.Position % 2 == 0 ? "drawing-note-start" : "drawing-note-end")"
                                     style="--i:@i;--note-row:@(note.Position / 2 + 1)">
                                    <dt>@note.Label</dt><dd>@note.Value</dd>
                                </div>
                            }
                        </dl>
                    }
                </figure>
                <div class="hero-offer">
                    <div>
                        <h2>@p.Ten</h2>
                        @if (p.Id == hero?.Id && heroSoDG > 0)
                        {
                            <p class="text-muted">@heroTB.ToString("0.0", CultureInfo.GetCultureInfo("vi-VN"))/5 sao (@heroSoDG đánh giá)</p>
                        }
                    </div>
                    <div class="price-tag drawing-price">
                        <strong class="price-amount">@price.ToString("N0")đ</strong>
                        @if (price < p.Gia) { <s>@p.Gia.ToString("N0")đ</s> }
                    </div>
                    <a class="btn btn-secondary" asp-controller="Products" asp-action="Details" asp-route-id="@p.Id" data-hero-link>Xem @p.Ten</a>
                </div>
            </article>
        }
    </div>
</section>

<p class="home-promise">Khám phá @ViewBag.TongSanPham sản phẩm chính hãng từ @ViewBag.TongHang hãng trong @ViewBag.TongDanhMuc danh mục, bảo hành 24 tháng và trả góp 0% (giả lập).</p>

<section class="section home-categories" aria-labelledby="category-title">
    <div class="section-head"><h2 id="category-title">Danh mục</h2><a asp-controller="Products" asp-action="Index">Xem tất cả ngành hàng</a></div>
    <ul class="category-rail">
        @foreach (var c in danhMuc)
        {
            var representative = c.Products.OrderByDescending(p => p.LuotBan).ThenBy(p => p.Id).FirstOrDefault();
            <li>
                <a asp-controller="Products" asp-action="Index" asp-route-CategoryId="@c.Id">
                    <span class="category-image">
                        @if (representative is not null) { <img src="@representative.AnhDaiDien" alt="" width="96" height="72" loading="lazy" /> }
                    </span>
                    <span>@c.Ten</span>
                </a>
            </li>
        }
    </ul>
</section>

<section class="section flash-sale" id="flash-sale" aria-labelledby="flash-sale-title">
    <div class="flash-layout">
        <div>
            <h2 id="flash-sale-title">Flash Sale</h2>
            @if (flashSale.Any() && ketThuc.HasValue)
            {
                <p>Ưu đãi gần nhất hết hạn lúc @ketThuc.Value.ToString("HH:mm") ngày @ketThuc.Value.ToString("dd/MM").</p>
                <div class="flash-countdown" id="flash-countdown" data-ket-thuc="@DateTime.SpecifyKind(ketThuc.Value, DateTimeKind.Local).ToString("o")" data-countdown-ended="Đã đến giờ kết thúc ưu đãi gần nhất">
                    <span><b id="cd-gio">--</b><small>giờ</small></span>
                    <span><b id="cd-phut">--</b><small>phút</small></span>
                    <span><b id="cd-giay">--</b><small>giây</small></span>
                </div>
            }
        </div>
        @if (flashSale.Any() && ketThuc.HasValue)
        {
            <div class="product-grid flash-grid">
                @foreach (var f in flashSale)
                {
                    var remaining = Math.Min(f.Product.TonKho, f.GioiHanSL - f.DaBan);
                    var flashCard = new ViewDataDictionary(ViewData) { ["FlashRemaining"] = remaining };
                    <div class="flash-item">
                        <partial name="_ProductCard" model="f.Product" view-data="flashCard" />
                        @if (f.GioiHanSL > 0)
                        {
                            <div class="flash-meter" role="img" aria-label="Còn @remaining trên @f.GioiHanSL suất">
                                <span data-flash-meter style="--remaining:@((remaining / (double)f.GioiHanSL).ToString(CultureInfo.InvariantCulture))"></span>
                            </div>
                        }
                    </div>
                }
            </div>
        }
    </div>
    <partial name="_FlashSaleSlots" />
</section>

@if (ViewBag.Banners is List<Banner> { Count: > 0 } banners)
{
    <section class="section market-promos" id="khuyen-mai">
        <div class="section-head"><h2>Ưu đãi</h2><a href="#flash-sale">Xem khung giờ Flash Sale</a></div>
        <partial name="_Banners" model="banners" />
    </section>
}

<section class="section market-shelf">
    <div class="section-head">
        <h2>Sản phẩm nổi bật</h2>
        <a asp-controller="Products" asp-action="Index">Xem tất cả sản phẩm</a>
    </div>
    @if (noiBat.Any())
    {
        <div class="product-grid featured-grid @(noiBat.Count > 1 ? "has-lead" : "")">
            @foreach (var p in noiBat) { <partial name="_ProductCard" model="p" /> }
        </div>
    }
    else
    {
        <p class="empty-state">Chưa có sản phẩm nổi bật. <a asp-controller="Products" asp-action="Index">Xem tất cả sản phẩm</a>.</p>
    }
</section>

<section class="section market-shelf">
    <div class="section-head">
        <h2>Bán chạy nhất</h2>
        <a asp-controller="Products" asp-action="Index" asp-route-SapXep="ban-chay">Xem theo lượt bán</a>
    </div>
    @if (banChay.Any())
    {
        <ol class="rank-list">
            @foreach (var p in banChay.Take(5).Select((sp, i) => new { sp, hang = i + 1 }))
            {
                var reviews = p.sp.Reviews.Where(r => r.IsApproved).ToList();
                <li class="rank-row">
                    <span class="rank-num" aria-label="Hạng @p.hang">@p.hang</span>
                    <a asp-controller="Products" asp-action="Details" asp-route-id="@p.sp.Id" class="rank-thumb"><img src="@p.sp.AnhDaiDien" alt="@p.sp.Ten" width="72" height="72" loading="lazy" /></a>
                    <div>
                        <h3><a asp-controller="Products" asp-action="Details" asp-route-id="@p.sp.Id">@p.sp.Ten</a></h3>
                        <p class="product-meta">Đã bán @p.sp.LuotBan</p>
                        <p class="product-meta">@(reviews.Count > 0 ? $"{reviews.Average(r => r.Sao):0.0} sao ({reviews.Count} đánh giá)" : "Chưa có đánh giá")</p>
                    </div>
                    <p class="rank-price price-tag"><strong class="price-amount">@giaHieuDung.GetValueOrDefault(p.sp.Id, p.sp.GiaBan).ToString("N0")đ</strong></p>
                </li>
            }
        </ol>
    }
    else
    {
        <p class="empty-state">Chưa có dữ liệu bán chạy.</p>
    }
</section>

@* Đã xem gần đây (nhóm A) — partial tự ẩn khi không có gì. *@
@if (ViewBag.RecentlyViewed is List<Product> daXem && daXem.Any())
{
    <partial name="_RecentlyViewed" model="daXem" />
}

@* Voucher that tu DB — Phase 5: doc tu bang Vouchers (HomeController:
   ViewBag.VoucherNoiBat); khong con voucher hieu luc thi an han band
   (khong hien ma het han/het luot de khach ap dung that bai). *@
@if (ViewBag.VoucherNoiBat is Voucher voucherNoiBat)
{
    var moTaVoucher = voucherNoiBat.FreeShip
        ? $"Miễn phí vận chuyển cho đơn từ {voucherNoiBat.DieuKien:N0}đ."
        : voucherNoiBat.LoaiGiam == "PhanTram"
            ? $"Giảm {voucherNoiBat.GiaTri:N0}%{(voucherNoiBat.DieuKien > 0 ? $" cho đơn từ {voucherNoiBat.DieuKien:N0}đ" : "")}."
            : $"Giảm {voucherNoiBat.GiaTri:N0}đ{(voucherNoiBat.DieuKien > 0 ? $" cho đơn từ {voucherNoiBat.DieuKien:N0}đ" : "")}.";
    <section class="voucher-band">
        <div>
            <h2>Mã @voucherNoiBat.Ma</h2>
            <p>@moTaVoucher Hết hạn @voucherNoiBat.NgayHetHan.ToString("dd/MM/yyyy"). Còn @(voucherNoiBat.SoLuong - voucherNoiBat.DaDung) lượt.</p>
        </div>
        <a class="btn btn-light" asp-controller="Products" asp-action="Index">Mua sắm ngay</a>
    </section>
}


@section Scripts {
    <script src="~/js/flash-sale-countdown.js" asp-append-version="true"></script>
    <script src="~/js/home-blueprint.js" asp-append-version="true"></script>
}

@section Styles {
    <link rel="stylesheet" href="~/css/product-cards.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
}
