@model List<TechZone.Models.Banner>

@if (Model.Any())
{
    <div class="banner-strip">
        @foreach (var banner in Model)
        {
            <article class="banner-item">
                <img src="@banner.AnhUrl" alt="" width="80" height="80" loading="lazy" />
                <div>
                    <strong>@banner.TieuDe</strong>
                    @if (!string.IsNullOrEmpty(banner.LinkUrl))
                    {
                        <a href="@banner.LinkUrl">Xem nội dung ưu đãi</a>
                    }
                </div>
            </article>
        }
    </div>
}
