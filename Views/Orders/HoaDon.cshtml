@model TechZone.Models.Order
@inject TechZone.Services.VatService Vat
@{
    ViewData["Title"] = $"Hóa đơn VAT — Đơn #{Model.Id}";
    // Thuế suất lấy từ lúc đặt hàng. Đơn cũ dùng danh mục và ngày đặt để tính lại.
    var bangVat = Vat.TinhVatDon(Model);
    var chiTiet = Model.ChiTiet.ToList();
}

<div class="invoice order-column">
    <header class="market-heading order-heading invoice-heading">
        <nav class="market-path" aria-label="Đường dẫn">
            <a asp-action="Details" asp-route-id="@Model.Id">Đơn #@Model.Id</a>
            <span aria-hidden="true">/</span><span aria-current="page">Hóa đơn VAT</span>
        </nav>
        <div class="section-head">
            <h1>Hóa đơn giá trị gia tăng</h1>
            <button type="button" class="btn hero-buy" onclick="window.print()">In hóa đơn</button>
        </div>
        <p>Đơn #@Model.Id · Ngày đặt @Model.NgayDat.ToString("dd/MM/yyyy HH:mm")</p>
    </header>

    <div class="invoice-note">
        <strong>Hóa đơn demo</strong>
        <p>Không có giá trị pháp lý. Chỉ dùng để đối chiếu số tiền trong đồ án.</p>
    </div>

    <section class="card tracking-card invoice-buyer">
        <h2>Thông tin người mua</h2>
        <dl>
            <div><dt>Tên công ty</dt><dd>@Model.VatTenCongTy</dd></div>
            <div><dt>Mã số thuế</dt><dd>@Model.VatMaSoThue</dd></div>
            <div><dt>Địa chỉ công ty</dt><dd>@Model.VatDiaChiCongTy</dd></div>
            <div><dt>Giao đến</dt><dd>@Model.DiaChiGiao</dd></div>
        </dl>
    </section>

    <section class="card tracking-card invoice-items" aria-labelledby="invoice-items-title">
        <h2 id="invoice-items-title">Sản phẩm và thuế</h2>
        <table class="table invoice-table" role="table" aria-labelledby="invoice-items-title">
            <thead role="rowgroup">
                <tr role="row">
                    <th scope="col" role="columnheader">Sản phẩm</th>
                    <th scope="col" role="columnheader">Phiên bản</th>
                    <th scope="col" role="columnheader">Đơn giá</th>
                    <th scope="col" role="columnheader">Số lượng</th>
                    <th scope="col" role="columnheader">Thành tiền</th>
                    <th scope="col" role="columnheader">Thuế suất</th>
                    <th scope="col" role="columnheader">Tiền thuế</th>
                </tr>
            </thead>
            <tbody role="rowgroup">
                @for (var i = 0; i < chiTiet.Count; i++)
                {
                    var d = chiTiet[i];
                    var dongVat = bangVat.Lines[i];
                    <tr role="row">
                        <td role="cell"><strong>@d.Product.Ten</strong></td>
                        <td role="cell"><span class="invoice-mobile-label" aria-hidden="true">Phiên bản</span><span>@(d.Variant?.TenBienThe ?? "—")</span></td>
                        <td role="cell">
                            <span class="invoice-mobile-label" aria-hidden="true">Đơn giá</span>
                            <span>
                                @d.DonGia.ToString("N0")đ
                                @if (!string.IsNullOrEmpty(d.TenKhuyenMai))
                                {
                                    <small class="invoice-promotion">@d.TenKhuyenMai · Giá gốc <s>@d.GiaGoc.ToString("N0")đ</s></small>
                                }
                            </span>
                        </td>
                        <td role="cell"><span class="invoice-mobile-label" aria-hidden="true">Số lượng</span><span>@d.SoLuong</span></td>
                        <td role="cell"><span class="invoice-mobile-label" aria-hidden="true">Thành tiền</span><strong class="price-amount">@d.ThanhTien.ToString("N0")đ</strong></td>
                        <td role="cell"><span class="invoice-mobile-label" aria-hidden="true">Thuế suất</span><span>@((dongVat.ThueSuat * 100).ToString("0.##"))%</span></td>
                        <td role="cell"><span class="invoice-mobile-label" aria-hidden="true">Tiền thuế</span><span>@dongVat.TienVat.ToString("N0")đ</span></td>
                    </tr>
                }
            </tbody>
        </table>
    </section>

    <section class="card market-receipt order-receipt invoice-totals">
        <h2>Phiếu tính tiền</h2>
        <partial name="_BangTienDon" model="Model" />
    </section>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/order-detail.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/invoice.css" asp-append-version="true" />
}
