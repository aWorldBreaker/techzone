@model TechZone.Models.NhapMaTraCuuViewModel
@{
    var loi = ViewBag.Loi as string;
    var maMoi = ViewBag.GuestTokenMoi as string;
    var vuaDat = ViewBag.OrderJustPlaced is true && !string.IsNullOrEmpty(maMoi);
    var hoaDon = Model.HanhDong == "HoaDon";
    ViewData["Title"] = vuaDat ? "Đặt hàng thành công" : hoaDon ? "Tra cứu hóa đơn" : "Tra cứu đơn hàng";
}

<header class="@(vuaDat ? "purchase-heading order-confirmed" : "market-heading order-heading")">
    <nav class="market-path" aria-label="Đường dẫn">
        <a asp-controller="Products" asp-action="Index">Ngành hàng</a><span aria-hidden="true">/</span>
        <span aria-current="page">Đơn #@Model.OrderId</span>
    </nav>
    @if (vuaDat)
    {
        <nav class="purchase-progress" aria-label="Tiến trình mua hàng">
            <ol><li>Giỏ hàng</li><li>Thanh toán</li><li><span aria-current="step">Xác nhận</span></li></ol>
        </nav>
    }
    <h1>@ViewData["Title"]</h1>
    <p>Đơn hàng #@Model.OrderId</p>
</header>

@if (!string.IsNullOrEmpty(loi))
{
    <p class="alert alert-error" role="alert">@loi</p>
}

<div class="lookup-layout">
    @if (vuaDat)
    {
        <section class="card market-receipt lookup-receipt" aria-labelledby="lookup-receipt-title">
            <h2 id="lookup-receipt-title">Phiếu tra cứu</h2>
            <p class="alert alert-info">Mã tra cứu đơn hàng của bạn <strong class="lookup-token">@maMoi</strong></p>
            <p>Lưu mã trước khi rời trang. Mã chỉ hiện một lần và dùng để xem đơn hoặc tra cứu bảo hành trong 30 ngày.</p>
            <a asp-controller="Products" asp-action="Index" class="btn btn-secondary">Tiếp tục mua sắm</a>
        </section>
    }
    <form asp-action="@Model.HanhDong" method="post" class="warranty-lookup lookup-form">
        <h2>@(hoaDon ? "Xác nhận để xem hóa đơn" : "Xem chi tiết đơn")</h2>
        <input type="hidden" name="id" value="@Model.OrderId" />
        <div class="form-group">
            <label for="token">Mã tra cứu</label>
            <input type="text" name="token" id="token" class="form-control" aria-describedby="token-help"
                   autocomplete="off" autocapitalize="off" spellcheck="false" required />
            <small id="token-help">Mã có 32 ký tự. Nhập sai 5 lần liên tiếp sẽ khóa tra cứu đơn này 15 phút.</small>
        </div>
        <button type="submit" class="btn btn-primary">@(hoaDon ? "Xem hóa đơn" : "Xem đơn")</button>
        <p class="text-muted">Mất mã? Liên hệ TechZone để đối chiếu họ tên và số điện thoại đặt hàng.</p>
    </form>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/purchase.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/order-detail.css" asp-append-version="true" />
}
