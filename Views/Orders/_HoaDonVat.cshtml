@model TechZone.Models.CheckoutViewModel
@* Form xuat hoa don VAT (nhom C): hien/ẩn theo checkbox, JS o Checkout.cshtml. *@

<div class="form-group">
    <label><input type="checkbox" asp-for="XuatHoaDon" /> Xuất hóa đơn VAT cho công ty</label>
    <p class="text-muted">Bắt buộc nhập đủ tên công ty, mã số thuế và địa chỉ khi tick ô này. Hóa đơn trong app là <strong>hóa đơn demo</strong>, chưa phải hóa đơn điện tử hợp pháp.</p>
</div>
<div id="vat-fields" hidden>
    <div class="form-group">
        <label asp-for="TenCongTy">Tên công ty</label>
        <input asp-for="TenCongTy" class="form-control" />
        <span asp-validation-for="TenCongTy" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="MaSoThue">Mã số thuế</label>
        <input asp-for="MaSoThue" class="form-control" />
        <span asp-validation-for="MaSoThue" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="DiaChiCongTy">Địa chỉ công ty</label>
        <textarea asp-for="DiaChiCongTy" class="form-control" rows="2"></textarea>
        <span asp-validation-for="DiaChiCongTy" class="text-danger"></span>
    </div>
</div>
