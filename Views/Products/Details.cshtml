@model TechZone.Models.Product
@{
    ViewData["Title"] = Model.Ten;
    var tuongTu = (List<TechZone.Models.Product>)ViewBag.TuongTu;
    var combo = (TechZone.Models.Product?)ViewBag.Combo;
    var recentlyViewed = (List<TechZone.Models.Product>)ViewBag.RecentlyViewed;
    var cauHoi = (List<TechZone.Models.ProductQuestion>)ViewBag.CauHoi;
    var daYeuThich = ViewBag.DaYeuThich is bool b && b;
    // SALE-01: gia hien thi do controller tinh qua PriceCalculationService
    // (cung ham nhu Cart/Checkout) — view khong tu tinh flash?.GiaSale
    // ?? GiaBan nua. Fallback GiaBan chi de view khong vo neu action
    // cu (vd test render truc tiep) khong set ViewBag.
    var giaHienThi = ViewBag.GiaHienThi as decimal? ?? Model.GiaBan;
    var giaGoc = ViewBag.GiaGoc as decimal? ?? Model.GiaBan;
    var tenKhuyenMai = ViewBag.TenKhuyenMai as string;
    var flash = ViewBag.FlashSaleApDung as TechZone.Models.FlashSale;
    var comboGiaChinh = ViewBag.ComboGiaChinh as decimal? ?? Model.GiaBan;
    var comboGiaKem = ViewBag.ComboGiaKem as decimal? ?? combo?.GiaBan ?? 0m;
    var comboTongBo = ViewBag.ComboTongBo as decimal? ?? (Model.GiaBan + (combo?.GiaBan ?? 0m));
    var comboGiamGia = ViewBag.ComboGiamGia as decimal? ?? 0m;
    var model3d = ViewBag.Model3d as TechZone.Models.Product3dModel;
}

<nav aria-label="Breadcrumb">
    <a asp-controller="Home" asp-action="Index">Trang chủ</a> &gt;
    <a asp-controller="Products" asp-action="Index" asp-route-CategoryId="@Model.CategoryId">@Model.Category.Ten</a> &gt;
    @Model.Ten
</nav>

<div class="detail-layout mt">
    <div class="detail-image">
        @* Sprint 5 — viewer 3D dung chung (map Product3dModels): chi SP co model
           moi render khoi nay. Model la minh hoa generic, khong phai thiet ke
           chinh xac cua hang. GLB chi tai khi bam Xem 3D (xem product-3d.js). *@
        @if (model3d is not null)
        {
            <div class="detail-3d" id="product-3d" data-model-url="@model3d.ModelUrl">
                <img id="product-image" src="@Model.AnhDaiDien" alt="@Model.Ten" />
                <model-viewer id="product-viewer" class="product-viewer" hidden
                    poster="@Model.AnhDaiDien"
                    alt="Mô hình 3D minh họa — @Model.Ten"
                    camera-controls touch-action="pan-y"
                    camera-orbit="@model3d.CameraOrbit" field-of-view="45deg"
                    min-camera-orbit="auto auto 50%" max-camera-orbit="auto auto 200%"
                    orientation="@model3d.Orientation"
                    environment-image="neutral" auto-rotate>
                </model-viewer>
                <p class="alert alert-error" id="viewer-error" hidden>Không tải được mô hình 3D — đang hiển thị ảnh sản phẩm.</p>
                <div class="viewer-toolbar" role="group" aria-label="Điều khiển xem 3D">
                    <button type="button" class="btn btn-secondary btn-sm" id="btn-3d-show">Xem 3D</button>
                    <button type="button" class="btn btn-secondary btn-sm" id="btn-3d-hide" hidden>Xem ảnh</button>
                    <button type="button" class="btn btn-secondary btn-sm" id="btn-3d-reset" hidden>Đặt lại góc nhìn</button>
                    <button type="button" class="btn btn-secondary btn-sm" id="btn-3d-rotate" hidden aria-pressed="true">Tự xoay: Bật</button>
                    <button type="button" class="btn btn-secondary btn-sm" id="btn-3d-fullscreen" hidden>Toàn màn hình</button>
                </div>
                <p class="viewer-note text-muted">Mô hình 3D minh họa (generic), chưa phải thiết kế chính xác của hãng. Kéo để xoay, cuộn/chụm để zoom.</p>
            </div>
        }
        else
        {
            <img src="@Model.AnhDaiDien" alt="@Model.Ten" />
        }
        @if (Model.Images.Count > 1)
        {
            <div class="chip-row">
                @foreach (var img in Model.Images)
                {
                    <img src="@img.Url" alt="@Model.Ten" class="thumb-sm" />
                }
            </div>
        }
    </div>

    <div>
        <h1>@Model.Ten</h1>
        @* M4-1: diem sao hien thi TINH TU danh gia da duyet dang co (Model.Reviews
           da loc IsApproved o controller), khong dung Model.DanhGiaTB (gia tri
           seed cu, lech khoi TB that: VD Id 1 seed 4.8 trong khi 2 review 5+4
           TB that 4.5; SP 0 review van hien "4.8 sao (0 danh gia)").
           0 review -> "Chua co danh gia", khong hien so sao. Chi hien thi,
           khong doi logic review/DanhGiaTB. *@
        @{
            var soDanhGia = Model.Reviews.Count;
            var diemTB = soDanhGia > 0 ? Math.Round(Model.Reviews.Average(r => r.Sao), 1) : 0;
        }
        <p>@(soDanhGia > 0 ? $"{diemTB:0.0} sao ({soDanhGia} đánh giá)" : "Chưa có đánh giá") • Đã bán @Model.LuotBan • @(Model.TonKho > 0 ? $"Còn {Model.TonKho} trong kho" : "Hết hàng")</p>
        <p>
            <span class="price-big">@giaHienThi.ToString("N0")đ</span>
            @if (giaHienThi < giaGoc)
            {
                <s class="price-old">@giaGoc.ToString("N0")đ</s>
            }
            else if (Model.GiaKhuyenMai.HasValue)
            {
                <s class="price-old">@Model.Gia.ToString("N0")đ</s>
            }
            @if (flash is not null)
            {
                <span class="badge">Flash Sale — kết thúc @flash.KetThuc.ToString("HH:mm") hôm nay</span>
            }
            else if (!string.IsNullOrEmpty(tenKhuyenMai))
            {
                <span class="badge">@tenKhuyenMai</span>
            }
        </p>
        <p class="text-muted">Trả góp 0% • Bảo hành 24 tháng • Giao nhanh 2h • Đổi trả 30 ngày</p>
        <partial name="_InstallmentBadge" model="giaHienThi" />

        @if (Model.Variants.Any())
        {
            <form asp-controller="Cart" asp-action="Add" method="post">
                <input type="hidden" name="productId" value="@Model.Id" />
                <div class="form-group">
                    <label for="variantId">Phiên bản</label>
                    <select id="variantId" name="variantId" class="form-control">
                        @foreach (var v in Model.Variants)
                        {
                            <option value="@v.Id">@v.TenBienThe@(v.GiaThem > 0 ? $" (+{v.GiaThem:N0}đ)" : "")</option>
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label for="soLuong">Số lượng</label>
                    <input id="soLuong" name="soLuong" type="number" min="1" max="@Model.TonKho" value="1" class="form-control input-narrow" />
                </div>
                <button type="submit" class="btn btn-primary" @(Model.TonKho == 0 ? "disabled" : "")>Thêm vào giỏ</button>
            </form>
        }
        else
        {
            <form asp-controller="Cart" asp-action="Add" method="post">
                <input type="hidden" name="productId" value="@Model.Id" />
                <input type="hidden" name="soLuong" value="1" />
                <button type="submit" class="btn btn-primary" @(Model.TonKho == 0 ? "disabled" : "")>Thêm vào giỏ</button>
            </form>
        }
        <form asp-controller="Compare" asp-action="Add" method="post" class="mt">
            <input type="hidden" name="productId" value="@Model.Id" />
            <button type="submit" class="btn btn-secondary">＋ So sánh</button>
        </form>
        @if (daYeuThich)
        {
            <form asp-controller="Wishlist" asp-action="Remove" method="post" class="mt wishlist-form">
                <input type="hidden" name="productId" value="@Model.Id" />
                <button type="submit" class="btn btn-secondary wishlist-btn wishlist-btn-active">♥ Đã yêu thích</button>
            </form>
        }
        else
        {
            <form asp-controller="Wishlist" asp-action="Add" method="post" class="mt wishlist-form">
                <input type="hidden" name="productId" value="@Model.Id" />
                <button type="submit" class="btn btn-secondary wishlist-btn">♡ Yêu thích</button>
            </form>
        }
    </div>
</div>

@if (combo is not null)
{
    <section class="section combo-block">
        <h2>Mua kèm giá tốt</h2>
        <div class="combo-items">
            <div class="combo-item">
                <img src="@Model.AnhDaiDien" alt="@Model.Ten" />
                <p>@Model.Ten</p>
                <p><strong>@comboGiaChinh.ToString("N0")đ</strong></p>
            </div>
            <span class="combo-plus" aria-hidden="true">＋</span>
            <div class="combo-item">
                <img src="@combo.AnhDaiDien" alt="@combo.Ten" />
                <p><a asp-controller="Products" asp-action="Details" asp-route-id="@combo.Id">@combo.Ten</a></p>
                <p><strong>@comboGiaKem.ToString("N0")đ</strong></p>
            </div>
        </div>
        <p class="combo-total">Tổng combo: <strong>@comboTongBo.ToString("N0")đ</strong>
        @if (ViewBag.ComboId is not null && ViewBag.ComboGiamGia is decimal giamCombo && giamCombo > 0)
        {
            <span>— Giảm combo <strong>@giamCombo.ToString("N0")đ</strong>, chỉ còn <strong>@((comboTongBo - giamCombo).ToString("N0"))đ</strong></span>
        }
        </p>
        <form asp-controller="Cart" asp-action="AddCombo" method="post">
            <input type="hidden" name="productId" value="@Model.Id" />
            <input type="hidden" name="comboProductId" value="@combo.Id" />
            @if (ViewBag.ComboId is not null)
            {
                <input type="hidden" name="comboId" value="@ViewBag.ComboId" />
            }
            <input type="hidden" name="soLuong" value="1" />
            <button type="submit" class="btn btn-primary">Mua combo — @((comboTongBo - comboGiamGia).ToString("N0"))đ</button>
        </form>
    </section>
}

<section class="section">
    <h2>Thông số kỹ thuật</h2>
    @if (Model.Specs is not null)
    {
        <table class="spec-table">
            <tbody>
                @if (!string.IsNullOrWhiteSpace(Model.Specs.Chip)) { <tr><th>Chip</th><td>@Model.Specs.Chip</td></tr> }
                @if (!string.IsNullOrWhiteSpace(Model.Specs.Ram)) { <tr><th>RAM</th><td>@Model.Specs.Ram</td></tr> }
                @if (!string.IsNullOrWhiteSpace(Model.Specs.Rom)) { <tr><th>Bộ nhớ</th><td>@Model.Specs.Rom</td></tr> }
                @if (!string.IsNullOrWhiteSpace(Model.Specs.Pin)) { <tr><th>Pin</th><td>@Model.Specs.Pin</td></tr> }
                @if (!string.IsNullOrWhiteSpace(Model.Specs.ManHinh)) { <tr><th>Màn hình</th><td>@Model.Specs.ManHinh</td></tr> }
                @if (!string.IsNullOrWhiteSpace(Model.Specs.Camera)) { <tr><th>Camera</th><td>@Model.Specs.Camera</td></tr> }
                @if (!string.IsNullOrWhiteSpace(Model.Specs.CardDoHoa)) { <tr><th>Card đồ họa</th><td>@Model.Specs.CardDoHoa</td></tr> }
                @if (!string.IsNullOrWhiteSpace(Model.Specs.ThongSoKhac)) { <tr><th>Khác</th><td>@Model.Specs.ThongSoKhac</td></tr> }
            </tbody>
        </table>
    }
    else
    {
        <p class="text-muted">Sản phẩm này chưa có bảng thông số.</p>
    }
    @if (!string.IsNullOrWhiteSpace(Model.MoTa))
    {
        <h2 class="mt">Mô tả</h2>
        <p>@Model.MoTa</p>
    }
</section>

<section class="section">
    <h2>Đánh giá (@Model.Reviews.Count)</h2>
    @if (!Model.Reviews.Any())
    {
        <p class="text-muted">Chưa có đánh giá nào. Hãy là người đầu tiên đánh giá sản phẩm này.</p>
    }
    @foreach (var r in Model.Reviews.OrderByDescending(r => r.NgayDanhGia))
    {
        <div class="review-item">
            <strong>@r.Sao sao</strong> — @r.User?.HoTen
            <span class="text-muted">@r.NgayDanhGia.ToString("dd/MM/yyyy")</span>
            @if (!string.IsNullOrWhiteSpace(r.NoiDung)) { <p>@r.NoiDung</p> }
            @if (!string.IsNullOrWhiteSpace(r.ImageUrl)) { <img src="@r.ImageUrl" alt="Ảnh đánh giá của @r.User?.HoTen" class="review-image" /> }
        </div>
    }
    @* M4-2: form danh gia chi hien khi da login (POST DanhGia co [Authorize],
       khach chua login bam Gui se bi day sang Login, mat noi dung da go).
       Anon thay link dang nhap, giong khoi Hoi & dap ben duoi. *@
    @if (User.Identity?.IsAuthenticated == true)
    {
    <form asp-action="DanhGia" method="post" enctype="multipart/form-data" class="mt">
        <input type="hidden" name="productId" value="@Model.Id" />
        <div class="form-group">
            <label for="sao">Số sao (1–5)</label>
            <input id="sao" name="sao" type="number" min="1" max="5" value="5" class="form-control input-narrow" />
        </div>
        <div class="form-group">
            <label for="noiDung">Nhận xét</label>
            <textarea id="noiDung" name="noiDung" class="form-control" rows="3"></textarea>
        </div>
        <div class="form-group">
            <label for="anhKem">Ảnh kèm theo (jpg, png, webp — tối đa 5MB)</label>
            <input id="anhKem" name="anhKem" type="file" accept=".jpg,.jpeg,.png,.webp" class="form-control" />
        </div>
        <button type="submit" class="btn btn-secondary">Gửi đánh giá</button>
    </form>
    }
    else
    {
        <p class="mt"><a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Url.Action("Details", "Products", new { id = Model.Id })">Đăng nhập</a> để đánh giá sản phẩm này.</p>
    }
</section>

<section class="section qa-block">
    <h2>Hỏi &amp; đáp (@cauHoi.Count)</h2>
    @if (!cauHoi.Any())
    {
        <p class="text-muted">Chưa có câu hỏi nào. Hãy đặt câu hỏi đầu tiên về sản phẩm này.</p>
    }
    @foreach (var q in cauHoi)
    {
        <div class="qa-item">
            <p class="qa-question"><strong>Hỏi:</strong> @q.CauHoi</p>
            <p class="text-muted">@q.User?.HoTen — @q.NgayHoi.ToString("dd/MM/yyyy HH:mm")</p>
            @if (q.DaTraLoi)
            {
                <p class="qa-answer"><strong>TechZone trả lời:</strong> @q.TraLoi</p>
                <p class="text-muted">@q.NguoiTraLoi?.HoTen — @q.NgayTraLoi?.ToString("dd/MM/yyyy HH:mm")</p>
            }
            else
            {
                <p class="text-muted">TechZone sẽ trả lời sớm.</p>
            }
        </div>
    }
    @if (User.Identity?.IsAuthenticated == true)
    {
        <form asp-action="HoiDap" method="post" class="mt">
            <input type="hidden" name="productId" value="@Model.Id" />
            <div class="form-group">
                <label for="cauHoi">Đặt câu hỏi về sản phẩm</label>
                <textarea id="cauHoi" name="cauHoi" class="form-control" rows="3" maxlength="1000" required></textarea>
            </div>
            <button type="submit" class="btn btn-secondary">Gửi câu hỏi</button>
        </form>
    }
    else
    {
        <p class="mt"><a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Url.Action("Details", "Products", new { id = Model.Id })">Đăng nhập</a> để đặt câu hỏi về sản phẩm này.</p>
    }
</section>

@if (tuongTu.Any())
{
    <section class="section">
        <div class="section-head">
            <h2>Sản phẩm tương tự</h2>
            <a asp-action="Index" asp-route-CategoryId="@Model.CategoryId">Xem tất cả →</a>
        </div>
        <div class="product-grid">
            @foreach (var p in tuongTu)
            {
                <partial name="_ProductCard" model="p" />
            }
        </div>
    </section>
}

<partial name="_RecentlyViewed" model="recentlyViewed" />

@* Sprint 5 Mang 2: chi nap thu vien model-viewer + product-3d.js khi trang
   co viewer (model3d is not null) — trang khong co model (VD iPhone Id 2)
   khong tai thua ~955KB thu vien. *@
@if (model3d is not null)
{
    @section Scripts {
        <script type="module" src="~/js/model-viewer.min.js"></script>
        <script src="~/js/product-3d.js"></script>
    }
}
