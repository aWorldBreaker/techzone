@model TechZone.Models.Product
@{
    ViewData["Title"] = Model.Ten;
    var tuongTu = (List<TechZone.Models.Product>)ViewBag.TuongTu;
    var combo = (TechZone.Models.Product?)ViewBag.Combo;
    var recentlyViewed = (List<TechZone.Models.Product>)ViewBag.RecentlyViewed;
    var cauHoi = (List<TechZone.Models.ProductQuestion>)ViewBag.CauHoi;
    var daYeuThich = ViewBag.DaYeuThich is bool b && b;
    // SALE-01: gia hien thi do controller tinh qua PriceCalculationService
    // (cung ham nhu Cart/Checkout) — view khong tu tinh flash?.GiaSale
    // ?? GiaBan nua. Fallback GiaBan chi de view khong vo neu action
    // cu (vd test render truc tiep) khong set ViewBag.
    var giaHienThi = ViewBag.GiaHienThi as decimal? ?? Model.GiaBan;
    var giaNiemYet = Model.Gia;
    var tenKhuyenMai = ViewBag.TenKhuyenMai as string;
    var flash = ViewBag.FlashSaleApDung as TechZone.Models.FlashSale;
    var comboGiaChinh = ViewBag.ComboGiaChinh as decimal? ?? Model.GiaBan;
    var comboGiaKem = ViewBag.ComboGiaKem as decimal? ?? combo?.GiaBan ?? 0m;
    var comboTongBo = ViewBag.ComboTongBo as decimal? ?? (Model.GiaBan + (combo?.GiaBan ?? 0m));
    var comboGiamGia = ViewBag.ComboGiamGia as decimal? ?? 0m;
    var model3d = ViewBag.Model3d as TechZone.Models.Product3dModel;
    // Sprint 6 Module 4 — gia hien thi theo tung bien the (controller tinh
    // bang TinhGiaAsync, xem ProductsController.Details); view chi doc
    // de gan data-gia cho option, khong tu tinh gia.
    var giaTheoVariant = ViewBag.GiaTheoVariant as Dictionary<int, TechZone.Services.GiaApDungResult>;
    if (Model.Variants.FirstOrDefault() is { } firstVariant &&
        giaTheoVariant?.TryGetValue(firstVariant.Id, out var giaBanDau) == true)
    {
        giaHienThi = giaBanDau.DonGia;
        giaNiemYet = giaBanDau.GiaGoc;
    }
    var reviews = Model.Reviews.Where(r => r.IsApproved).ToList();
    var soDanhGia = reviews.Count;
    var diemTB = soDanhGia > 0 ? Math.Round(reviews.Average(r => r.Sao), 1) : 0;
    var need = ProductNeed.Find(Context.Request.Query["NhuCau"].ToString());
    var needFields = new Dictionary<string, string[]>
    {
        ["chup-anh"] = ["camera", "screen", "battery"],
        ["lam-viec"] = ["chip", "memory", "graphics", "screen", "battery"],
        ["nghe-nhac"] = ["battery", "feature"]
    };
    var selectedFields = need is null ? Array.Empty<string>() : needFields.GetValueOrDefault(need.Key) ?? [];
    var discount = giaNiemYet > 0 && giaHienThi < giaNiemYet
        ? (int)Math.Round((1 - giaHienThi / giaNiemYet) * 100) : 0;
    var specRows = new List<(string Key, string Label, string Value, int Number, int X, int Y)>();
    var zones = Model.Category.Slug switch
    {
        "dien-thoai" => new Dictionary<string, (int, int)>
        {
            ["camera"] = (200, 50), ["screen"] = (200, 125), ["chip"] = (179, 193),
            ["memory"] = (221, 193), ["battery"] = (200, 243)
        },
        "laptop" => new Dictionary<string, (int, int)>
        {
            ["screen"] = (200, 105), ["chip"] = (146, 207), ["graphics"] = (254, 207),
            ["memory"] = (200, 207), ["battery"] = (200, 251)
        },
        "tai-nghe" => new Dictionary<string, (int, int)>
        {
            ["battery"] = (111, 201), ["feature1"] = (200, 49),
            ["feature2"] = (291, 201), ["feature3"] = (111, 250)
        },
        _ => new Dictionary<string, (int, int)>()
    };
    var zoneNumber = 0;
    var hasPhoto = !Model.AnhDaiDien.EndsWith("/placeholder.svg", StringComparison.OrdinalIgnoreCase);
    void AddSpec(string key, string label, string? value, string? zoneKey = null)
    {
        if (string.IsNullOrWhiteSpace(value)) return;
        if (hasPhoto && zones.TryGetValue(zoneKey ?? key, out var point))
            specRows.Add((key, label, value, ++zoneNumber, point.Item1, point.Item2));
        else
            specRows.Add((key, label, value, 0, 0, 0));
    }
    if (Model.Specs is { } spec)
    {
        var memory = new[] { spec.Ram, spec.Rom }.Where(s => !string.IsNullOrWhiteSpace(s));
        AddSpec("screen", "Màn hình", spec.ManHinh);
        AddSpec("chip", "Chip", spec.Chip);
        AddSpec("memory", "Bộ nhớ", string.Join(", ", memory));
        AddSpec("camera", "Camera", spec.Camera);
        AddSpec("graphics", "Card đồ họa", spec.CardDoHoa);
        AddSpec("battery", "Pin", spec.Pin);
        var featureIndex = 0;
        foreach (var feature in spec.ThongSoKhac?.Split(", ", StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries) ?? [])
            AddSpec("feature", "Tính năng", feature, $"feature{++featureIndex}");
    }
}

<nav class="market-path detail-path" aria-label="Đường dẫn">
    <a asp-controller="Home" asp-action="Index">Trang chủ</a>
    <span aria-hidden="true">/</span>
    <a asp-controller="Products" asp-action="Index" asp-route-CategoryId="@Model.CategoryId">@Model.Category.Ten</a>
    <span aria-hidden="true">/</span><span aria-current="page">@Model.Ten</span>
</nav>

<div class="detail-layout">
    <header class="detail-offer">
        <h1>@Model.Ten</h1>
        <p class="detail-reviews">
            @if (soDanhGia > 0)
            {
                <a href="#danh-gia">@diemTB.ToString("0.0")/5 sao (@soDanhGia đánh giá)</a>
            }
            else
            {
                <span>Chưa có đánh giá</span>
            }
        </p>
        <p class="detail-reviews">Đã bán @Model.LuotBan</p>
        <div class="detail-price" aria-live="polite" aria-atomic="true" data-detail-offer>
            <div class="price-tag drawing-price">
                <strong class="price-big price-amount">@giaHienThi.ToString("N0")đ</strong>
                <s class="price-old" hidden="@(giaHienThi >= giaNiemYet)">@giaNiemYet.ToString("N0")đ</s>
            </div>
            <span class="chip-giam" data-detail-discount hidden="@(discount <= 0)">−@(discount)%</span>
        </div>
        @if (flash is not null)
        {
            <p class="detail-promo">Flash Sale đến @flash.KetThuc.ToString("HH:mm dd/MM")</p>
        }
        else if (!string.IsNullOrEmpty(tenKhuyenMai))
        {
            <p class="detail-promo">@tenKhuyenMai</p>
        }
        <p class="detail-stock"><partial name="_StockStatus" model="Model.TonKho" /></p>
    </header>
    <div class="detail-image blueprint" data-annotation-panel>
        <h2 class="gallery-title">Hình ảnh và thông số</h2>
        <div class="detail-3d" id="@(model3d is null ? null : "product-3d")" data-model-url="@model3d?.ModelUrl">
            <div class="gallery-stage">
                <img id="product-image" src="@Model.AnhDaiDien" alt="@Model.Ten" width="640" height="480" />
                @if (zoneNumber > 0)
                {
                    <svg class="spec-overlay" viewBox="0 0 400 300" role="img" aria-label="Ảnh @Model.Ten có @zoneNumber chú thích thông số">
                        @foreach (var row in specRows.Where(r => r.Number > 0))
                        {
                            var edge = row.Number % 2 == 0 ? 388 : 12;
                            <g id="spec-zone-@row.Number" data-spec-zone="@row.Number" data-spec-kind="@row.Key"
                               class="spec-zone @(selectedFields.Contains(row.Key) ? "spec-highlight" : "")" style="--i:@(row.Number - 1)">
                                <path class="drawing-leader" d="@($"M{row.X} {row.Y} H{edge}")" pathLength="1" />
                                <circle class="drawing-zone" cx="@row.X" cy="@row.Y" r="14" pathLength="1" />
                                <circle class="drawing-zone drawing-center" cx="@row.X" cy="@row.Y" r="2.5" pathLength="1" />
                            </g>
                        }
                    </svg>
                }
                @if (model3d is not null)
                {
                    <model-viewer id="product-viewer" class="product-viewer" hidden
                        poster="@Model.AnhDaiDien" alt="Mô hình 3D minh họa của @Model.Ten"
                        camera-controls touch-action="pan-y"
                        camera-orbit="@model3d.CameraOrbit" field-of-view="45deg"
                        min-camera-orbit="auto auto 50%" max-camera-orbit="auto auto 200%"
                        orientation="@model3d.Orientation" environment-image="neutral">
                    </model-viewer>
                }
            </div>
            @if (model3d is not null)
            {
                <p class="alert alert-error" id="viewer-error" hidden>Không tải được mô hình 3D. Ảnh sản phẩm đang hiển thị.</p>
                <div class="viewer-toolbar" role="group" aria-label="Điều khiển xem 3D">
                    <button type="button" class="btn btn-secondary btn-sm" id="btn-3d-show">Xem 3D</button>
                    <button type="button" class="btn btn-secondary btn-sm" id="btn-3d-hide" hidden>Xem ảnh</button>
                    <button type="button" class="btn btn-secondary btn-sm" id="btn-3d-reset" hidden>Đặt lại góc nhìn</button>
                    <button type="button" class="btn btn-secondary btn-sm" id="btn-3d-rotate" hidden aria-pressed="false">Tự xoay: Tắt</button>
                    <button type="button" class="btn btn-secondary btn-sm" id="btn-3d-fullscreen" hidden>Toàn màn hình</button>
                </div>
                <p class="viewer-note text-muted">Mô hình 3D minh họa. Kéo để xoay, cuộn hoặc chụm để thay đổi độ phóng đại.</p>
            }
        </div>
        @if (Model.Images.Count > 1)
        {
            <div class="choice-row detail-thumbs" role="group" aria-label="Ảnh sản phẩm">
                @for (var i = 0; i < Model.Images.Count; i++)
                {
                    var img = Model.Images.ElementAt(i);
                    <button type="button" class="thumb-btn" data-full="@img.Url"
                        aria-label="Ảnh @(i + 1) của @Model.Ten"
                        aria-current="@(i == 0 ? "true" : null)">
                        <img src="@img.Url" alt="@Model.Ten" class="thumb-sm" width="72" height="72" loading="lazy" />
                    </button>
                }
            </div>
        }
        @if (hasPhoto && specRows.Count > 0)
        {
            <form class="annotation-needs choice-row" method="get" aria-label="Làm nổi thông số theo nhu cầu" data-annotation-needs>
                <button class="chip @(need is null ? "chip-active" : "")" name="NhuCau" value="" aria-pressed="@(need is null ? "true" : "false")">Tất cả</button>
                @foreach (var option in ProductNeed.All)
                {
                    <button class="chip @(need?.Key == option.Key ? "chip-active" : "")" name="NhuCau" value="@option.Key"
                            data-fields="@string.Join(" ", needFields.GetValueOrDefault(option.Key) ?? [])"
                            aria-pressed="@(need?.Key == option.Key ? "true" : "false")">@option.Title</button>
                }
            </form>
            <dl class="spec-notes">
                @foreach (var row in specRows)
                {
                    <div class="spec-note @(selectedFields.Contains(row.Key) ? "spec-highlight" : "")" data-spec-kind="@row.Key">
                        <dt>
                            @if (row.Number > 0)
                            {
                                <a data-spec-target="@row.Number" href="#spec-zone-@row.Number" aria-label="Định vị @row.Label trên ảnh">@row.Label</a>
                            }
                            else
                            {
                                @row.Label
                            }
                        </dt>
                        <dd>@row.Value @if (row.Number == 0) { <small>(chỉ trong danh sách)</small> }</dd>
                    </div>
                }
            </dl>
        }
    </div>

    <div class="detail-buy">
        <form asp-controller="Cart" asp-action="Add" method="post" class="detail-add" id="detail-add-form">
            <input type="hidden" name="productId" value="@Model.Id" />
            @if (Model.Variants.Any())
            {
                <div class="form-group">
                    <label for="variantId">Phiên bản</label>
                    <select id="variantId" name="variantId" class="form-control">
                        @foreach (var v in Model.Variants)
                        {
                            var giaVariant = giaTheoVariant is not null && giaTheoVariant.TryGetValue(v.Id, out var gv) ? gv : null;
                            @* Sprint 6 Module 4 — gia tung bien the render san vao
                               data-gia/data-gia-goc de JS cap nhat gia hien thi
                               ngay khi doi select (khong reload, khong doi
                               logic server khi them gio/thanh toan). *@
                            <option value="@v.Id"
                                data-gia="@(giaVariant?.DonGia.ToString("F0", System.Globalization.CultureInfo.InvariantCulture))"
                                data-gia-goc="@(giaVariant?.GiaGoc.ToString("F0", System.Globalization.CultureInfo.InvariantCulture))"
                                data-installment-6="@(giaVariant is null ? null : Math.Round(giaVariant.DonGia / 6).ToString("N0"))"
                                data-installment-12="@(giaVariant is null ? null : Math.Round(giaVariant.DonGia / 12).ToString("N0"))">@v.TenBienThe@(v.GiaThem > 0 ? $" (+{v.GiaThem:N0}đ)" : "")</option>
                        }
                    </select>
                </div>
                @if (Model.TonKho > 0)
                {
                    <div class="form-group">
                        <label for="soLuong">Số lượng</label>
                        <input id="soLuong" name="soLuong" type="number" min="1" max="@Model.TonKho" value="1" class="form-control input-narrow" />
                    </div>
                }
            }
            else
            {
                <input type="hidden" name="soLuong" value="1" />
            }
            <div class="detail-buy-bar">
                <button type="submit" id="detail-buy-submit" class="btn btn-primary" disabled="@(Model.TonKho <= 0)">@(Model.TonKho > 0 ? "Thêm vào giỏ" : "Hết hàng")</button>
            </div>
        </form>
        <ul class="buy-policy">
            <li>Bảo hành 24 tháng</li>
            <li>Miễn phí vận chuyển từ 2.000.000đ</li>
            <li>Đổi trả trực tuyến</li>
        </ul>
        <partial name="_InstallmentBadge" model="giaHienThi" />
        <div class="detail-actions">
            <form asp-controller="Compare" asp-action="Add" method="post">
                <input type="hidden" name="productId" value="@Model.Id" />
                <button type="submit" class="btn btn-secondary" aria-label="So sánh @Model.Ten">So sánh</button>
            </form>
            @if (daYeuThich)
            {
                <form asp-controller="Wishlist" asp-action="Remove" method="post" class="wishlist-form">
                    <input type="hidden" name="productId" value="@Model.Id" />
                    <button type="submit" class="btn btn-secondary wishlist-btn wishlist-btn-active" aria-label="Bỏ @Model.Ten khỏi yêu thích">Bỏ yêu thích</button>
                </form>
            }
            else
            {
                <form asp-controller="Wishlist" asp-action="Add" method="post" class="wishlist-form">
                    <input type="hidden" name="productId" value="@Model.Id" />
                    <button type="submit" class="btn btn-secondary wishlist-btn" aria-label="Thêm @Model.Ten vào yêu thích">Yêu thích</button>
                </form>
            }
        </div>
    </div>
</div>

@if (Model.TonKho > 0)
{
    <div class="mobile-buy" data-mobile-buy hidden>
        <span class="price-tag"><strong class="price-amount" data-mobile-price>@giaHienThi.ToString("N0")đ</strong></span>
        <button type="submit" form="detail-add-form" class="btn btn-primary">Thêm vào giỏ</button>
    </div>
}
<nav class="detail-nav choice-row" aria-label="Nội dung sản phẩm" data-detail-nav>
    <a class="chip" href="#thong-so" aria-current="location">Thông số</a>
    @if (combo is not null) { <a class="chip" href="#mua-kem">Mua kèm</a> }
    <a class="chip" href="#danh-gia">Đánh giá</a>
    <a class="chip" href="#hoi-dap">Hỏi đáp</a>
    @if (tuongTu.Any()) { <a class="chip" href="#tuong-tu">Tương tự</a> }
</nav>

<section class="section detail-section" id="thong-so">
    <h2>Thông số kỹ thuật</h2>
    @if (specRows.Count > 0)
    {
        <div class="table-wrap">
            <table class="spec-table">
                <tbody>
                    @foreach (var row in specRows)
                    {
                        <tr><th scope="row">@row.Label</th><td>@row.Value</td></tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <p class="text-muted">Sản phẩm này chưa có bảng thông số.</p>
    }
    @if (!string.IsNullOrWhiteSpace(Model.MoTa))
    {
        <h2 class="mt">Mô tả</h2>
        <p>@Model.MoTa</p>
    }
</section>

@if (combo is not null)
{
    <section class="section detail-section combo-block" id="mua-kem">
        <h2>Mua kèm giá tốt</h2>
        <div class="combo-items">
            @if (ViewBag.ComboMon is List<TechZone.Models.CartLineViewModel> comboMon)
            {
                @* Sprint 6 Module 4 — combo N mon: render du moi mon
                   (mon chinh len dau, dau + giua cac mon); gia tung mon
                   la gia hieu dung (da ap Flash Sale), SoLuong > 1 thi
                   hien "× N". Tong/giam lay tu TinhGiaComboAsync nhu cu. *@
                @for (var i = 0; i < comboMon.Count; i++)
                {
                    var mon = comboMon[i];
                    if (i > 0)
                    {
                        <span class="combo-plus" aria-hidden="true">+</span>
                    }
                    <div class="combo-item">
                        <img src="@mon.Product.AnhDaiDien" alt="@mon.Product.Ten" loading="lazy" />
                        <p>
                            @if (mon.Product.Id == Model.Id)
                            {
                                @mon.Product.Ten
                            }
                            else
                            {
                                <a asp-controller="Products" asp-action="Details" asp-route-id="@mon.Product.Id">@mon.Product.Ten</a>
                            }
                            @if (mon.SoLuong > 1)
                            {
                                <span> × @mon.SoLuong</span>
                            }
                        </p>
                        <p><strong>@mon.DonGia.ToString("N0")đ</strong></p>
                    </div>
                }
            }
            else
            {
            <div class="combo-item">
                <img src="@Model.AnhDaiDien" alt="@Model.Ten" loading="lazy" />
                <p>@Model.Ten</p>
                <p><strong>@comboGiaChinh.ToString("N0")đ</strong></p>
            </div>
            <span class="combo-plus" aria-hidden="true">+</span>
            <div class="combo-item">
                <img src="@combo.AnhDaiDien" alt="@combo.Ten" loading="lazy" />
                <p><a asp-controller="Products" asp-action="Details" asp-route-id="@combo.Id">@combo.Ten</a></p>
                <p><strong>@comboGiaKem.ToString("N0")đ</strong></p>
            </div>
            }
        </div>
        @if (ViewBag.ComboMon is List<TechZone.Models.CartLineViewModel> comboMonDem)
        {
            <p class="text-muted">Combo gồm @comboMonDem.Count sản phẩm</p>
        }
        <p class="combo-total">Tổng combo: <strong>@comboTongBo.ToString("N0")đ</strong>
        @if (ViewBag.ComboId is not null && ViewBag.ComboGiamGia is decimal giamCombo && giamCombo > 0)
        {
            <span>— Giảm combo <strong>@giamCombo.ToString("N0")đ</strong>, chỉ còn <strong>@((comboTongBo - giamCombo).ToString("N0"))đ</strong></span>
        }
        </p>
        <form asp-controller="Cart" asp-action="AddCombo" method="post">
            <input type="hidden" name="productId" value="@Model.Id" />
            <input type="hidden" name="comboProductId" value="@combo.Id" />
            @if (ViewBag.ComboId is not null)
            {
                <input type="hidden" name="comboId" value="@ViewBag.ComboId" />
            }
            <input type="hidden" name="soLuong" value="1" />
            <button type="submit" class="btn btn-primary">Mua combo — @((comboTongBo - comboGiamGia).ToString("N0"))đ</button>
        </form>
    </section>
}

<section class="section detail-section" id="danh-gia">
    <h2>Đánh giá (@soDanhGia)</h2>
    <div class="review-layout">
        <aside aria-label="Tóm tắt đánh giá">
            @if (soDanhGia > 0)
            {
                <p class="review-score">@diemTB.ToString("0.0")/5 sao</p>
                <p class="text-muted">@soDanhGia đánh giá đã duyệt</p>
            }
            else { <p class="text-muted">Chưa có đánh giá</p> }
        </aside>
        <div>
    @if (soDanhGia == 0)
    {
        <p class="text-muted">Chưa có đánh giá nào. Hãy là người đầu tiên đánh giá sản phẩm này.</p>
    }
    @foreach (var r in reviews.OrderByDescending(r => r.NgayDanhGia))
    {
        <div class="review-item">
            <strong>@r.Sao sao</strong> — @r.User?.HoTen
            <span class="text-muted">@r.NgayDanhGia.ToString("dd/MM/yyyy")</span>
            @if (!string.IsNullOrWhiteSpace(r.NoiDung)) { <p>@r.NoiDung</p> }
            @if (!string.IsNullOrWhiteSpace(r.ImageUrl)) { <img src="@r.ImageUrl" alt="Ảnh đánh giá của @r.User?.HoTen" class="review-image" loading="lazy" /> }
        </div>
    }
    @* M4-2: form danh gia chi hien khi da login (POST DanhGia co [Authorize],
       khach chua login bam Gui se bi day sang Login, mat noi dung da go).
       Anon thay link dang nhap, giong khoi Hoi & dap ben duoi. *@
    @if (User.Identity?.IsAuthenticated == true)
    {
    <form asp-action="DanhGia" method="post" enctype="multipart/form-data" class="mt">
        <input type="hidden" name="productId" value="@Model.Id" />
        <div class="form-group">
            <label for="sao">Số sao (1–5)</label>
            <input id="sao" name="sao" type="number" min="1" max="5" value="5" class="form-control input-narrow" />
        </div>
        <div class="form-group">
            <label for="noiDung">Nhận xét</label>
            <textarea id="noiDung" name="noiDung" class="form-control" rows="3"></textarea>
        </div>
        <div class="form-group">
            <label for="anhKem">Ảnh kèm theo (jpg, png, webp — tối đa 5MB)</label>
            <input id="anhKem" name="anhKem" type="file" accept=".jpg,.jpeg,.png,.webp" class="form-control" />
        </div>
        <button type="submit" class="btn btn-secondary">Gửi đánh giá</button>
    </form>
    }
    else
    {
        <p class="mt"><a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Url.Action("Details", "Products", new { id = Model.Id })">Đăng nhập</a> để đánh giá sản phẩm này.</p>
    }
        </div>
    </div>
</section>

<section class="section detail-section qa-block" id="hoi-dap">
    <h2>Hỏi &amp; đáp (@cauHoi.Count)</h2>
    @if (!cauHoi.Any())
    {
        <p class="text-muted">Chưa có câu hỏi nào. Hãy đặt câu hỏi đầu tiên về sản phẩm này.</p>
    }
    @foreach (var q in cauHoi)
    {
        <div class="qa-item">
            <p class="qa-question"><strong>Hỏi:</strong> @q.CauHoi</p>
            <p class="text-muted">@q.User?.HoTen — @q.NgayHoi.ToString("dd/MM/yyyy HH:mm")</p>
            @if (q.DaTraLoi)
            {
                <p class="qa-answer"><strong>TechZone trả lời:</strong> @q.TraLoi</p>
                <p class="text-muted">@q.NguoiTraLoi?.HoTen — @q.NgayTraLoi?.ToString("dd/MM/yyyy HH:mm")</p>
            }
            else
            {
                <p class="text-muted">TechZone sẽ trả lời sớm.</p>
            }
        </div>
    }
    @if (User.Identity?.IsAuthenticated == true)
    {
        <form asp-action="HoiDap" method="post" class="mt">
            <input type="hidden" name="productId" value="@Model.Id" />
            <div class="form-group">
                <label for="cauHoi">Đặt câu hỏi về sản phẩm</label>
                <textarea id="cauHoi" name="cauHoi" class="form-control" rows="3" maxlength="1000" required></textarea>
            </div>
            <button type="submit" class="btn btn-secondary">Gửi câu hỏi</button>
        </form>
    }
    else
    {
        <p class="mt"><a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Url.Action("Details", "Products", new { id = Model.Id })">Đăng nhập</a> để đặt câu hỏi về sản phẩm này.</p>
    }
</section>

@if (tuongTu.Any())
{
    <section class="section detail-section" id="tuong-tu">
        <div class="section-head">
            <h2>Sản phẩm tương tự</h2>
            <a asp-action="Index" asp-route-CategoryId="@Model.CategoryId">Xem tất cả sản phẩm</a>
        </div>
        <div class="product-grid">
            @foreach (var p in tuongTu)
            {
                <partial name="_ProductCard" model="p" />
            }
        </div>
    </section>
}

<partial name="_RecentlyViewed" model="recentlyViewed" />

@* Sprint 6 Module 4 — product-detail.js (gallery + gia variant) nap tren
   moi trang Details; model-viewer + product-3d.js chi khi co viewer 3D
   (Sprint 5 Mang 2: trang khong co model khong tai thua ~955KB). *@
@section Scripts {
    <script src="~/js/product-detail.js" asp-append-version="true"></script>
    <script src="~/js/product-annotations.js" asp-append-version="true"></script>
    @if (model3d is not null)
    {
        <script type="module" src="~/js/model-viewer.min.js" asp-append-version="true"></script>
        <script src="~/js/product-3d.js" asp-append-version="true"></script>
    }
}

@section Styles {
    <link rel="stylesheet" href="~/css/product-cards.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/product-details.css" asp-append-version="true" />
    @if (model3d is not null)
    {
        <link rel="stylesheet" href="~/css/product-viewer.css" asp-append-version="true" />
    }
}
