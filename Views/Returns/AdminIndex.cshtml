@model List<ReturnRequest>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Duyệt đổi trả / bảo hành";
    var baoHanh = (List<WarrantyClaim>)ViewBag.BaoHanh;
    var trangThai = (string?)ViewBag.TrangThai;
    var locs = new[] { (string?)null, "Chờ duyệt", "Đã duyệt", "Từ chối", "Hoàn thành" };
    var requests = ((IEnumerable<ReturnRequest>)Model, (IEnumerable<WarrantyClaim>)baoHanh, false);
}

<header class="market-heading order-heading">
    <h1>Duyệt đổi trả / bảo hành</h1>
    <p>@Model.Count yêu cầu đổi trả · @baoHanh.Count yêu cầu bảo hành</p>
</header>

<nav class="chip-row" aria-label="Lọc theo trạng thái">
    @foreach (var loc in locs)
    {
        <a asp-action="AdminIndex" asp-route-trangThai="@loc" class="chip @(loc == trangThai ? "chip-active" : null)"
           aria-current="@(loc == trangThai ? "true" : null)">@(loc ?? "Tất cả")</a>
    }
</nav>

<partial name="_AdminRequestRecords" model="requests" />
