@model TechZone.Models.ReturnRequest
@{
    ViewData["Title"] = "Yêu cầu đổi trả";
    var order = (TechZone.Models.Order)ViewBag.Order;
}

<header class="market-heading order-heading">
    <nav class="market-path" aria-label="Đường dẫn">
        <a asp-controller="Orders" asp-action="Details" asp-route-id="@order.Id">Đơn #@order.Id</a>
        <span aria-hidden="true">/</span><span aria-current="page">Đổi trả</span>
    </nav>
    <h1>Yêu cầu đổi trả</h1>
    <p>Ngày đặt @order.NgayDat.ToString("dd/MM/yyyy HH:mm")</p>
</header>

@if (Model.OrderDetailId is null)
{
    <partial name="_ChonSanPham" model="(order, false)" />
}
else
{
    var detail = (TechZone.Models.OrderDetail)ViewBag.OrderDetail;
    <div class="order-layout">
        <form asp-action="Create" method="post" enctype="multipart/form-data" class="card tracking-card service-card">
            <h2>Thông tin đổi trả</h2>
            <p><strong>@detail.Product.Ten</strong> @detail.Variant?.TenBienThe</p>
            <input type="hidden" asp-for="OrderId" />
            <input type="hidden" asp-for="OrderDetailId" />
            <div class="form-group">
                <label asp-for="LyDo">Lý do đổi trả</label>
                <textarea asp-for="LyDo" class="form-control" rows="4" maxlength="1000" required></textarea>
                <span asp-validation-for="LyDo" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label for="anhKem">Ảnh kèm theo (không bắt buộc)</label>
                <input type="file" name="anhKem" id="anhKem" class="form-control" accept=".jpg,.jpeg,.png,.webp" aria-describedby="anhKem-help" />
                <small id="anhKem-help" class="text-muted">JPG, JPEG, PNG hoặc WEBP, tối đa 5 MB.</small>
            </div>
            <div class="service-actions">
                <button type="submit" class="btn btn-primary">Gửi yêu cầu đổi trả</button>
                <a asp-action="Create" asp-route-orderId="@order.Id" class="btn btn-secondary">Chọn sản phẩm khác</a>
            </div>
        </form>
        <aside class="card market-receipt service-card">
            <h2>Sản phẩm cần đổi trả</h2>
            <img src="@detail.Product.AnhDaiDien" alt="" width="72" height="72" class="thumb-sm" />
            <p>Số lượng trong đơn <strong>@detail.SoLuong</strong></p>
            <a asp-controller="Orders" asp-action="Details" asp-route-id="@order.Id" class="btn btn-secondary">Xem đơn #@order.Id</a>
        </aside>
    </div>
}

@section Styles {
    <link rel="stylesheet" href="~/css/order-detail.css" asp-append-version="true" />
}
