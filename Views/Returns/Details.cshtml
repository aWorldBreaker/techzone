@model object
@{
    var yeuCau = Model switch
    {
        TechZone.Models.ReturnRequest r => (r.Id, r.OrderId, Ten: "Đổi trả", SanPham: r.Product.Ten,
            PhienBan: r.OrderDetail?.Variant?.TenBienThe, Nhan: "Lý do đổi trả", NoiDung: r.LyDo, r.AnhUrl, r.NgayTao, r.TrangThai),
        TechZone.Models.WarrantyClaim w => (w.Id, w.OrderId, Ten: "Bảo hành", SanPham: w.Product.Ten,
            PhienBan: (string?)null, Nhan: "Mô tả lỗi", NoiDung: w.MoTaLoi, AnhUrl: (string?)null, w.NgayTao, w.TrangThai),
        _ => throw new InvalidOperationException("Loại yêu cầu không hợp lệ.")
    };
    ViewData["Title"] = $"Yêu cầu {yeuCau.Ten.ToLowerInvariant()} #{yeuCau.Id}";
    var trangDanhSach = User.IsInRole("Admin") ? "AdminIndex" : "Index";
}

<header class="market-heading order-heading">
    <nav class="market-path" aria-label="Đường dẫn">
        <a asp-action="@trangDanhSach">@(User.IsInRole("Admin") ? "Danh sách duyệt" : "Yêu cầu của tôi")</a>
        <span aria-hidden="true">/</span><span aria-current="page">Yêu cầu #@yeuCau.Id</span>
    </nav>
    <div class="section-head">
        <h1>@yeuCau.Ten #@yeuCau.Id</h1>
        <partial name="_TrangThaiBadge" model="yeuCau.TrangThai" />
    </div>
    <p>Ngày gửi @yeuCau.NgayTao.ToString("dd/MM/yyyy HH:mm")</p>
</header>

<div class="order-layout">
    <section class="card tracking-card service-card">
        <h2>@yeuCau.Nhan</h2>
        <p class="service-description">@yeuCau.NoiDung</p>
        @if (!string.IsNullOrEmpty(yeuCau.AnhUrl))
        {
            <h3>Ảnh kèm theo</h3>
            <img src="@yeuCau.AnhUrl" alt="Ảnh kèm theo yêu cầu đổi trả" class="service-attachment" />
        }
    </section>
    <aside class="card market-receipt service-card">
        <h2>Sản phẩm liên quan</h2>
        <p><strong>@yeuCau.SanPham</strong> @yeuCau.PhienBan</p>
        <a asp-controller="Orders" asp-action="Details" asp-route-id="@yeuCau.OrderId" class="btn btn-secondary">Xem đơn #@yeuCau.OrderId</a>
    </aside>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/order-detail.css" asp-append-version="true" />
}
