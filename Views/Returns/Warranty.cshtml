@model TechZone.Models.WarrantyClaim
@{
    ViewData["Title"] = "Yêu cầu bảo hành";
    var order = (TechZone.Models.Order)ViewBag.Order;
    var hanBaoHanh = order.NgayDat.AddMonths(24);
    var conLai = (hanBaoHanh.Date - DateTime.Now.Date).Days;
}

<header class="market-heading order-heading">
    <nav class="market-path" aria-label="Đường dẫn">
        <a asp-controller="Orders" asp-action="Details" asp-route-id="@order.Id">Đơn #@order.Id</a>
        <span aria-hidden="true">/</span><span aria-current="page">Bảo hành</span>
    </nav>
    <h1>Yêu cầu bảo hành</h1>
    <p>Ngày đặt @order.NgayDat.ToString("dd/MM/yyyy HH:mm")</p>
</header>

<div class="order-layout">
    @if (Model.ProductId == 0)
    {
        <partial name="_ChonSanPham" model="(order, true)" />
    }
    else
    {
        var product = (TechZone.Models.Product)ViewBag.Product;
        <form asp-action="Warranty" method="post" class="card tracking-card service-card">
            <h2>Thông tin bảo hành</h2>
            <p><strong>@product.Ten</strong></p>
            <input type="hidden" asp-for="OrderId" />
            <input type="hidden" asp-for="ProductId" />
            <div class="form-group">
                <label asp-for="MoTaLoi">Mô tả lỗi</label>
                <textarea asp-for="MoTaLoi" class="form-control" rows="4" required></textarea>
                <span asp-validation-for="MoTaLoi" class="text-danger"></span>
            </div>
            <div class="service-actions">
                <button type="submit" class="btn btn-primary">Gửi yêu cầu bảo hành</button>
                <a asp-action="Warranty" asp-route-orderId="@order.Id" class="btn btn-secondary">Chọn sản phẩm khác</a>
            </div>
        </form>
    }
    <aside class="card market-receipt service-card">
        <h2>Thời hạn bảo hành</h2>
        <p>Hạn đến <strong>@hanBaoHanh.ToString("dd/MM/yyyy")</strong></p>
        <span class="badge @(conLai >= 0 ? "badge-xong" : "badge-huy")">@(conLai >= 0 ? $"Còn {conLai} ngày" : "Đã hết hạn")</span>
    </aside>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/order-detail.css" asp-append-version="true" />
}
