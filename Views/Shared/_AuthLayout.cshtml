<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script>
        /* Đặt theme TRƯỚC KHI trang vẽ (giống _Layout): localStorage
           'techzone-theme', chưa có thì theo prefers-color-scheme. */
        (function () {
            var t = 'light';
            try { t = localStorage.getItem('techzone-theme') || ''; } catch (e) { /* bỏ qua */ }
            if (t !== 'dark' && t !== 'light') {
                t = (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) ? 'dark' : 'light';
            }
            document.documentElement.setAttribute('data-theme', t);
        })();
    </script>
    <title>@ViewData["Title"] - TechZone</title>
    <link rel="icon" href="~/favicon.ico" type="image/x-icon" />
    <link rel="stylesheet" href="~/css/design-tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/common.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/market-theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="auth-body storefront">
    <a class="skip-link" href="#auth-main">Bỏ qua tới nội dung chính</a>
    <header class="auth-header">
        <a class="auth-logo" asp-controller="Home" asp-action="Index">Tech<span>Zone</span></a>
        <button type="button" id="theme-toggle" class="theme-toggle" aria-label="Chuyển sang giao diện tối" title="Chuyển sáng/tối"><partial name="_ThemeIcon" /></button>
    </header>

    <main id="auth-main" class="auth-shell">
        @if (TempData["Success"] is string ok)
        {
            <div class="alert alert-success" role="alert">@ok</div>
        }
        @if (TempData["Error"] is string err)
        {
            <div class="alert alert-error" role="alert">@err</div>
        }
        @RenderBody()
    </main>

    <footer class="auth-footer">
        <p>© 2026 TechZone — <a asp-controller="Home" asp-action="Index">Về cửa hàng</a> • Hotline: 1900 1234</p>
    </footer>

    @* theme.js dùng chung với shop (chỉ bind #theme-toggle + localStorage,
       không có hiệu ứng storefront). auth.js: show/hide password,
       cảnh báo Caps Lock, trạng thái submit — progressive enhancement,
       tắt JS thì form vẫn POST bình thường. *@
    <script src="~/js/theme.js" asp-append-version="true"></script>
    <script src="~/js/auth.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
