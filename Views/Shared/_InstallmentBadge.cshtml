@model decimal

<div class="installment-badge">
    <strong>Trả góp 0% (giả lập)</strong>
    <ul>
        <li><span data-installment="6">@(Math.Round(Model / 6).ToString("N0"))</span>đ/tháng trong 6 tháng</li>
        <li><span data-installment="12">@(Math.Round(Model / 12).ToString("N0"))</span>đ/tháng trong 12 tháng</li>
    </ul>
</div>
