<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script>
        /* Đặt theme TRƯỚC KHI trang vẽ để không nháy sáng: đọc localStorage
           'techzone-theme'; chưa có thì theo prefers-color-scheme (máy đang
           dark mode → lần đầu mở thấy bản tối). Không throw dù localStorage
           hay matchMedia bị chặn. */
        (function () {
            var t = 'light';
            try { t = localStorage.getItem('techzone-theme') || ''; } catch (e) { /* bỏ qua */ }
            if (t !== 'dark' && t !== 'light') {
                t = (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) ? 'dark' : 'light';
            }
            document.documentElement.setAttribute('data-theme', t);
        })();
        document.documentElement.classList.add('js');
    </script>
    <title>@ViewData["Title"] - TechZone</title>
    @* M7-2: favicon (truoc day /favicon.ico tra 404 moi trang). *@
    <link rel="icon" href="~/favicon.ico" type="image/x-icon" />
    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="stylesheet" href="~/css/features-a.css" />
    <link rel="stylesheet" href="~/css/features-b.css" />
    <link rel="stylesheet" href="~/css/features-d.css" />
    <link rel="stylesheet" href="~/css/features-c.css" />
    <link rel="stylesheet" href="~/css/features-3d.css" />
</head>
<body>
    <a class="skip-link" href="#main-content">Bỏ qua tới nội dung chính</a>
    <canvas id="webgl-bg" aria-hidden="true"></canvas>
    <div class="bg-dots" aria-hidden="true"></div>
    <header class="site-header">
        <div class="container header-inner">
            <button type="button" id="menu-toggle" class="menu-toggle" aria-expanded="false" aria-controls="mobile-menu" aria-label="Mở menu điều hướng"><span aria-hidden="true">☰</span></button>
            <a class="logo" asp-controller="Home" asp-action="Index">Tech<span>Zone</span></a>
            <form class="search" asp-controller="Products" asp-action="Index" method="get" role="search">
                <input type="search" name="TuKhoa" placeholder="Tìm sản phẩm…" aria-label="Tìm sản phẩm" />
                <button type="submit">Tìm</button>
            </form>
            <nav class="header-actions" aria-label="Tài khoản và giỏ hàng">
                <a asp-controller="Products" asp-action="Index">Sản phẩm</a>
                <a asp-controller="Compare" asp-action="Index">So sánh</a>
                @await Component.InvokeAsync("GioHangBadge")
                <a asp-controller="Wishlist" asp-action="Index">Yêu thích</a>
                <button type="button" id="theme-toggle" class="theme-toggle" aria-label="Chuyển sang giao diện tối" title="Chuyển sáng/tối"><span aria-hidden="true">🌙</span></button>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    @await Component.InvokeAsync("ThongBaoBell")
                    @await Component.InvokeAsync("DiemThanhVien")
                    <div class="user-menu">
                        <button type="button" id="user-menu-btn" class="user-menu-btn" aria-haspopup="true" aria-expanded="false" aria-controls="user-menu-panel"><span class="user-menu-label">Xin chào, @User.Identity.Name</span><span aria-hidden="true"> ▾</span></button>
                        <div id="user-menu-panel" class="user-menu-panel" hidden>
                            <a asp-controller="Orders" asp-action="MyOrders">Đơn của tôi</a>
                            <a asp-controller="Account" asp-action="Profile">Tài khoản</a>
                            @if (User.IsInRole("Admin"))
                            {
                                <a asp-controller="Admin" asp-action="Dashboard">Admin</a>
                            }
                            <form asp-controller="Account" asp-action="Logout" method="post" class="inline-form">
                                <button type="submit" class="link-button">Đăng xuất</button>
                            </form>
                        </div>
                    </div>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login">Đăng nhập</a>
                    <a asp-controller="Account" asp-action="Register" class="btn btn-primary btn-sm">Đăng ký</a>
                }
            </nav>
        </div>
        <div id="mobile-menu" class="mobile-menu" hidden>
            <div class="mobile-menu-group">Điều hướng</div>
            <a asp-controller="Products" asp-action="Index">Sản phẩm</a>
            <a asp-controller="Compare" asp-action="Index">So sánh</a>
            <a asp-controller="Cart" asp-action="Index">Giỏ hàng</a>
            <a asp-controller="Wishlist" asp-action="Index">Yêu thích</a>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <div class="mobile-menu-group">Tài khoản</div>
                <a asp-controller="Orders" asp-action="MyOrders">Đơn của tôi</a>
                <a asp-controller="Account" asp-action="Profile">Tài khoản</a>
                @if (User.IsInRole("Admin"))
                {
                    <a asp-controller="Admin" asp-action="Dashboard">Admin</a>
                }
                <form asp-controller="Account" asp-action="Logout" method="post" class="inline-form">
                    <button type="submit" class="link-button">Đăng xuất</button>
                </form>
            }
            else
            {
                <div class="mobile-menu-group">Tài khoản</div>
                <a asp-controller="Account" asp-action="Login">Đăng nhập</a>
                <a asp-controller="Account" asp-action="Register">Đăng ký</a>
            }
            <div class="mobile-menu-group">Danh mục</div>
            <a asp-controller="Products" asp-action="Index" asp-route-CategoryId="1">Điện thoại</a>
            <a asp-controller="Products" asp-action="Index" asp-route-CategoryId="2">Laptop</a>
            <a asp-controller="Products" asp-action="Index" asp-route-CategoryId="3">Tablet</a>
            <a asp-controller="Products" asp-action="Index" asp-route-CategoryId="4">Tai nghe</a>
            <a asp-controller="Products" asp-action="Index" asp-route-CategoryId="5">Đồng hồ</a>
            <a asp-controller="Products" asp-action="Index" asp-route-CategoryId="6">Phụ kiện</a>
            <a asp-controller="Products" asp-action="Index" asp-route-CategoryId="7">Gaming</a>
            <a asp-controller="Products" asp-action="Index" asp-route-CategoryId="8">Linh kiện PC</a>
        </div>
        <nav class="category-nav" aria-label="Danh mục">
            <div class="container">
                <a asp-controller="Products" asp-action="Index" asp-route-CategoryId="1">Điện thoại</a>
                <a asp-controller="Products" asp-action="Index" asp-route-CategoryId="2">Laptop</a>
                <a asp-controller="Products" asp-action="Index" asp-route-CategoryId="3">Tablet</a>
                <a asp-controller="Products" asp-action="Index" asp-route-CategoryId="4">Tai nghe</a>
                <a asp-controller="Products" asp-action="Index" asp-route-CategoryId="5">Đồng hồ</a>
                <a asp-controller="Products" asp-action="Index" asp-route-CategoryId="6">Phụ kiện</a>
                <a asp-controller="Products" asp-action="Index" asp-route-CategoryId="7">Gaming</a>
                <a asp-controller="Products" asp-action="Index" asp-route-CategoryId="8">Linh kiện PC</a>
            </div>
        </nav>
    </header>

    <main id="main-content" class="container main-content">
        @if (TempData["Success"] is string ok)
        {
            <div class="alert alert-success" role="alert">@ok</div>
        }
        @if (TempData["Error"] is string err)
        {
            <div class="alert alert-error" role="alert">@err</div>
        }
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container footer-inner">
            <div class="trust">
                <div><strong>Bảo hành 24 tháng</strong><span>Chính hãng, bảo hành tận nơi</span></div>
                <div><strong>Trả góp 0%</strong><span>Hỗ trợ trả góp 0% lãi suất</span></div>
                <div><strong>Giao nhanh 2h</strong><span>Miễn phí giao nội thành HN/HCM</span></div>
                <div><strong>Đổi trả 30 ngày</strong><span>Đổi trả dễ dàng, không phí</span></div>
            </div>
            <p>
                <a asp-controller="Returns" asp-action="TraCuu">Tra cứu bảo hành</a>
                @if (User.IsInRole("Admin"))
                {
                    <span aria-hidden="true"> • </span>
                    <a asp-controller="Returns" asp-action="AdminIndex">Duyệt đổi trả / bảo hành</a>
                }
            </p>
            <p>© 2026 TechZone — 123 Đường Công Nghệ, Quận 1, TP.HCM — Hotline: 1900 1234 — Email: hotro@techzone.vn</p>
        </div>
    </footer>

    <script src="~/js/theme.js"></script>
    <script src="~/js/header-menu.js"></script>
    <script src="~/js/webgl-bg.js"></script>
    <script src="~/js/features-b.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
