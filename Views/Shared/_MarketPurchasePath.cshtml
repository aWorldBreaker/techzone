@model bool

<a class="purchase-browse" asp-controller="Products" asp-action="Index">Ngành hàng</a>
<nav class="purchase-progress" aria-label="Tiến trình mua hàng">
    <ol>
        <li>
            @if (Model)
            {
                <a asp-controller="Cart" asp-action="Index">Giỏ hàng</a>
            }
            else
            {
                <span aria-current="step">Giỏ hàng</span>
            }
        </li>
        <li><span aria-current="@(Model ? "step" : null)">Thanh toán</span></li>
        <li><span>Xác nhận</span></li>
    </ol>
</nav>
