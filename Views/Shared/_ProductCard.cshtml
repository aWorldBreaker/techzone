@model TechZone.Models.Product
@{
    // Gia hien thi lay tu model (GiaBan), khong tu viet tay trong view.
    var giam = Model.GiaKhuyenMai.HasValue && Model.Gia > 0
        ? (int)Math.Round((1 - Model.GiaKhuyenMai.Value / Model.Gia) * 100)
        : 0;
}
<article class="product-card">
    <a asp-controller="Products" asp-action="Details" asp-route-id="@Model.Id" class="product-image">
        <img src="@Model.AnhDaiDien" alt="@Model.Ten" loading="lazy" />
        @if (giam > 0)
        {
            <span class="badge-giam">-@giam%</span>
        }
    </a>
    <div class="product-info">
        <h3><a asp-controller="Products" asp-action="Details" asp-route-id="@Model.Id">@Model.Ten</a></h3>
        @if (Model.SpecsNgan.Length > 0)
        {
            <p class="product-specs">@string.Join(" • ", Model.SpecsNgan)</p>
        }
        <p class="product-price">
            <strong>@Model.GiaBan.ToString("N0")đ</strong>
            @if (Model.GiaKhuyenMai.HasValue)
            {
                <s>@Model.Gia.ToString("N0")đ</s>
            }
        </p>
        @* M4-3: diem sao tinh tu review da duyet (Model.Reviews da loc
           IsApproved o controller), khong dung Model.DanhGiaTB (gia tri
           seed cu — cung ho M4-1 o Details: VD Id 1 seed 4.8 trong khi
           2 review 5+4 TB that 4.5; SP 0 review van hien "4.8 sao").
           0 review -> "Chua co danh gia", khong hien so sao. Chi hien
           thi, khong doi logic review/DanhGiaTB. LuotBan giu nguyen:
           bo dem tich luy do Checkout tang / Huy-Tra hoan, seed la
           tong lich su (khong phai so don trong DB) — xem TEST-REPORT §19. *@
        @{
            var soDanhGia = Model.Reviews.Count;
            var diemTB = soDanhGia > 0 ? Math.Round(Model.Reviews.Average(r => r.Sao), 1) : 0;
        }
        <p class="product-meta">@(soDanhGia > 0 ? $"{diemTB:0.0} sao ({soDanhGia} đánh giá)" : "Chưa có đánh giá") • Đã bán @Model.LuotBan
            @* Phase 5 — ton kho tren card. Nguong "Sap het" lay theo code co
               san: Admin "Sap het hang (ton kho ≤ 10)" (Dashboard:91,
               AdminController:67 TonKho <= 10). 0 = Het hang, 1–10 = Sap het,
               >10 = Con X. Nut Them vao gio khoa khi het hang — server von
               da tu choi soLuong > TonKho (CartController:57). *@
            • @if (Model.TonKho <= 0)
            {
                <span class="stock-out">Hết hàng</span>
            }
            else if (Model.TonKho <= 10)
            {
                <span class="stock-low">Sắp hết — còn @Model.TonKho</span>
            }
            else
            {
                <span class="stock-ok">Còn @Model.TonKho</span>
            }
        </p>
        <form asp-controller="Cart" asp-action="Add" method="post">
            <input type="hidden" name="productId" value="@Model.Id" />
            <input type="hidden" name="soLuong" value="1" />
            <button type="submit" class="btn btn-primary btn-block" @(Model.TonKho <= 0 ? "disabled" : "")>@(Model.TonKho <= 0 ? "Hết hàng" : "Thêm vào giỏ")</button>
        </form>
        <div class="card-actions">
            <form asp-controller="Compare" asp-action="Add" method="post" class="compare-form">
                <input type="hidden" name="productId" value="@Model.Id" />
                <button type="submit" class="btn btn-secondary btn-sm btn-block">＋ So sánh</button>
            </form>
            <form asp-controller="Wishlist" asp-action="Add" method="post" class="wishlist-form">
                <input type="hidden" name="productId" value="@Model.Id" />
                <button type="submit" class="btn btn-secondary btn-sm btn-block wishlist-btn" aria-label="Thêm @Model.Ten vào yêu thích">♡</button>
            </form>
        </div>
    </div>
</article>
