@model TechZone.Models.Product
@{
    var giaBan = ViewData["ProductCardPrices"] is Dictionary<int, decimal> prices
        ? prices.GetValueOrDefault(Model.Id, Model.GiaBan) : Model.GiaBan;
    var giam = giaBan < Model.Gia && Model.Gia > 0
        ? (int)Math.Round((1 - giaBan / Model.Gia) * 100)
        : 0;
    var need = ViewData["ProductCardNeed"] as ProductNeed;
    var specs = need?.SpecsFor(Model) ?? Model.SpecsNgan;
    var compareReturnUrl = ViewData["CompareReturnUrl"] as string;
}
<article class="product-card">
    <a asp-controller="Products" asp-action="Details" asp-route-id="@Model.Id" class="product-image">
        <img src="@Model.AnhDaiDien" alt="@Model.Ten" loading="lazy" />
        @if (giam > 0)
        {
            <span class="chip-giam">−@giam%</span>
        }
    </a>
    <div class="product-info">
        <h3><a asp-controller="Products" asp-action="Details" asp-route-id="@Model.Id">@Model.Ten</a></h3>
        <p class="product-price price-tag">
            <strong class="price-amount">@giaBan.ToString("N0")đ</strong>
            @if (giaBan < Model.Gia)
            {
                <s>@Model.Gia.ToString("N0")đ</s>
            }
        </p>
        <p class="product-stock">
            @if (ViewData["FlashRemaining"] is int remaining)
            {
                <strong class="stock-left">Còn @remaining suất Flash Sale</strong>
            }
            else
            {
                <partial name="_StockStatus" model="Model.TonKho" />
            }
        </p>
        @if (specs.Length > 0)
        {
            <ul class="product-specs">
                @foreach (var spec in specs.Take(2))
                {
                    <li>@spec</li>
                }
            </ul>
        }
        @{
            var reviews = Model.Reviews.Where(r => r.IsApproved).ToList();
            var soDanhGia = reviews.Count;
            var diemTB = soDanhGia > 0 ? Math.Round(reviews.Average(r => r.Sao), 1) : 0;
        }
        <p class="product-meta">@(soDanhGia > 0 ? $"{diemTB:0.0} sao ({soDanhGia} đánh giá)" : "Chưa có đánh giá")</p>
        <p class="product-meta">Đã bán @Model.LuotBan</p>
        <div class="card-actions">
            <form asp-controller="Cart" asp-action="Add" method="post">
                <input type="hidden" name="productId" value="@Model.Id" />
                <input type="hidden" name="soLuong" value="1" />
                <button type="submit" class="btn btn-primary btn-block" @(Model.TonKho <= 0 ? "disabled" : "")>@(Model.TonKho <= 0 ? "Hết hàng" : "Thêm vào giỏ")</button>
            </form>
            <form asp-controller="Compare" asp-action="Add" method="post" class="compare-form">
                <input type="hidden" name="productId" value="@Model.Id" />
                @if (compareReturnUrl is not null)
                {
                    <input type="hidden" name="returnUrl" value="@compareReturnUrl" />
                }
                <button type="submit" class="btn btn-secondary" aria-label="So sánh @Model.Ten" title="So sánh">
                    <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 3v18M8 21h8M5 7h14M5 7l-3 7h6L5 7Zm14 0-3 7h6l-3-7Z"/></svg>
                </button>
            </form>
            <form asp-controller="Wishlist" asp-action="Add" method="post" class="wishlist-form">
                <input type="hidden" name="productId" value="@Model.Id" />
                <button type="submit" class="btn btn-secondary wishlist-btn" aria-label="Thêm @Model.Ten vào yêu thích" title="Thêm vào yêu thích">
                    <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 20 4.2 12.1a4.5 4.5 0 0 1 6.4-6.4L12 7.1l1.4-1.4a4.5 4.5 0 0 1 6.4 6.4L12 20Z"/></svg>
                </button>
            </form>
        </div>
    </div>
</article>
